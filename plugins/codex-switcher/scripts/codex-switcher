tui_read_base_url_mode_menu() {
  local idx
  tui_choose_index_with_back "Base URL" "" "0" "Use default" "Use custom"
  idx="$TUI_MENU_RESULT"
  if [[ "$idx" == "-2" ]]; then
    tui_request_home
    echo ""
    return 2
  fi
  if [[ "$idx" == "-1" ]]; then
    echo ""
    return 1
  fi
  if [[ "$idx" == "1" ]]; then
    echo "custom"
  else
    echo "default"
  fi
}

tui_execute_apikey_account_command() {
  local action="$1"
  local account="$2"
  local env="$3"
  local api_key base_mode base_url

  api_key="$(tui_prompt_secret_line "Enter OpenAI API key: ")"
  api_key="$(echo "${api_key:-}" | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')"
  if [[ -z "$api_key" ]]; then
    echo "empty API key"
    tui_pause_if_interactive
    return 1
  fi

  base_mode="$(tui_read_base_url_mode_menu || true)"
  if [[ -z "$base_mode" ]]; then
    tui_home_requested && return 1
    return 1
  fi

  if [[ "$base_mode" == "custom" ]]; then
    base_url="$(tui_prompt_line "OpenAI Base URL" "")"
    base_url="$(normalize_base_url_input "$base_url" || true)"
    if [[ -z "$base_url" ]]; then
      echo "invalid OpenAI Base URL. expected http(s)://..."
      tui_pause_if_interactive
      return 1
    fi
    tui_execute_subcommand_quiet_with_input "$api_key"$'\n'"2"$'\n'"$base_url" ac "$action" "$account" --env "$env" -t both --mode apikey
  else
    tui_execute_subcommand_quiet_with_input "$api_key"$'\n'"1" ac "$action" "$account" --env "$env" -t both --mode apikey
  fi
}

tui_support_interactive() {
  [[ -t 0 && -t 2 ]]
}

tui_enter_alt_screen() {
  if [[ "$TUI_INTERACTIVE" == "true" && "$TUI_ALT_SCREEN_ACTIVE" != "true" ]]; then
    # Use private mode 1049 (alternate buffer + cursor save/restore).
    printf '\033[?1049h\033[H\033[2J' >&2 2>/dev/null || true
    TUI_ALT_SCREEN_ACTIVE="true"
  fi
}

tui_leave_alt_screen() {
  if [[ "$TUI_ALT_SCREEN_ACTIVE" == "true" ]]; then
    printf '\033[?1049l' >&2 2>/dev/null || true
    TUI_ALT_SCREEN_ACTIVE="false"
  fi
}

tui_setup_terminal() {
  TUI_SHOULD_QUIT="false"
  if tui_support_interactive; then
    TUI_INTERACTIVE="true"
    if [[ "${TERM:-}" != "dumb" ]]; then
      TUI_COLOR_ENABLED="true"
      TUI_COLOR_BORDER=$'\033[38;5;240m'
      TUI_COLOR_TITLE=$'\033[1;38;5;255m'
      TUI_COLOR_DIM=$'\033[38;5;245m'
      TUI_COLOR_HILITE=$'\033[1;38;5;50m'
      TUI_COLOR_GOOD=$'\033[1;38;5;78m'
      TUI_COLOR_WARN=$'\033[1;38;5;220m'
      TUI_COLOR_BAD=$'\033[1;38;5;203m'
      TUI_COLOR_BAR_EMPTY_BG=$'\033[48;5;236m'
      TUI_COLOR_BAR_GOOD_BG=$'\033[48;5;71m'
      TUI_COLOR_BAR_WARN_BG=$'\033[48;5;179m'
      TUI_COLOR_BAR_BAD_BG=$'\033[48;5;167m'
      TUI_COLOR_INFO=$'\033[1;38;5;123m'
      TUI_COLOR_PLAN=$'\033[1;38;5;214m'
      TUI_COLOR_RESET=$'\033[0m'
    else
      TUI_COLOR_ENABLED="false"
      TUI_COLOR_BORDER=""
      TUI_COLOR_TITLE=""
      TUI_COLOR_DIM=""
      TUI_COLOR_HILITE=""
      TUI_COLOR_GOOD=""
      TUI_COLOR_WARN=""
      TUI_COLOR_BAD=""
      TUI_COLOR_BAR_EMPTY_BG=""
      TUI_COLOR_BAR_GOOD_BG=""
      TUI_COLOR_BAR_WARN_BG=""
      TUI_COLOR_BAR_BAD_BG=""
      TUI_COLOR_INFO=""
      TUI_COLOR_PLAN=""
      TUI_COLOR_RESET=""
    fi
    TUI_STTY_SAVED="$(stty -g 2>/dev/null || true)"
    stty -echo -icanon min 1 time 0 2>/dev/null || true
    TUI_RAW_ACTIVE="true"
    tui_enter_alt_screen
    # Disable alternate-scroll mode so touchpad/mouse wheel cannot emulate
    # up/down cursor keys inside alternate screen.
    printf '\033[?1007l' >&2 2>/dev/null || true
    printf '\033[?25l' >&2 2>/dev/null || true
  else
    TUI_INTERACTIVE="false"
  fi
}

tui_restore_terminal() {
  if [[ "$TUI_RAW_ACTIVE" == "true" ]]; then
    if [[ -n "$TUI_STTY_SAVED" ]]; then
      stty "$TUI_STTY_SAVED" 2>/dev/null || true
    fi
    TUI_RAW_ACTIVE="false"
  fi
  if [[ "$TUI_INTERACTIVE" == "true" ]]; then
    printf '\033[?25h\033[0m' >&2 2>/dev/null || true
    tui_leave_alt_screen
  fi
}

tui_leave_raw_mode() {
  if [[ "$TUI_INTERACTIVE" == "true" && "$TUI_RAW_ACTIVE" == "true" ]]; then
    if [[ -n "$TUI_STTY_SAVED" ]]; then
      stty "$TUI_STTY_SAVED" 2>/dev/null || true
    fi
    TUI_RAW_ACTIVE="false"
    printf '\033[?25h' >&2 2>/dev/null || true
  fi
}

tui_enter_raw_mode() {
  if [[ "$TUI_INTERACTIVE" == "true" && "$TUI_RAW_ACTIVE" != "true" ]]; then
    stty -echo -icanon min 1 time 0 2>/dev/null || true
    TUI_RAW_ACTIVE="true"
    printf '\033[?25l' >&2 2>/dev/null || true
  fi
}

tui_clear_screen() {
  if [[ "$TUI_INTERACTIVE" == "true" ]]; then
    printf '\033[H\033[2J\033[3J' >&2
  fi
}

tui_read_key() {
  local key next next2

  # Prevent SIGTTIN suspension when this process is no longer foreground.
  if ! tui_has_foreground_tty; then
    echo "quit"
    return 0
  fi

  if [[ -n "$TUI_KEY_BUFFER" ]]; then
    key="$TUI_KEY_BUFFER"
    TUI_KEY_BUFFER=""
  else
    IFS= read -rsn1 key || return 1
  fi

  # In some terminals Enter is consumed as delimiter and read returns empty key.
  if [[ -z "$key" || "$key" == $'\n' || "$key" == $'\r' ]]; then
    # Some terminals emit CRLF for Enter. Discard trailing CR/LF bytes so
    # one Enter maps to exactly one action.
    while IFS= read -rsn1 -t 0 next; do
      case "$next" in
        ""|$'\n'|$'\r')
          ;;
        *)
          TUI_KEY_BUFFER="$next"
          break
          ;;
      esac
    done
    echo "enter"
    return 0
  fi

  case "$key" in
    $'\x1b')
      # macOS bash 3.2 does not support fractional timeout for `read -t`.
      if IFS= read -rsn1 -t 1 next; then
        case "$next" in
          '[')
            IFS= read -rsn1 -t 1 next2 || true
            case "$next2" in
              A) echo "up" ;;
              B) echo "down" ;;
              C) echo "right" ;;
              D) echo "left" ;;
              *) echo "esc" ;;
            esac
            ;;
          O)
            IFS= read -rsn1 -t 1 next2 || true
            case "$next2" in
              A) echo "up" ;;
              B) echo "down" ;;
              C) echo "right" ;;
              D) echo "left" ;;
              *) echo "esc" ;;
            esac
            ;;
          *)
            echo "esc"
            ;;
        esac
      else
        echo "esc"
      fi
      ;;
    $'\n'|$'\r')
      echo "enter"
      ;;
    q|Q)
      echo "quit"
      ;;
    [0-9])
      echo "digit:$key"
      ;;
    *)
      echo "char:$key"
      ;;
  esac
}

tui_request_quit() {
  TUI_SHOULD_QUIT="true"
}

tui_quit_requested() {
  [[ "$TUI_SHOULD_QUIT" == "true" ]]
}

tui_request_home() {
  TUI_GO_HOME="true"
}

tui_home_requested() {
  [[ "$TUI_GO_HOME" == "true" ]]
}

tui_clear_home_request() {
  TUI_GO_HOME="false"
}

tui_has_foreground_tty() {
  local my_pgid tty_pgid
  my_pgid="$(ps -o pgid= -p $$ 2>/dev/null | tr -d '[:space:]')"
  tty_pgid="$(ps -o tpgid= -p $$ 2>/dev/null | tr -d '[:space:]')"
  [[ -n "$my_pgid" && -n "$tty_pgid" && "$my_pgid" == "$tty_pgid" ]]
}

tui_choose_index_with_back() {
  local title="$1"
  local info="${2:-}"
  local default_index="${3:-0}"
  shift 3 || true
  local -a options=("$@")
  local back_index home_index

  options+=("$(tui_text "$(read_ui_lang)" back)")
  options+=("< Home")
  home_index=$(( ${#options[@]} - 1 ))
  back_index=$((home_index - 1))
  tui_choose_index "$title" "$info" "$default_index" "${options[@]}"
  if [[ "$TUI_MENU_RESULT" == "$back_index" ]]; then
    TUI_MENU_RESULT="-1"
  elif [[ "$TUI_MENU_RESULT" == "$home_index" ]]; then
    TUI_MENU_RESULT="-2"
    tui_request_home
  fi
}

tui_now_epoch() {
  date +%s
}

tui_panel_open() {
  local title="$1"
  if [[ "$TUI_INTERACTIVE" == "true" ]]; then
    printf '\n' >&2
  else
    echo
  fi
  if [[ "$TUI_COLOR_ENABLED" == "true" ]]; then
    if [[ "$TUI_INTERACTIVE" == "true" ]]; then
      printf '%b┌%b %b%s%b\n' "$TUI_COLOR_BORDER" "$TUI_COLOR_RESET" "$TUI_COLOR_TITLE" "$title" "$TUI_COLOR_RESET" >&2
    else
      printf '%b┌%b %b%s%b\n' "$TUI_COLOR_BORDER" "$TUI_COLOR_RESET" "$TUI_COLOR_TITLE" "$title" "$TUI_COLOR_RESET"
    fi
  else
    if [[ "$TUI_INTERACTIVE" == "true" ]]; then
      printf '┌ %s\n' "$title" >&2
    else
      echo "┌ $title"
    fi
  fi
}

tui_panel_line() {
  local content="${1:-}"
  if [[ "$TUI_COLOR_ENABLED" == "true" ]]; then
    if [[ "$TUI_INTERACTIVE" == "true" ]]; then
      printf '%b│%b %s\n' "$TUI_COLOR_BORDER" "$TUI_COLOR_RESET" "$content" >&2
    else
      printf '%b│%b %s\n' "$TUI_COLOR_BORDER" "$TUI_COLOR_RESET" "$content"
    fi
  else
    if [[ "$TUI_INTERACTIVE" == "true" ]]; then
      printf '│ %s\n' "$content" >&2
    else
      echo "│ $content"
    fi
  fi
}

tui_panel_close() {
  if [[ "$TUI_COLOR_ENABLED" == "true" ]]; then
    if [[ "$TUI_INTERACTIVE" == "true" ]]; then
      printf '%b└%b\n' "$TUI_COLOR_BORDER" "$TUI_COLOR_RESET" >&2
    else
      printf '%b└%b\n' "$TUI_COLOR_BORDER" "$TUI_COLOR_RESET"
    fi
  else
    if [[ "$TUI_INTERACTIVE" == "true" ]]; then
      printf '└\n' >&2
    else
      echo "└"
    fi
  fi
}

tui_prompt_line() {
  local prompt="$1"
  local default_value="${2:-}"
  local value

  tui_leave_raw_mode
  if [[ "$TUI_INTERACTIVE" == "true" ]]; then
    printf "%s" "$prompt" >&2
  else
    printf "%s" "$prompt"
  fi
  if ! IFS= read -r value; then
    value=""
  fi
  [[ -n "$value" ]] || value="$default_value"
  tui_enter_raw_mode
  echo "$value"
}

tui_prompt_secret_line() {
  local prompt="$1"
  local value

  tui_leave_raw_mode
  if [[ "$TUI_INTERACTIVE" == "true" ]]; then
    printf "%s" "$prompt" >&2
    IFS= read -r -s value || true
    printf "\n" >&2
  else
    printf "%s" "$prompt"
    IFS= read -r value || true
  fi
  tui_enter_raw_mode
  echo "$value"
}

tui_pause_if_interactive() {
  local lang
  [[ "$TUI_INTERACTIVE" == "true" ]] || return 0
  lang="$(read_ui_lang)"
  tui_leave_raw_mode
  printf "%s" "$(tui_text "$lang" press_enter)" >&2
  IFS= read -r _ || true
  tui_enter_raw_mode
}

tui_render_menu() {
  local title="$1"
  local info="${2:-}"
  local selected="${3:-0}"
  shift 3 || true
  local -a options=("$@")
  local i line marker
  local lang
  lang="$(read_ui_lang)"

  tui_clear_screen
  tui_panel_open "$title"
  if [[ -n "$info" ]]; then
    while IFS= read -r line; do
      tui_panel_line "$line"
    done <<< "$info"
    tui_panel_line ""
  fi
  for i in "${!options[@]}"; do
    if [[ "$i" -eq "$selected" ]]; then
      marker="> "
      if [[ "$TUI_COLOR_ENABLED" == "true" ]]; then
        tui_panel_line "${TUI_COLOR_HILITE}${marker}$((i + 1)). ${options[$i]}${TUI_COLOR_RESET}"
      else
        tui_panel_line "$marker$((i + 1)). ${options[$i]}"
      fi
    else
      marker="  "
      tui_panel_line "$marker$((i + 1)). ${options[$i]}"
    fi
  done
  tui_panel_line ""
  if [[ "$TUI_COLOR_ENABLED" == "true" ]]; then
    tui_panel_line "${TUI_COLOR_DIM}$(tui_text "$lang" nav_hint)${TUI_COLOR_RESET}"
  else
    tui_panel_line "$(tui_text "$lang" nav_hint)"
  fi
  tui_panel_close
}

tui_terminal_cols() {
  local cols rows
  cols=""

  if [[ -n "${COLUMNS:-}" && "${COLUMNS:-}" =~ ^[0-9]+$ ]]; then
    cols="$COLUMNS"
  fi

  if [[ -z "$cols" ]]; then
    read -r rows cols < <(stty size 2>/dev/null || true)
  fi

  if [[ -z "$cols" ]]; then
    cols="$(stty size < /dev/tty 2>/dev/null | awk '{print $2}' || true)"
  fi

  if [[ -z "$cols" ]]; then
    cols="$(tput cols 2>/dev/null || true)"
  fi

  if [[ -z "$cols" || ! "$cols" =~ ^[0-9]+$ || "$cols" -lt 40 ]]; then
    cols=100
  fi
  echo "$cols"
}

tui_terminal_rows() {
  local rows cols
  rows=""

  if [[ -n "${LINES:-}" && "${LINES:-}" =~ ^[0-9]+$ ]]; then
    rows="$LINES"
  fi

  if [[ -z "$rows" ]]; then
    read -r rows cols < <(stty size 2>/dev/null || true)
  fi

  if [[ -z "$rows" ]]; then
    rows="$(stty size < /dev/tty 2>/dev/null | awk '{print $1}' || true)"
  fi

  if [[ -z "$rows" ]]; then
    rows="$(tput lines 2>/dev/null || true)"
  fi

  if [[ -z "$rows" || ! "$rows" =~ ^[0-9]+$ || "$rows" -lt 18 ]]; then
    rows=32
  fi
  echo "$rows"
}

tui_usage_percent() {
  local usage="${1:-}"
  local pct
  pct="$(printf '%s\n' "$usage" | sed -nE 's/^([0-9]+)%.*/\1/p' | head -n 1)"
  [[ -n "$pct" ]] || pct=""
  echo "$pct"
}

tui_usage_time() {
  local usage="${1:-}"
  local ts
  ts="$(printf '%s\n' "$usage" | sed -nE 's/^[0-9]+% \(([^)]+)\).*$/\1/p' | head -n 1)"
  echo "${ts:--}"
}

tui_truncate_text() {
  local text="${1:-}"
  local max_len="${2:-46}"
  if [[ "${#text}" -le "$max_len" ]]; then
    echo "$text"
    return 0
  fi
  echo "${text:0:$((max_len-3))}..."
}

tui_fit_line_visual() {
  local text="${1:-}"
  local width="${2:-40}"
  local plain
  plain="$(tui_strip_ansi "$text")"
  if (( ${#plain} <= width )); then
    echo "$text"
    return 0
  fi
  echo "$(tui_truncate_text "$plain" "$width")"
}

tui_strip_ansi() {
  printf '%s' "${1:-}" | sed -E $'s/\x1B\\[[0-9;]*[A-Za-z]//g'
}

tui_visual_len() {
  local plain
  plain="$(tui_strip_ansi "${1:-}")"
  echo "${#plain}"
}

tui_repeat_char() {
  local ch="${1:-─}"
  local count="${2:-1}"
  local out=""
  local i
  (( count < 0 )) && count=0
  for ((i=0; i<count; i++)); do
    out="${out}${ch}"
  done
  printf '%s' "$out"
}

tui_pad_visual_right() {
  local text="${1:-}"
  local width="${2:-40}"
  local len pad
  len="$(tui_visual_len "$text")"
  if (( len >= width )); then
    printf '%s' "$text"
    return 0
  fi
  pad=$((width - len))
  printf '%s%*s' "$text" "$pad" ""
}

tui_usage_bar() {
  local usage="${1:-}"
  local pct filled width color_bg
  width="${2:-14}"
  pct="$(tui_usage_percent "$usage")"
  [[ -n "$pct" ]] || { echo ""; return 0; }
  filled=$((pct * width / 100))
  (( filled < 0 )) && filled=0
  (( filled > width )) && filled=width

  if [[ "$TUI_COLOR_ENABLED" == "true" ]]; then
    if (( pct >= 90 )); then
      color_bg="$TUI_COLOR_BAR_BAD_BG"
    elif (( pct >= 70 )); then
      color_bg="$TUI_COLOR_BAR_WARN_BG"
    else
      color_bg="$TUI_COLOR_BAR_GOOD_BG"
    fi
    printf '%b%*s%b%b%*s%b' \
      "$color_bg" "$filled" "" "$TUI_COLOR_RESET" \
      "$TUI_COLOR_BAR_EMPTY_BG" "$((width - filled))" "" "$TUI_COLOR_RESET"
  else
    local i bar=""
    for ((i=0; i<width; i++)); do
      if (( i < filled )); then
        bar="${bar}#"
      else
        bar="${bar}-"
      fi
    done
    printf '%s' "$bar"
  fi
}

tui_usage_pct_label() {
  local usage="${1:-}"
  local pct
  pct="$(tui_usage_percent "$usage")"
  [[ -n "$pct" ]] || { echo "--%"; return 0; }
  if [[ "$TUI_COLOR_ENABLED" == "true" ]]; then
    if (( pct >= 90 )); then
      printf '%b%s%%%b' "$TUI_COLOR_BAD" "$pct" "$TUI_COLOR_RESET"
    elif (( pct >= 70 )); then
      printf '%b%s%%%b' "$TUI_COLOR_WARN" "$pct" "$TUI_COLOR_RESET"
    else
      printf '%b%s%%%b' "$TUI_COLOR_GOOD" "$pct" "$TUI_COLOR_RESET"
    fi
  else
    echo "${pct}%"
  fi
}

tui_target_snapshot_tsv() {
  local target="$1"
  local usage_proxy="${2:-}"
  local env account home auth_file metrics state
  local email plan usage_5h usage_weekly last_activity source

  env="$(read_current_env "$target" || true)"
  account="$(read_current_account "$target" || true)"
  home="$(env_home_path "$env")"
  auth_file="$(account_auth_path "$env" "$account")"
  [[ -f "$auth_file" ]] || auth_file="$home/auth.json"

  state="$(login_state_for_target "$target" || true)"
  metrics="$(collect_profile_metrics_tsv "$account" "$auth_file" "$home" "$usage_proxy" || true)"
  if [[ -n "$metrics" ]]; then
    IFS=$'\t' read -r email plan usage_5h usage_weekly last_activity source <<< "$metrics"
  fi

  email="${email:-($account)-}"
  plan="${plan:-unknown}"
  usage_5h="${usage_5h:--}"
  usage_weekly="${usage_weekly:--}"
  last_activity="${last_activity:--}"
  source="${source:-local}"
  [[ "$source" == "api" || "$source" == "local" ]] || source="local"

  printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' \
    "$env" "$home" "$account" "${state:-unknown}" "$email" "$plan" "$usage_5h" "$usage_weekly" "$last_activity" "$source"
}

tui_snapshot_kv_line() {
  local key="$1"
  local value="$2"
  local width="${3:-56}"
  local label prefix max_value plain_value safe_value
  printf -v label '%-12s' "${key}"
  prefix="  ${label} "
  max_value=$((width - ${#prefix}))
  (( max_value < 6 )) && max_value=6

  plain_value="$(tui_strip_ansi "$value")"
  safe_value="$value"
  if (( ${#plain_value} > max_value )); then
    safe_value="$(tui_truncate_text "$plain_value" "$max_value")"
  fi

  if [[ "$TUI_COLOR_ENABLED" == "true" ]]; then
    printf '%b  %s%b %s\n' "$TUI_COLOR_DIM" "$label" "$TUI_COLOR_RESET" "$safe_value"
  else
    printf '  %s %s\n' "$label" "$safe_value"
  fi
}

tui_snapshot_state_label() {
  local state="${1:-unknown}"
  if [[ "$TUI_COLOR_ENABLED" != "true" ]]; then
    echo "$state"
    return 0
  fi
  case "$state" in
    logged-in)
      printf '%b%s%b' "$TUI_COLOR_GOOD" "$state" "$TUI_COLOR_RESET"
      ;;
    *)
      printf '%b%s%b' "$TUI_COLOR_BAD" "$state" "$TUI_COLOR_RESET"
      ;;
  esac
}

tui_snapshot_rule_line() {
  local width="${1:-56}"
  local line
  line="$(tui_repeat_char "─" "$width")"
  if [[ "$TUI_COLOR_ENABLED" == "true" ]]; then
    printf '%b%s%b\n' "$TUI_COLOR_BORDER" "$line" "$TUI_COLOR_RESET"
  else
    echo "$line"
  fi
}

tui_snapshot_block() {
  local label="$1"
  local env="$2"
  local home="$3"
  local account="$4"
  local state="$5"
  local email="$6"
  local plan="$7"
  local usage_5h="$8"
  local usage_weekly="$9"
  local last_activity="${10}"
  local source="${11}"
  local token_expiry="${12:--}"
  local mark="${13:-}"
  local width="${14:-56}"
  local pct_5h pct_week t5 tw bar5 barw account_field state_label
  local title_line

  (( width < 40 )) && width=40

  state_label="$(tui_snapshot_state_label "$state")"
  pct_5h="$(tui_usage_pct_label "$usage_5h")"
  pct_week="$(tui_usage_pct_label "$usage_weekly")"
  t5="$(tui_usage_time "$usage_5h")"
  tw="$(tui_usage_time "$usage_weekly")"
  bar5="$(tui_usage_bar "$usage_5h" 12)"
  barw="$(tui_usage_bar "$usage_weekly" 12)"

  account_field="$account"
  [[ -n "$mark" ]] && account_field="${account_field} ${mark}"

  if [[ "$TUI_COLOR_ENABLED" == "true" ]]; then
    title_line="${TUI_COLOR_HILITE}●${TUI_COLOR_RESET} ${TUI_COLOR_TITLE}[${label}] ${env}/${account}${TUI_COLOR_RESET} ${state_label}"
  else
    title_line="[${label}] ${env}/${account} (${state_label})"
  fi

  title_line="$(tui_truncate_text "$title_line" "$width")"
  echo "$title_line"
  tui_snapshot_rule_line "$width"
  tui_snapshot_kv_line "ENV" "$env" "$width"
  tui_snapshot_kv_line "HOME" "$home" "$width"
  tui_snapshot_kv_line "ACCOUNT" "$account_field" "$width"
  tui_snapshot_kv_line "EMAIL" "$email" "$width"
  tui_snapshot_kv_line "PLAN" "$plan" "$width"
  tui_snapshot_kv_line "5H USAGE" "${pct_5h}  ${bar5}  ${t5}" "$width"
  tui_snapshot_kv_line "WEEKLY USAGE" "${pct_week}  ${barw}  ${tw}" "$width"
  tui_snapshot_kv_line "AUTH EXPIRY" "$token_expiry" "$width"
  tui_snapshot_kv_line "LAST ACTIVITY" "$last_activity" "$width"
  tui_snapshot_kv_line "SOURCE" "$source" "$width"
}

tui_print_two_col_blocks() {
  local left_block="$1"
  local right_block="$2"
  local width="${3:-56}"
  local sep i max
  local -a left_lines=()
  local -a right_lines=()
  local left_line right_line

  while IFS= read -r left_line; do
    left_lines+=("$left_line")
  done <<< "$left_block"

  while IFS= read -r right_line; do
    right_lines+=("$right_line")
  done <<< "$right_block"

  max="${#left_lines[@]}"
  if (( ${#right_lines[@]} > max )); then
    max="${#right_lines[@]}"
  fi

  if [[ "$TUI_COLOR_ENABLED" == "true" ]]; then
    sep=" ${TUI_COLOR_BORDER}│${TUI_COLOR_RESET} "
  else
    sep=" │ "
  fi

  for ((i=0; i<max; i++)); do
    left_line="${left_lines[$i]:-}"
    right_line="${right_lines[$i]:-}"
    printf '%s%s%s\n' "$(tui_pad_visual_right "$left_line" "$width")" "$sep" "$right_line"
  done
}

tui_snapshot_stack_separator() {
  local cols width
  cols="$(tui_terminal_cols)"
  width=$((cols - 4))
  (( width > 76 )) && width=76
  (( width < 40 )) && width=40
  tui_snapshot_rule_line "$width"
}

tui_snapshot_block_compact() {
  local env="$1"
  local account="$2"
  local state="$3"
  local email="$4"
  local plan="$5"
  local usage_5h="$6"
  local usage_weekly="$7"
  local last_activity="$8"
  local source="$9"
  local token_expiry="${10:--}"
  local mark="${11:-}"
  local width="${12:-42}"
  local inner title state_label pct_5h pct_week t5 tw bar5 barw line2 line3 line4 line5 line6 line
  local mark_display plan_display
  local top bottom

  (( width < 34 )) && width=34
  inner=$((width - 2))
  (( inner < 20 )) && inner=20
  state_label="$(tui_snapshot_state_label "$state")"
  pct_5h="$(tui_usage_pct_label "$usage_5h")"
  pct_week="$(tui_usage_pct_label "$usage_weekly")"
  t5="$(tui_usage_time "$usage_5h")"
  tw="$(tui_usage_time "$usage_weekly")"
  bar5="$(tui_usage_bar "$usage_5h" 8)"
  barw="$(tui_usage_bar "$usage_weekly" 8)"

  if [[ "$source" == "apikey" ]]; then
    mark_display="$mark"
    if [[ "$TUI_COLOR_ENABLED" == "true" ]]; then
      mark_display="${mark_display//\[cli\]/${TUI_COLOR_INFO}[cli]${TUI_COLOR_RESET}}"
      mark_display="${mark_display//\[app\]/${TUI_COLOR_INFO}[app]${TUI_COLOR_RESET}}"
      title="${TUI_COLOR_HILITE}●${TUI_COLOR_RESET} ${TUI_COLOR_TITLE}${account}${TUI_COLOR_RESET}${mark_display} ${state_label}"
    else
      title="${account}${mark_display} ${state}"
    fi
    line2="alias:${account}"
    line3="api key:${email}"
    line4="base url:$(display_base_url_for_account "$env" "$account")"
    line5=""
    line6=""
  else
  mark_display="$mark"
  plan_display="$plan"
  if [[ "$TUI_COLOR_ENABLED" == "true" ]]; then
    mark_display="${mark_display//\[cli\]/${TUI_COLOR_INFO}[cli]${TUI_COLOR_RESET}}"
    mark_display="${mark_display//\[app\]/${TUI_COLOR_INFO}[app]${TUI_COLOR_RESET}}"
    plan_display="${TUI_COLOR_PLAN}${plan}${TUI_COLOR_RESET}"
    title="${TUI_COLOR_HILITE}●${TUI_COLOR_RESET} ${TUI_COLOR_TITLE}${account}${TUI_COLOR_RESET}${mark_display} ${state_label}"
  else
    title="${account}${mark_display} ${state}"
  fi
  line2="${email}"
  line3="plan:${plan_display}  src:${source}"
  line4="5H  ${pct_5h} ${bar5} ${t5}"
  line5="WK  ${pct_week} ${barw} ${tw}"
  line6="AUTH EXP ${token_expiry}"
  fi

  top="┌$(tui_repeat_char "─" "$inner")┐"
  bottom="└$(tui_repeat_char "─" "$inner")┘"
  if [[ "$TUI_COLOR_ENABLED" == "true" ]]; then
    top="${TUI_COLOR_BORDER}${top}${TUI_COLOR_RESET}"
    bottom="${TUI_COLOR_BORDER}${bottom}${TUI_COLOR_RESET}"
  fi

  echo "$top"
  for line in "$title" "$line2" "$line3" "$line4" "$line5" "$line6"; do
    line="$(tui_fit_line_visual "$line" "$inner")"
    line="$(tui_pad_visual_right "$line" "$inner")"
    if [[ "$TUI_COLOR_ENABLED" == "true" ]]; then
      printf '%b│%b%s%b│%b\n' "$TUI_COLOR_BORDER" "$TUI_COLOR_RESET" "$line" "$TUI_COLOR_BORDER" "$TUI_COLOR_RESET"
    else
      printf '│%s│\n' "$line"
    fi
  done
  echo "$bottom"
}

tui_print_blocks_grid_files() {
  local width="$1"
  local line_count="${2:-7}"
  shift 2
  local -a files=("$@")
  local total cols ncols gap start end line i text

  total="${#files[@]}"
  (( total > 0 )) || return 0

  cols="$(tui_terminal_cols)"
  gap=1
  ncols=$(( (cols + gap) / (width + gap) ))
  (( ncols < 1 )) && ncols=1
  (( ncols > total )) && ncols="$total"

  for ((start=0; start<total; start+=ncols)); do
    end=$((start + ncols - 1))
    (( end >= total )) && end=$((total - 1))
    for ((line=1; line<=line_count; line++)); do
      for ((i=start; i<=end; i++)); do
        text="$(sed -n "${line}p" "${files[$i]}" 2>/dev/null || true)"
        if (( i > start )); then
          # Remove only the left border glyph for merged cards.
          # Keep trailing ANSI sequences so title/bullet colors stay intact.
          text="$(printf '%s' "$text" | sed -E $'s/^((\\x1B\\[[0-9;]*m)*)[│┌└]/\\1/')"
        fi
        text="$(tui_pad_visual_right "$text" "$width")"
        if (( i == start )); then
          printf '%s' "$text"
        else
          printf ' %s' "$text"
        fi
      done
      printf '\n'
    done
    if (( end < total - 1 )); then
      echo
    fi
  done
}

tui_status_env_heading() {
  local env="$1"
  local home
  local line
  home="$(display_path_for_output "$(env_home_path "$env")")"
  line="ENV: $env   HOME: $home"
  if [[ "$TUI_COLOR_ENABLED" == "true" ]]; then
    if (( ${#line} <= $(tui_terminal_cols) - 2 )); then
      printf '%bENV: %s%b   %bHOME: %s%b\n' \
        "$TUI_COLOR_TITLE" "$env" "$TUI_COLOR_RESET" \
        "$TUI_COLOR_DIM" "$home" "$TUI_COLOR_RESET"
    else
      printf '%b%s%b\n' "$TUI_COLOR_TITLE" "ENV: $env" "$TUI_COLOR_RESET"
      printf '%b%s%b\n' "$TUI_COLOR_DIM" "HOME: $home" "$TUI_COLOR_RESET"
    fi
  else
    if (( ${#line} <= $(tui_terminal_cols) - 2 )); then
      echo "$line"
    else
      echo "ENV: $env"
      echo "HOME: $home"
    fi
  fi
}

status_auth_layout() {
  if [[ "$TUI_COLOR_ENABLED" == "true" ]]; then
    printf '%bDEFAULT AUTH:%b %s\n' "$TUI_COLOR_DIM" "$TUI_COLOR_RESET" "$(display_path_for_output "$DEFAULT_HOME/auth.json")"
    printf '%bCUSTOM  AUTH:%b %s\n' "$TUI_COLOR_DIM" "$TUI_COLOR_RESET" "$(display_path_for_output "$ACCOUNTS_DIR/{env}/{account}/auth.json")"
  else
    echo "DEFAULT AUTH: $(display_path_for_output "$DEFAULT_HOME/auth.json")"
    echo "CUSTOM  AUTH: $(display_path_for_output "$ACCOUNTS_DIR/{env}/{account}/auth.json")"
  fi
}

source_auth_file_for_account() {
  local env="$1"
  local account="$2"
  local slot_auth home_auth
  slot_auth="$(account_auth_path "$env" "$account")"
  home_auth="$(env_home_path "$env")/auth.json"
  if [[ -f "$slot_auth" ]]; then
    echo "$slot_auth"
    return 0
  fi
  if [[ "$account" == "$DEFAULT_ACCOUNT_NAME" && -f "$home_auth" ]]; then
    echo "$home_auth"
    return 0
  fi
  return 1
}

auth_mode_for_file() {
  local auth_file="$1"
  python3 - "$auth_file" <<'PY'
import json, sys
path = sys.argv[1]
try:
    with open(path, "r", encoding="utf-8") as f:
        data = json.load(f)
    mode = str(data.get("auth_mode") or "").strip().lower()
    print(mode)
except Exception:
    print("")
PY
}

api_key_mask_for_file() {
  local auth_file="$1"
  python3 - "$auth_file" <<'PY'
import json, sys
path = sys.argv[1]
try:
    with open(path, "r", encoding="utf-8") as f:
        data = json.load(f)
    key = str(data.get("OPENAI_API_KEY") or "").strip()
    if not key:
        print("-")
    elif len(key) <= 7:
        print("***")
    else:
        print(f"{key[:3]}***{key[-4:]}")
except Exception:
    print("-")
PY
}

account_auth_status_line() {
  local env="$1"
  local account="$2"
  local preferred
  preferred="$(preferred_auth_method_for_account "$env" "$account")"
  if [[ "$preferred" == "apikey" ]]; then
    echo "apikey | base_url: $(display_base_url_for_account "$env" "$account")"
  else
    echo "chatgpt"
  fi
}

auth_file_is_api_key() {
  local auth_file="$1"
  local mode
  mode="$(auth_mode_for_file "$auth_file")"
  [[ "$mode" == "api_key" || "$mode" == "apikey" ]]
}

preferred_auth_method_for_account() {
  local env="$1"
  local account="$2"
  local preferred auth_file
  preferred="$(runtime_field_for_account "$env" "$account" "preferred_auth_method")"
  if [[ -n "$preferred" ]]; then
    echo "$preferred"
    return 0
  fi
  auth_file="$(source_auth_file_for_account "$env" "$account" || true)"
  if [[ -n "$auth_file" ]] && auth_file_is_api_key "$auth_file"; then
    echo "apikey"
  else
    echo "chatgpt"
  fi
}

openai_base_url_mode_for_account() {
  local env="$1"
  local account="$2"
  local mode
  mode="$(runtime_field_for_account "$env" "$account" "openai_base_url_mode")"
  if [[ "$mode" == "custom" ]]; then
    echo "custom"
  else
    echo "default"
  fi
}

openai_base_url_for_account() {
  local env="$1"
  local account="$2"
  runtime_field_for_account "$env" "$account" "openai_base_url"
}

display_base_url_for_account() {
  local env="$1"
  local account="$2"
  local mode base_url
  mode="$(openai_base_url_mode_for_account "$env" "$account")"
  if [[ "$mode" != "custom" ]]; then
    echo "default"
    return 0
  fi
  base_url="$(openai_base_url_for_account "$env" "$account")"
  if [[ -n "$base_url" ]]; then
    echo "$base_url"
  else
    echo "default"
  fi
}

account_uses_chatgpt_auth_mode() {
  local env="$1"
  local account="$2"
  local auth_file mode
  auth_file="$(source_auth_file_for_account "$env" "$account" || true)"
  [[ -n "$auth_file" ]] || return 1
  mode="$(auth_mode_for_file "$auth_file")"
  [[ "$mode" == "chatgpt" || "$mode" == "auth" || "$mode" == "" ]]
}

account_uses_api_key_mode() {
  local env="$1"
  local account="$2"
  local auth_file
  auth_file="$(source_auth_file_for_account "$env" "$account" || true)"
  [[ -n "$auth_file" ]] || return 1
  auth_file_is_api_key "$auth_file"
}

token_expiry_from_auth_file() {
  local auth_file="$1"
  python3 - "$auth_file" <<'PY'
import base64, json, sys
from datetime import datetime, timezone
path = sys.argv[1]
try:
    with open(path, "r", encoding="utf-8") as f:
        data = json.load(f)
    token = (((data.get("tokens") or {}).get("access_token")) or "").strip()
    if not token or "." not in token:
        print("-")
        raise SystemExit(0)
    parts = token.split(".")
    if len(parts) < 2:
        print("-")
        raise SystemExit(0)
    payload = parts[1]
    padding = "=" * (-len(payload) % 4)
    claims = json.loads(base64.urlsafe_b64decode((payload + padding).encode("utf-8")).decode("utf-8"))
    exp = claims.get("exp")
    if not isinstance(exp, (int, float)) or exp <= 0:
        print("-")
        raise SystemExit(0)
    dt = datetime.fromtimestamp(int(exp), tz=timezone.utc)
    print(dt.strftime("%Y-%m-%d %H:%M:%SZ"))
except Exception:
    print("-")
PY
}

token_expiry_for_env_account() {
  local env="$1"
  local account="$2"
  local auth_file
  auth_file="$(source_auth_file_for_account "$env" "$account" || true)"
  if [[ -z "$auth_file" ]]; then
    echo "-"
    return 0
  fi
  token_expiry_from_auth_file "$auth_file"
}

launchd_available() {
  [[ "$(uname -s 2>/dev/null || true)" == "Darwin" ]] && command -v launchctl >/dev/null 2>&1
}

launchd_token_refresh_loaded() {
  launchd_available || return 1
  launchctl list "$LAUNCHD_REFRESH_LABEL" >/dev/null 2>&1
}

token_refresh_guard_status_line() {
  if ! launchd_available; then
    echo "unsupported (requires macOS launchd)"
    return 0
  fi
  if [[ ! -f "$LAUNCHD_REFRESH_PLIST" ]]; then
    echo "disabled"
    return 0
  fi
  if launchd_token_refresh_loaded; then
    echo "enabled(running), interval=${TOKEN_REFRESH_INTERVAL_SECONDS}s"
  else
    echo "enabled(not-running), interval=${TOKEN_REFRESH_INTERVAL_SECONDS}s"
  fi
}

token_refresh_last_need_relogin() {
  if [[ ! -f "$TOKEN_REFRESH_LOG" ]]; then
    echo "-"
    return 0
  fi
  local last
  last="$(rg -o "need_relogin=[0-9]+" "$TOKEN_REFRESH_LOG" 2>/dev/null | tail -n 1 | cut -d= -f2 || true)"
  if [[ -n "$last" ]]; then
    echo "$last"
  else
    echo "0"
  fi
}

format_log_time_local() {
  date '+%Y-%m-%d %H:%M:%S %Z'
}

token_email_from_auth_file() {
  local auth_file="$1"
  python3 - "$auth_file" <<'PY'
import base64
import json
import sys

path = sys.argv[1]
try:
    with open(path, "r", encoding="utf-8") as f:
        data = json.load(f)
    tokens = data.get("tokens")
    if not isinstance(tokens, dict):
        print("-")
        raise SystemExit(0)
    token = tokens.get("id_token")
    if not isinstance(token, str) or "." not in token:
        print("-")
        raise SystemExit(0)
    parts = token.split(".")
    if len(parts) < 2:
        print("-")
        raise SystemExit(0)
    payload = parts[1]
    padding = "=" * (-len(payload) % 4)
    claims = json.loads(base64.urlsafe_b64decode((payload + padding).encode("utf-8")).decode("utf-8"))
    email = claims.get("email")
    print(email if isinstance(email, str) and email.strip() else "-")
except Exception:
    print("-")
PY
}

format_token_refresh_row() {
  local account="$1"
  local email="$2"
  local expiry="$3"
  local ttl="$4"
  local status="$5"
  printf '  %-22s %-34s %-20s %-12s %s\n' "$account" "$email" "$expiry" "$ttl" "$status"
}

write_token_refresh_launchd_plist() {
  local plist="$1"
  local script_path uid
  script_path="$SCRIPT_DIR/codex-switcher"
  uid="$(id -u)"
  mkdir -p "$HOME/Library/LaunchAgents"
  cat > "$plist" <<PLIST
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>$LAUNCHD_REFRESH_LABEL</string>
  <key>ProgramArguments</key>
  <array>
    <string>$script_path</string>
    <string>ops</string>
    <string>token-refresh</string>
    <string>run-once</string>
  </array>
  <key>StartInterval</key>
  <integer>$TOKEN_REFRESH_INTERVAL_SECONDS</integer>
  <key>RunAtLoad</key>
  <true/>
  <key>StandardOutPath</key>
  <string>$TOKEN_REFRESH_LOG</string>
  <key>StandardErrorPath</key>
  <string>$TOKEN_REFRESH_LOG</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>CODEX_SWITCHER_STATE_DIR</key>
    <string>$STATE_DIR</string>
    <key>CODEX_SWITCHER_ENVS_DIR</key>
    <string>$ENVS_DIR</string>
    <key>CODEX_SWITCHER_ACCOUNTS_DIR</key>
    <string>$ACCOUNTS_DIR</string>
    <key>CODEX_SWITCHER_DEFAULT_HOME</key>
    <string>$DEFAULT_HOME</string>
    <key>CODEX_SWITCHER_SKIP_UPDATE_CHECK</key>
    <string>true</string>
    <key>CODEX_SWITCHER_TOKEN_REFRESH_INTERVAL_SECONDS</key>
    <string>$TOKEN_REFRESH_INTERVAL_SECONDS</string>
    <key>PATH</key>
    <string>$PATH</string>
    <key>HOME</key>
    <string>$HOME</string>
    <key>USER</key>
    <string>${USER:-}</string>
    <key>UID</key>
    <string>$uid</string>
  </dict>
</dict>
</plist>
PLIST
}

tui_account_snapshot_tsv() {
  local env="$1"
  local account="$2"
  local usage_proxy="${3:-}"
  local home auth_file metrics state
  local email plan usage_5h usage_weekly last_activity source token_expiry

  home="$(env_home_path "$env")"
  auth_file="$(account_auth_path "$env" "$account")"
  [[ -f "$auth_file" ]] || auth_file="$home/auth.json"

  if account_has_auth "$env" "$account"; then
    state="logged-in"
  else
    state="not-logged-in"
  fi

  if [[ -f "$auth_file" ]] && auth_file_is_api_key "$auth_file"; then
    email="$(api_key_mask_for_file "$auth_file")"
    plan="-"
    usage_5h="-"
    usage_weekly="-"
    last_activity="-"
    source="apikey"
    token_expiry="-"
    printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' \
      "$env" "$home" "$account" "$state" "$email" "$plan" "$usage_5h" "$usage_weekly" "$last_activity" "$source" "$token_expiry"
    return 0
  fi

  metrics="$(collect_profile_metrics_tsv "$account" "$auth_file" "$home" "$usage_proxy" || true)"
  if [[ -n "$metrics" ]]; then
    IFS=$'\t' read -r email plan usage_5h usage_weekly last_activity source <<< "$metrics"
  fi

  email="${email:-($account)-}"
  plan="${plan:-unknown}"
  usage_5h="${usage_5h:--}"
  usage_weekly="${usage_weekly:--}"
  last_activity="${last_activity:--}"
  source="${source:-local}"
  [[ "$source" == "api" || "$source" == "local" ]] || source="local"
  token_expiry="$(token_expiry_for_env_account "$env" "$account")"

  printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' \
    "$env" "$home" "$account" "$state" "$email" "$plan" "$usage_5h" "$usage_weekly" "$last_activity" "$source" "$token_expiry"
}

tui_home_accounts_snapshot() {
  if core_cli_available; then
    if tui_home_accounts_snapshot_from_core; then
      return 0
    fi
  fi

  local usage_info usage_proxy cols colw
  local cli_env cli_account app_env app_account
  local env account mark any
  local s_env s_home s_account s_state s_email s_plan s_5h s_week s_last s_source s_exp
  local max_parallel
  local tmp_dir
  local -a all_envs=()
  local -a all_accounts=()
  local -a worker_pids=()
  local -a block_files=()
  local -a env_block_files=()
  local idx

  usage_info="$(resolve_usage_proxy_with_source || true)"
  usage_proxy=""
  if [[ -n "$usage_info" ]]; then
    IFS=$'\t' read -r _ usage_proxy <<< "$usage_info"
  fi

  cli_env="$(read_current_env cli || true)"
  cli_account="$(read_current_account cli || true)"
  app_env="$(read_current_env app || true)"
  app_account="$(read_current_account app || true)"

  status_auth_layout
  echo

  cols="$(tui_terminal_cols)"
  # Keep status cards readable; prefer earlier wrapping over dense packing.
  colw=52
  (( cols < 140 )) && colw=48
  (( cols < 110 )) && colw=44

  max_parallel="${CODEX_SWITCHER_STATUS_PARALLELISM:-6}"
  [[ "$max_parallel" =~ ^[0-9]+$ ]] || max_parallel=6
  (( max_parallel < 1 )) && max_parallel=1

  tmp_dir="$(mktemp -d /tmp/codex-sw-status-snapshot.XXXXXX)"

  any=0
  while IFS= read -r env; do
    while IFS= read -r account; do
      all_envs+=("$env")
      all_accounts+=("$account")
      idx=$(( ${#all_envs[@]} - 1 ))
      (
        tui_account_snapshot_tsv "$env" "$account" "$usage_proxy" > "$tmp_dir/metric.$idx.tsv"
      ) &
      worker_pids+=("$!")
      if (( ${#worker_pids[@]} >= max_parallel )); then
        wait "${worker_pids[0]}" 2>/dev/null || true
        worker_pids=("${worker_pids[@]:1}")
      fi
    done < <(list_accounts_for_env "$env")
  done < <(list_env_names | sort -u)

  if (( ${#worker_pids[@]} > 0 )); then
    for idx in "${worker_pids[@]}"; do
      wait "$idx" 2>/dev/null || true
    done
  fi

  for idx in "${!all_envs[@]}"; do
    any=1
    IFS=$'\t' read -r s_env s_home s_account s_state s_email s_plan s_5h s_week s_last s_source s_exp < "$tmp_dir/metric.$idx.tsv" || true
    s_env="${s_env:-${all_envs[$idx]}}"
    s_account="${s_account:-${all_accounts[$idx]}}"
    s_state="${s_state:-not-logged-in}"
    s_email="${s_email:--}"
    s_plan="${s_plan:-unknown}"
    s_5h="${s_5h:---}"
    s_week="${s_week:---}"
    s_last="${s_last:---}"
    s_source="${s_source:-local}"
    s_exp="${s_exp:---}"
    s_home="$(display_path_for_output "$s_home")"
    mark=""
    env="${all_envs[$idx]}"
    account="${all_accounts[$idx]}"

    [[ "$env" == "$cli_env" && "$account" == "$cli_account" ]] && mark="${mark} [cli]"
    [[ "$env" == "$app_env" && "$account" == "$app_account" ]] && mark="${mark} [app]"
    tui_snapshot_block_compact "$s_env" "$s_account" "$s_state" "$s_email" "$s_plan" "$s_5h" "$s_week" "$s_last" "$s_source" "$s_exp" "$mark" "$colw" > "$tmp_dir/block.$idx.txt"
    block_files+=("$tmp_dir/block.$idx.txt")
  done

  if [[ "$any" -eq 0 ]]; then
    echo "  No accounts found."
    rm -rf "$tmp_dir"
    return 0
  fi

  while IFS= read -r env; do
    env_block_files=()
    for idx in "${!all_envs[@]}"; do
      if [[ "${all_envs[$idx]}" == "$env" ]]; then
        env_block_files+=("${block_files[$idx]}")
      fi
    done
    (( ${#env_block_files[@]} > 0 )) || continue
    tui_status_env_heading "$env"
    tui_print_blocks_grid_files "$colw" "8" "${env_block_files[@]}"
    echo
  done < <(list_env_names | sort -u)

  rm -rf "$tmp_dir"
}

tui_home_accounts_snapshot_from_core() {
  local core_cli overview_json
  core_cli="$(core_cli_path)"
  overview_json="$(npx --yes tsx "$core_cli" overview 2>/dev/null || true)"
  [[ -n "$overview_json" ]] || return 1

  python3 - <<'PY' "$overview_json"
import json
import sys

overview = json.loads(sys.argv[1])
status = overview.get("status") or {}
accounts = overview.get("accounts") or []

def tag(account):
    marks = []
    if account.get("isCurrentCli"):
        marks.append("[cli]")
    if account.get("isCurrentApp"):
        marks.append("[app]")
    return " ".join(marks)

def print_target(title, payload):
    current = payload.get("current", "-")
    auth = payload.get("auth", "-")
    expiry = payload.get("authExpiry", "-")
    state = payload.get("loginState", "unknown")
    print(f"{title} [{state}]")
    print("────────────────────────────────────────────────────────")
    print(f"TARGET        {current}")
    print(f"AUTH          {auth}")
    print(f"AUTH EXPIRY   {expiry}")
    print()

print_target("CLI", status.get("cli") or {})
print_target("APP", status.get("app") or {})

grouped = {}
for account in accounts:
    grouped.setdefault(account.get("envName", "default"), []).append(account)

for env_name in sorted(grouped):
    print(f"ENV: {env_name}")
    print("────────────────────────────────────────────────────────")
    for account in sorted(grouped[env_name], key=lambda item: item.get("name", "")):
        auth_mode = account.get("authMode", "-")
        preferred = (account.get("runtime") or {}).get("preferredAuthMethod", "-")
        base_url = (account.get("runtime") or {}).get("openaiBaseUrl") or "default"
        api_key_preview = account.get("apiKeyPreview") or "-"
        print(f"{account.get('name', '-')} {tag(account)}")
        print(f"  auth: {auth_mode} / {preferred}")
        if auth_mode == "apikey":
            print(f"  api key:{api_key_preview}")
            print(f"  base url:{base_url}")
        print()
PY
}

tui_choose_index() {
  local title="$1"
  local info="${2:-}"
  local default_index="${3:-0}"
  shift 3 || true
  local -a options=("$@")
  local max idx choice key d
  local lang
  lang="$(read_ui_lang)"

  TUI_MENU_RESULT="-1"
  max="${#options[@]}"
  (( max > 0 )) || return 0
  idx="$default_index"
  (( idx >= 0 && idx < max )) || idx=0

  if [[ "$TUI_INTERACTIVE" != "true" ]]; then
    while true; do
      tui_panel_open "$title"
      if [[ -n "$info" ]]; then
        while IFS= read -r choice; do
          tui_panel_line "$choice"
        done <<< "$info"
        tui_panel_line ""
      fi
      for d in "${!options[@]}"; do
        printf '%2d) %s\n' "$((d + 1))" "${options[$d]}"
      done
      printf "%s" "$(tui_text "$lang" choose)"
      if ! IFS= read -r choice; then
        TUI_MENU_RESULT="-1"
        return 0
      fi
      choice="$(echo "${choice:-}" | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')"
      if [[ -z "$choice" ]]; then
        TUI_MENU_RESULT="$idx"
        return 0
      fi
      case "$choice" in
        q|Q)
          tui_request_quit
          TUI_MENU_RESULT="-1"
          return 0
          ;;
      esac
      if [[ "$choice" =~ ^[0-9]+$ ]]; then
        d=$((choice - 1))
        if (( d >= 0 && d < max )); then
          TUI_MENU_RESULT="$d"
          return 0
        fi
      fi
      echo "$(tui_text "$lang" invalid_choice)$choice"
    done
  fi

  while true; do
    tui_render_menu "$title" "$info" "$idx" "${options[@]}"
    key="$(tui_read_key || true)"
    [[ -n "$key" ]] || continue
    case "$key" in
      up)
        idx=$(( (idx - 1 + max) % max ))
        ;;
      down)
        idx=$(( (idx + 1) % max ))
        ;;
      enter)
        TUI_MENU_RESULT="$idx"
        return 0
        ;;
      quit)
        tui_request_quit
        TUI_MENU_RESULT="-1"
        return 0
        ;;
      digit:*)
        d="${key#digit:}"
        if [[ "$d" =~ ^[0-9]+$ ]]; then
          d=$((d - 1))
          if (( d >= 0 && d < max )); then
            TUI_MENU_RESULT="$d"
            return 0
          fi
        fi
        ;;
    esac
  done
}

tui_execute_subcommand() {
  local -a args=("$@")
  local rc
  local lang
  lang="$(read_ui_lang)"

  if [[ "${#args[@]}" -eq 0 ]]; then
    return 0
  fi

  debug_event "tui_subcommand_start args=${args[*]} interactive=$TUI_INTERACTIVE raw=$TUI_RAW_ACTIVE alt=$TUI_ALT_SCREEN_ACTIVE"
  tui_restore_terminal
  if [[ "$TUI_INTERACTIVE" == "true" ]]; then
    printf '\033[H\033[2J\033[3J' >&2
  fi
  set +e
  CODEX_SWITCHER_SKIP_UPDATE_CHECK=true "$SCRIPT_DIR/codex-switcher" "${args[@]}"
  rc=$?
  set -e
  debug_event "tui_subcommand_exit rc=$rc args=${args[*]}"

  echo
  echo "$(tui_text "$lang" exit_code_prefix)$rc]"
  if [[ "$rc" -eq 0 ]]; then
    tui_home_accounts_snapshot_cache_clear
  fi
  # Avoid SIGTTIN suspends on some shells/TTY setups after app launch.
  # Opt-in old blocking behavior via CODEX_SWITCHER_TUI_WAIT_ENTER=true.
  if [[ "$TUI_INTERACTIVE" == "true" ]]; then
    if [[ "${CODEX_SWITCHER_TUI_WAIT_ENTER:-false}" == "true" ]] && tui_has_foreground_tty; then
      printf "%s" "$(tui_text "$lang" press_enter)" >&2
      IFS= read -r _ || true
    fi
    tui_setup_terminal
  fi
}

tui_execute_subcommand_quiet_impl() {
  local input_file="$1"
  shift
  local -a args=("$@")
  local rc output_file
  local lang
  lang="$(read_ui_lang)"

  if [[ "${#args[@]}" -eq 0 ]]; then
    return 0
  fi

  output_file="$(mktemp /tmp/codex-sw-tui-subcommand.XXXXXX)"
  debug_event "tui_subcommand_quiet_start args=${args[*]} interactive=$TUI_INTERACTIVE raw=$TUI_RAW_ACTIVE alt=$TUI_ALT_SCREEN_ACTIVE"
  tui_restore_terminal
  set +e
  if [[ -n "$input_file" ]]; then
    CODEX_SWITCHER_SKIP_UPDATE_CHECK=true "$SCRIPT_DIR/codex-switcher" "${args[@]}" <"$input_file" >"$output_file" 2>&1
  else
    CODEX_SWITCHER_SKIP_UPDATE_CHECK=true "$SCRIPT_DIR/codex-switcher" "${args[@]}" >"$output_file" 2>&1
  fi
  rc=$?
  set -e
  debug_event "tui_subcommand_quiet_exit rc=$rc args=${args[*]}"

  if [[ "$TUI_INTERACTIVE" == "true" ]]; then
    tui_setup_terminal
  fi

  if [[ "$rc" -ne 0 ]]; then
    cat "$output_file"
    echo
    echo "$(tui_text "$lang" exit_code_prefix)$rc]"
    rm -f -- "$output_file"
    return "$rc"
  fi

  tui_home_accounts_snapshot_cache_clear
  rm -f -- "$output_file"
  return 0
}

tui_execute_subcommand_quiet() {
  tui_execute_subcommand_quiet_impl "" "$@"
}

tui_execute_subcommand_quiet_with_input() {
  local input_payload="$1"
  shift
  local input_file rc

  input_file="$(mktemp /tmp/codex-sw-tui-subcommand-input.XXXXXX)"
  chmod 600 "$input_file" 2>/dev/null || true
  printf '%s\n' "$input_payload" >"$input_file"
  tui_execute_subcommand_quiet_impl "$input_file" "$@"
  rc=$?
  rm -f -- "$input_file"
  return "$rc"
}

tui_execute_launch_subcommand() {
  local -a args=("$@")
  local rc
  local lang
  lang="$(read_ui_lang)"

  if [[ "${#args[@]}" -eq 0 ]]; then
    return 0
  fi

  debug_event "tui_launch_subcommand_start args=${args[*]} interactive=$TUI_INTERACTIVE raw=$TUI_RAW_ACTIVE alt=$TUI_ALT_SCREEN_ACTIVE"
  tui_restore_terminal
  if [[ "$TUI_INTERACTIVE" == "true" ]]; then
    printf '\033[H\033[2J\033[3J' >&2
  fi
  set +e
  CODEX_SWITCHER_SKIP_UPDATE_CHECK=true "$SCRIPT_DIR/codex-switcher" "${args[@]}"
  rc=$?
  set -e
  debug_event "tui_launch_subcommand_exit rc=$rc args=${args[*]}"

  echo
  echo "$(tui_text "$lang" exit_code_prefix)$rc]"
  tui_request_quit
  return "$rc"
}

tui_execute_subcommand_detached() {
  local -a args=("$@")
  local cmdline
  if [[ "${#args[@]}" -eq 0 ]]; then
    return 0
  fi

  # Fully detach from current TTY so TUI can stay interactive.
  nohup env CODEX_SWITCHER_SKIP_UPDATE_CHECK=true "$SCRIPT_DIR/codex-switcher" "${args[@]}" </dev/null >>"$SWITCH_LOG" 2>&1 &
  cmdline="$(printf '%q ' "$SCRIPT_NAME" "${args[@]}")"
  echo "已在后台执行: ${cmdline% }"
}

tui_select_env() {
  local default_env="${1:-$(read_current_env cli || true)}"
  local include_default="${2:-true}"
  local info
  local idx env
  local -a envs=()

  while IFS= read -r env; do
    [[ "$include_default" != "true" && "$env" == "$DEFAULT_ENV_NAME" ]] && continue
    envs+=("$env")
  done < <(list_env_names | sort -u)

  if [[ "${#envs[@]}" -eq 0 ]]; then
    return 1
  fi

  idx=0
  for env in "${!envs[@]}"; do
    if [[ "${envs[$env]}" == "$default_env" ]]; then
      idx="$env"
      break
    fi
  done
  info="$(tui_text "$(read_ui_lang)" select_env_title)"
  tui_choose_index_with_back "$info" "" "$idx" "${envs[@]}"
  [[ "$TUI_MENU_RESULT" == "-2" ]] && return 2
  [[ "$TUI_MENU_RESULT" == "-1" ]] && return 1
  echo "${envs[$TUI_MENU_RESULT]}"
}

tui_account_slots_for_env() {
  local env="$1"
  local dir="$ACCOUNTS_DIR/$env"
  if [[ -d "$dir" ]]; then
    find "$dir" -mindepth 1 -maxdepth 1 -type d -exec basename {} \; | while IFS= read -r account; do
      validate_name_noexit "$account" || continue
      echo "$account"
    done
  fi
  if account_has_auth "$env" "$DEFAULT_ACCOUNT_NAME"; then
    echo "$DEFAULT_ACCOUNT_NAME"
  fi
}

tui_select_account() {
  local env="$1"
  local default_account="${2:-$(read_current_account cli || true)}"
  local require_auth="${3:-true}"
  local idx account status
  local -a accounts=()
  local -a labels=()

  while IFS= read -r account; do
    if [[ "$require_auth" == "true" ]] && ! account_has_auth "$env" "$account"; then
      continue
    fi
    accounts+=("$account")
  done < <(tui_account_slots_for_env "$env" | sort -u)

  if [[ "${#accounts[@]}" -eq 0 ]]; then
    if [[ "$require_auth" == "true" ]]; then
      echo "$(tui_text "$(read_ui_lang)" no_logged_account)" >&2
    else
      echo "$(tui_text "$(read_ui_lang)" no_account_slot)" >&2
    fi
    tui_pause_if_interactive
    return 1
  fi

  idx=0
  for account in "${!accounts[@]}"; do
    [[ "${accounts[$account]}" == "$default_account" ]] && idx="$account" && break
  done

  for account in "${accounts[@]}"; do
    local preferred base_url_mode
    preferred="$(preferred_auth_method_for_account "$env" "$account")"
    if [[ "$preferred" == "apikey" ]]; then
      base_url_mode="$(openai_base_url_mode_for_account "$env" "$account")"
      if [[ "$base_url_mode" == "custom" ]]; then
        labels+=("$account [apikey, custom-base-url]")
      else
        labels+=("$account [apikey]")
      fi
    else
      if account_has_auth "$env" "$account"; then
        status="$(tui_text "$(read_ui_lang)" status_logged_in)"
      else
        status="$(tui_text "$(read_ui_lang)" status_not_logged_in)"
      fi
      labels+=("$account [$status]")
    fi
  done

  tui_choose_index_with_back "$(tui_text "$(read_ui_lang)" select_account_title) (env=$env)" "" "$idx" "${labels[@]}"
  [[ "$TUI_MENU_RESULT" == "-2" ]] && return 2
  [[ "$TUI_MENU_RESULT" == "-1" ]] && return 1
  echo "${accounts[$TUI_MENU_RESULT]}"
}

tui_choose_target() {
  local allow_both="${1:-false}"
  local -a options=()
  local -a values=()
  local idx

  options+=("$(tui_text "$(read_ui_lang)" target_cli)")
  values+=("cli")
  options+=("$(tui_text "$(read_ui_lang)" target_app)")
  values+=("app")
  if [[ "$allow_both" == "true" ]]; then
    options+=("$(tui_text "$(read_ui_lang)" target_both)")
    values+=("both")
  fi
  tui_choose_index_with_back "$(tui_text "$(read_ui_lang)" select_target_title)" "" "0" "${options[@]}"
  [[ "$TUI_MENU_RESULT" == "-2" ]] && return 2
  [[ "$TUI_MENU_RESULT" == "-1" ]] && return 1
  echo "${values[$TUI_MENU_RESULT]}"
}

tui_action_switch() {
  local target="" env="" account="" action_idx
  local title=""
  local stage=0
  local rc

  while true; do
    tui_quit_requested && return 1
    tui_home_requested && return 1
    case "$stage" in
      0)
        target="$(tui_choose_target false)"
        rc=$?
        if [[ "$rc" -ne 0 ]]; then
          tui_quit_requested && return 1
          [[ "$rc" -eq 2 ]] && tui_request_home && return 1
          return 1
        fi
        stage=1
        ;;
      1)
        env="$(tui_select_env "$(read_current_env "$target" || true)")"
        rc=$?
        if [[ "$rc" -ne 0 ]]; then
          tui_quit_requested && return 1
          [[ "$rc" -eq 2 ]] && tui_request_home && return 1
          stage=0
          continue
        fi
        stage=2
        ;;
      2)
        account="$(tui_select_account "$env" "$(read_current_account "$target" || true)" true)"
        rc=$?
        if [[ "$rc" -ne 0 ]]; then
          tui_quit_requested && return 1
          [[ "$rc" -eq 2 ]] && tui_request_home && return 1
          stage=1
          continue
        fi
        stage=3
        ;;
      3)
        if [[ "$target" == "cli" ]]; then
          title="$(tui_text "$(read_ui_lang)" select_action_title)"
          tui_choose_index_with_back "$title" "" "0" \
            "$(tui_text "$(read_ui_lang)" launch_cli)" \
            "$(tui_text "$(read_ui_lang)" launch_none)"
        else
          title="$(tui_text "$(read_ui_lang)" select_action_title)"
          tui_choose_index_with_back "$title" "" "0" \
            "$(tui_text "$(read_ui_lang)" action_restart_current)" \
            "$(tui_text "$(read_ui_lang)" action_launch_new)" \
            "$(tui_text "$(read_ui_lang)" action_switch_only)"
        fi
        action_idx="$TUI_MENU_RESULT"
        if [[ "$action_idx" == "-2" ]]; then
          tui_request_home
          return 1
        fi
        if [[ "$action_idx" == "-1" ]]; then
          tui_quit_requested && return 1
          tui_home_requested && return 1
          stage=2
          continue
        fi
        debug_event "tui_switch_selected target=$target env=$env account=$account action_idx=$action_idx"
        tui_execute_subcommand ac use "$account" --env "$env" -t "$target"
        if [[ "$target" == "cli" ]]; then
          case "$action_idx" in
            0)
              tui_execute_subcommand cli launch-current
              ;;
            *)
              ;;
          esac
        else
          case "$action_idx" in
            0)
              tui_execute_subcommand app restart-current
              ;;
            1)
              tui_execute_subcommand app launch-new
              ;;
            *)
              ;;
          esac
        fi
        return 0
        ;;
    esac
  done
}

tui_action_login() {
  local prefer_env="${1:-$(read_current_env cli || true)}"
  local env account mode mode_idx
  local rc
  tui_panel_open "$(tui_text "$(read_ui_lang)" login_title)"

  env="$(tui_select_env "$prefer_env")"
  rc=$?
  if [[ "$rc" -ne 0 ]]; then
    [[ "$rc" -eq 2 ]] && tui_request_home
    return 1
  fi

  account="$(tui_prompt_line "$(tui_text "$(read_ui_lang)" login_account_prompt)" "")"
  account="$(normalize_name_input "$account")"
  account="$(echo "${account:-}" | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')"
  if ! validate_name_noexit "$account"; then
    echo "$(tui_text "$(read_ui_lang)" invalid_choice)$account"
    tui_pause_if_interactive
    return 1
  fi

  tui_choose_index_with_back "$(tui_text "$(read_ui_lang)" login_mode_title)" "" "0" \
    "$(tui_text "$(read_ui_lang)" login_mode_auth)" \
    "$(tui_text "$(read_ui_lang)" login_mode_apikey)" \
    "$(tui_text "$(read_ui_lang)" login_mode_sub2api)"
  mode_idx="$TUI_MENU_RESULT"
  [[ "$mode_idx" == "-2" ]] && tui_request_home && return 1
  [[ "$mode_idx" == "-1" ]] && return 1
  case "$mode_idx" in
    1) mode="apikey" ;;
    2) mode="sub2api" ;;
    *) mode="auth" ;;
  esac

  if [[ "$mode" == "apikey" ]]; then
    tui_execute_apikey_account_command login "$account" "$env" || return 1
    tui_request_home
  elif [[ "$mode" == "sub2api" ]]; then
    tui_execute_subcommand_quiet ac login "$account" --env "$env" -t both --mode sub2api
    tui_request_home
  else
    tui_execute_subcommand_quiet ac login "$account" --env "$env" -t both
    tui_request_home
  fi
}

tui_action_relogin() {
  local prefer_env="${1:-$(read_current_env cli || true)}"
  local env account mode mode_idx
  local rc
  tui_panel_open "$(tui_text "$(read_ui_lang)" accounts_relogin)"

  env="$(tui_select_env "$prefer_env")"
  rc=$?
  if [[ "$rc" -ne 0 ]]; then
    [[ "$rc" -eq 2 ]] && tui_request_home
    return 1
  fi
  account="$(tui_select_account "$env" "$(read_current_account cli || true)" false)"
  rc=$?
  if [[ "$rc" -ne 0 ]]; then
    [[ "$rc" -eq 2 ]] && tui_request_home
    return 1
  fi

  tui_choose_index_with_back "$(tui_text "$(read_ui_lang)" login_mode_title)" "" "0" \
    "$(tui_text "$(read_ui_lang)" login_mode_auth)" \
    "$(tui_text "$(read_ui_lang)" login_mode_apikey)" \
    "$(tui_text "$(read_ui_lang)" login_mode_sub2api)"
  mode_idx="$TUI_MENU_RESULT"
  [[ "$mode_idx" == "-2" ]] && tui_request_home && return 1
  [[ "$mode_idx" == "-1" ]] && return 1
  case "$mode_idx" in
    1) mode="apikey" ;;
    2) mode="sub2api" ;;
    *) mode="auth" ;;
  esac

  if [[ "$mode" == "apikey" ]]; then
    tui_execute_apikey_account_command relogin "$account" "$env" || return 1
  else
    tui_execute_subcommand_quiet ac relogin "$account" --env "$env" -t both --mode "$mode"
  fi
  tui_request_home
}

tui_action_env_create() {
  local name src_idx src env_from rc
  tui_panel_open "$(tui_text "$(read_ui_lang)" envs_create)"
  name="$(tui_prompt_line "$(tui_text "$(read_ui_lang)" env_name_prompt)" "")"
  name="$(normalize_name_input "$name")"
  name="$(echo "${name:-}" | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')"
  if ! validate_env_name_noexit "$name" || [[ "$name" == "$DEFAULT_ENV_NAME" ]]; then
    echo "$(tui_text "$(read_ui_lang)" invalid_choice)$name"
    tui_pause_if_interactive
    return 1
  fi

  tui_choose_index_with_back "$(tui_text "$(read_ui_lang)" env_source_title)" "" "0" \
    "$(tui_text "$(read_ui_lang)" env_source_default)" \
    "$(tui_text "$(read_ui_lang)" env_source_empty)" \
    "$(tui_text "$(read_ui_lang)" env_source_other)"
  src_idx="$TUI_MENU_RESULT"
  [[ "$src_idx" == "-2" ]] && tui_request_home && return 1
  [[ "$src_idx" == "-1" ]] && return 1
  case "$src_idx" in
    0)
      tui_execute_subcommand env new "$name"
      ;;
    1)
      tui_execute_subcommand env new "$name" --empty
      ;;
    *)
      env_from="$(tui_select_env "$(read_current_env cli || true)")"
      rc=$?
      if [[ "$rc" -ne 0 ]]; then
        [[ "$rc" -eq 2 ]] && tui_request_home
        return 1
      fi
      tui_execute_subcommand env new "$name" --from "$env_from"
      ;;
  esac
}

tui_action_env_delete() {
  local env rc
  env="$(tui_select_env "$(read_current_env cli || true)" false)"
  rc=$?
  if [[ "$rc" -ne 0 ]]; then
    [[ "$rc" -eq 2 ]] && tui_request_home && return 1
    echo "$(tui_text "$(read_ui_lang)" invalid_choice)$DEFAULT_ENV_NAME"
    tui_pause_if_interactive
    return 1
  fi
  tui_execute_subcommand env rm "$env" --force
  tui_home_accounts_snapshot_cache_clear
}

tui_action_proxy() {
  local info choice input usage_info source value
  local default_manual=""
  while true; do
    usage_info="$(resolve_usage_proxy_with_source || true)"
    source=""
    value=""
    if [[ -n "$usage_info" ]]; then
      IFS=$'\t' read -r source value <<< "$usage_info"
    fi

    case "$source" in
      manual)
        info="Current: manual ($value)"
        default_manual="$value"
        ;;
      auto-env)
        info="Current: auto-detected from env ($value)"
        ;;
      auto-system)
        info="Current: auto-detected from system ($value)"
        ;;
      *)
        info="Current: auto-detect (no proxy detected)"
        ;;
    esac

    tui_choose_index_with_back "$(tui_text "$(read_ui_lang)" proxy_title)" "$info" "0" \
      "$(tui_text "$(read_ui_lang)" proxy_auto)" \
      "$(tui_text "$(read_ui_lang)" proxy_manual)"
    choice="$TUI_MENU_RESULT"
    [[ "$choice" == "-2" ]] && tui_request_home && return 0
    [[ "$choice" == "-1" ]] && return 0
    case "$choice" in
      0)
        tui_execute_subcommand ops proxy off
        ;;
      1)
        input="$(tui_prompt_line "$(tui_text "$(read_ui_lang)" proxy_prompt)" "$default_manual")"
        input="$(echo "${input:-}" | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')"
        [[ -n "$input" ]] || continue
        tui_execute_subcommand ops proxy "$input"
        ;;
    esac
  done
}

tui_action_lang() {
  local idx langs current i
  local -a opts=()
  local -a vals=(zh en ja)
  current="$(read_ui_lang)"
  for i in "${!vals[@]}"; do
    if [[ "${vals[$i]}" == "$current" ]]; then
      opts+=("${vals[$i]} ($(tui_text "$current" default_prefix))")
      idx="$i"
    else
      opts+=("${vals[$i]}")
    fi
  done
  idx="${idx:-0}"
  tui_choose_index_with_back "$(tui_text "$current" lang_title)" "$(tui_text "$current" lang_current_prefix): $current" "$idx" "${opts[@]}"
  langs="$TUI_MENU_RESULT"
  [[ "$langs" == "-2" ]] && tui_request_home && return 0
  [[ "$langs" == "-1" ]] && return 0
  tui_execute_subcommand lang "${vals[$langs]}"
}

tui_action_accounts() {
  local action env account stage rc
  while true; do
    tui_quit_requested && return 0
    tui_home_requested && return 0
    tui_choose_index_with_back "$(tui_text "$(read_ui_lang)" accounts_title)" "" "0" \
      "$(tui_text "$(read_ui_lang)" accounts_login)" \
      "$(tui_text "$(read_ui_lang)" accounts_relogin)" \
      "$(tui_text "$(read_ui_lang)" accounts_logout)" \
      "$(tui_text "$(read_ui_lang)" accounts_delete)"
    action="$TUI_MENU_RESULT"
    [[ "$action" == "-2" ]] && tui_request_home && return 0
    [[ "$action" == "-1" ]] && return 0
    case "$action" in
      0)
        tui_action_login "$(read_current_env cli || true)" || true
        tui_home_requested && return 0
        ;;
      1)
        tui_action_relogin "$(read_current_env cli || true)" || true
        tui_home_requested && return 0
        ;;
      2)
        stage=0
        while true; do
          tui_quit_requested && return 0
          case "$stage" in
            0)
              env="$(tui_select_env "$(read_current_env cli || true)")"
              rc=$?
              if [[ "$rc" -ne 0 ]]; then
                tui_quit_requested && return 0
                [[ "$rc" -eq 2 ]] && tui_request_home && return 0
                break
              fi
              stage=1
              ;;
            1)
              account="$(tui_select_account "$env" "$(read_current_account cli || true)" false)"
              rc=$?
              if [[ "$rc" -ne 0 ]]; then
                tui_quit_requested && return 0
                [[ "$rc" -eq 2 ]] && tui_request_home && return 0
                stage=0
                continue
              fi
              tui_execute_subcommand ac logout "$account" --env "$env" -t both
              break
              ;;
          esac
        done
        ;;
      3)
        stage=0
        while true; do
          tui_quit_requested && return 0
          case "$stage" in
            0)
              env="$(tui_select_env "$(read_current_env cli || true)")"
              rc=$?
              if [[ "$rc" -ne 0 ]]; then
                tui_quit_requested && return 0
                [[ "$rc" -eq 2 ]] && tui_request_home && return 0
                break
              fi
              stage=1
              ;;
            1)
              account="$(tui_select_account "$env" "$(read_current_account cli || true)" false)"
              rc=$?
              if [[ "$rc" -ne 0 ]]; then
                tui_quit_requested && return 0
                [[ "$rc" -eq 2 ]] && tui_request_home && return 0
                stage=0
                continue
              fi
              tui_execute_subcommand ac rm "$account" --env "$env"
              break
              ;;
          esac
        done
        ;;
      *)
        return 0
        ;;
    esac
  done
}

tui_action_envs() {
  local action
  while true; do
    tui_quit_requested && return 0
    tui_home_requested && return 0
    tui_choose_index_with_back "$(tui_text "$(read_ui_lang)" envs_title)" "" "0" \
      "$(tui_text "$(read_ui_lang)" envs_create)" \
      "$(tui_text "$(read_ui_lang)" envs_delete)"
    action="$TUI_MENU_RESULT"
    [[ "$action" == "-2" ]] && tui_request_home && return 0
    [[ "$action" == "-1" ]] && return 0
    case "$action" in
      0)
        tui_action_env_create || true
        tui_home_requested && return 0
        ;;
      1)
        tui_action_env_delete || true
        tui_home_requested && return 0
        ;;
      *)
        return 0
        ;;
    esac
  done
}

tui_fetch_home_snapshot_with_loading() {
  local snapshot tmp pid rc i frame
  local -a frames=("◐" "◓" "◑" "◒")

  if [[ "$TUI_INTERACTIVE" != "true" ]]; then
    tui_home_accounts_snapshot
    return 0
  fi

  tmp="$(mktemp /tmp/codex-sw-home-snapshot.XXXXXX)"
  (
    tui_home_accounts_snapshot >"$tmp"
  ) &
  pid=$!
  i=0
  while kill -0 "$pid" 2>/dev/null; do
    frame="${frames[$((i % ${#frames[@]}))]}"
    tui_render_status_loading "$frame"
    sleep 0.12
    i=$((i + 1))
  done

  set +e
  wait "$pid"
  rc=$?
  set -e

  if [[ "$rc" -eq 0 ]]; then
    snapshot="$(cat "$tmp" 2>/dev/null || true)"
    rm -f "$tmp"
    printf '%s' "$snapshot"
    return 0
  fi

  rm -f "$tmp"
  return 1
}

tui_home_accounts_snapshot_cache_clear() {
  TUI_HOME_SNAPSHOT_CACHE=""
  TUI_HOME_SNAPSHOT_CACHE_TS="0"
  TUI_HOME_SNAPSHOT_RENDER=""
}

tui_home_accounts_snapshot_cached() {
  local now age snapshot
  now="$(tui_now_epoch)"

  if [[ -n "$TUI_HOME_SNAPSHOT_CACHE" && "$TUI_HOME_SNAPSHOT_CACHE_TS" =~ ^[0-9]+$ ]]; then
    age=$((now - TUI_HOME_SNAPSHOT_CACHE_TS))
    if (( age >= 0 && age < TUI_HOME_SNAPSHOT_CACHE_TTL )); then
      TUI_HOME_SNAPSHOT_RENDER="$TUI_HOME_SNAPSHOT_CACHE"
      return 0
    fi
  fi

  snapshot="$(tui_fetch_home_snapshot_with_loading || true)"
  if [[ -n "$snapshot" ]]; then
    TUI_HOME_SNAPSHOT_CACHE="$snapshot"
    TUI_HOME_SNAPSHOT_CACHE_TS="$now"
    TUI_HOME_SNAPSHOT_RENDER="$snapshot"
    return 0
  fi

  TUI_HOME_SNAPSHOT_RENDER="$TUI_HOME_SNAPSHOT_CACHE"
}

tui_render_status_loading() {
  local spinner="${1:-◐}"
  local lang info
  lang="$(read_ui_lang)"
  info="$(tui_text "$lang" home_accounts_title)
${spinner} $(tui_text "$lang" home_loading)"

  tui_render_menu "codex-sw ─ $(tui_text "$lang" home_opt_status)" "$info" "0" \
    "$(tui_text "$lang" back)"
}

tui_status_snapshot_line_count() {
  local snapshot="${1:-}"
  if [[ -z "$snapshot" ]]; then
    echo 0
    return 0
  fi
  printf '%s\n' "$snapshot" | awk 'END{print NR+0}'
}

tui_render_status_scrolled() {
  local snapshot="${1:-}"
  local offset="${2:-0}"
  local rows view_lines total_lines max_offset start end
  local lang
  lang="$(read_ui_lang)"

  rows="$(tui_terminal_rows)"
  view_lines=$((rows - 10))
  (( view_lines < 6 )) && view_lines=6

  total_lines="$(tui_status_snapshot_line_count "$snapshot")"
  max_offset=$((total_lines - view_lines))
  (( max_offset < 0 )) && max_offset=0
  (( offset < 0 )) && offset=0
  (( offset > max_offset )) && offset="$max_offset"

  start=$((offset + 1))
  end=$((offset + view_lines))

  if [[ "$TUI_INTERACTIVE" == "true" ]]; then
    # Lighter redraw than full-screen clear to reduce visible flicker.
    printf '\033[H\033[J' >&2
  fi
  if [[ "$TUI_INTERACTIVE" == "true" ]]; then
    printf 'codex-sw ─ %s\n' "$(tui_text "$lang" home_opt_status)" >&2
    printf '\n' >&2
    if [[ -n "$snapshot" ]]; then
      printf '%s\n' "$snapshot" | sed -n "${start},${end}p" >&2
    else
      printf 'No data\n' >&2
    fi
    printf '\n' >&2
    if [[ "$TUI_COLOR_ENABLED" == "true" ]]; then
      printf '%b%s%b\n' "$TUI_COLOR_DIM" "↑/↓ scroll  r refresh  Esc/q back" "$TUI_COLOR_RESET" >&2
    else
      printf '%s\n' "↑/↓ scroll  r refresh  Esc/q back" >&2
    fi
  else
    printf 'codex-sw ─ %s\n' "$(tui_text "$lang" home_opt_status)"
    printf '\n'
    if [[ -n "$snapshot" ]]; then
      printf '%s\n' "$snapshot" | sed -n "${start},${end}p"
    else
      printf 'No data\n'
    fi
    printf '\n'
    printf '%s\n' "↑/↓ scroll  r refresh  Esc/q back"
  fi
}

tui_action_status() {
  local snapshot key offset total_lines rows view_lines max_offset
  while true; do
    tui_quit_requested && return 0
    tui_render_status_loading
    tui_home_accounts_snapshot_cached
    snapshot="$TUI_HOME_SNAPSHOT_RENDER"
    offset=0
    while true; do
      rows="$(tui_terminal_rows)"
      view_lines=$((rows - 10))
      (( view_lines < 6 )) && view_lines=6
      total_lines="$(tui_status_snapshot_line_count "$snapshot")"
      max_offset=$((total_lines - view_lines))
      (( max_offset < 0 )) && max_offset=0
      (( offset > max_offset )) && offset="$max_offset"

      tui_render_status_scrolled "$snapshot" "$offset"
      key="$(tui_read_key || true)"
      [[ -n "$key" ]] || continue
      case "$key" in
        up)
          (( offset > 0 )) && offset=$((offset - 1))
          ;;
        down)
          (( offset < max_offset )) && offset=$((offset + 1))
          ;;
        digit:1|char:r|char:R)
          tui_home_accounts_snapshot_cache_clear
          tui_render_status_loading
          tui_home_accounts_snapshot_cached
          snapshot="$TUI_HOME_SNAPSHOT_RENDER"
          offset=0
          ;;
        quit|esc)
          return 0
          ;;
        enter)
          # no-op
          ;;
      esac
    done
  done
}

tui_action_logs() {
  local lang file lines key
  lang="$(read_ui_lang)"
  file="$TOKEN_REFRESH_LOG"

  while true; do
    tui_quit_requested && return 0

    if [[ -f "$file" ]]; then
      lines="$(cat "$file" 2>/dev/null || true)"
    else
      lines="(log file not found: $file)"
    fi

    while true; do
      tui_quit_requested && return 0

      tui_clear_screen
      tui_panel_open "Logs - $TOKEN_REFRESH_LOG"
      if [[ -n "$lines" ]]; then
        while IFS= read -r line; do
          tui_panel_line "$line"
        done <<< "$lines"
      else
        tui_panel_line "(empty)"
      fi
      tui_panel_close
      echo >&2
      if [[ "$TUI_COLOR_ENABLED" == "true" ]]; then
        printf "%b%s%b\n" "$TUI_COLOR_DIM" "q / Esc back" "$TUI_COLOR_RESET" >&2
      else
        echo "q / Esc back" >&2
      fi

      key="$(tui_read_key || true)"
      [[ -n "$key" ]] || continue
      case "$key" in
        quit|esc)
          break
          ;;
      esac
    done
    break
  done
}

tui_action_refresh_token() {
  local key output
  while true; do
    tui_quit_requested && return 0
    tui_clear_screen
    tui_panel_open "Refresh Account Token"
    tui_panel_line "Running one refresh scan..."
    tui_panel_close

    output="$(cmd_token_refresh_run_once 2>&1 || true)"

    while true; do
      tui_quit_requested && return 0
      tui_clear_screen
      tui_panel_open "Refresh Account Token"
      if [[ -n "$output" ]]; then
        while IFS= read -r line; do
          tui_panel_line "$line"
        done <<< "$output"
      else
        tui_panel_line "(no output)"
      fi
      tui_panel_close
      echo >&2
      if [[ "$TUI_COLOR_ENABLED" == "true" ]]; then
        printf "%b%s%b\n" "$TUI_COLOR_DIM" "r run again  q / Esc back" "$TUI_COLOR_RESET" >&2
      else
        echo "r run again  q / Esc back" >&2
      fi
      key="$(tui_read_key || true)"
      [[ -n "$key" ]] || continue
      case "$key" in
        char:r|char:R|digit:1)
          break
          ;;
        quit|esc)
          return 0
          ;;
      esac
    done
  done
}

tui_home_logo() {
  cat <<'EOF'
  ____ ___  ____  _______  __     _____ _        __
 / ___/ _ \|  _ \| ____\ \/ /    / ____\ \      / /
| |  | | | | | | |  _|  \  /____| (___  \ \ /\ / /
| |__| |_| | |_| | |___ /  \_____\___ \  \ V  V /
 \____\___/|____/|_____/_/\_\    |____/   \_/\_/
EOF
}

tui_home_render_plain() {
  local selected="$1"
  local update_hint="${2:-}"
  local i marker index_txt name_txt desc_txt
  local c_logo="" c_link="" c_sel="" c_desc="" c_dim="" c_title="" c_reset=""
  local hint_prefix hint_cmd
  local -a names=(
    "$(tui_text "$(read_ui_lang)" home_opt_switch)"
    "$(tui_text "$(read_ui_lang)" home_opt_accounts)"
    "$(tui_text "$(read_ui_lang)" home_opt_envs)"
    "$(tui_text "$(read_ui_lang)" home_opt_proxy)"
    "$(tui_text "$(read_ui_lang)" home_opt_status)"
    "$(tui_text "$(read_ui_lang)" home_opt_refresh)"
    "$(tui_text "$(read_ui_lang)" home_opt_logs)"
    "$(tui_text "$(read_ui_lang)" home_opt_quit)"
  )
  local -a descs=(
    "Switch active account quickly"
    "Manage accounts"
    "Manage environments"
    "Configure usage API proxy"
    "View usage and status dashboard"
    "Run one token refresh scan now"
    "View token refresh logs"
    "Exit"
  )

  tui_clear_screen
  if [[ "$TUI_COLOR_ENABLED" == "true" ]]; then
    c_logo="$TUI_COLOR_HILITE"
    c_link="$TUI_COLOR_DIM"
    c_sel="$TUI_COLOR_HILITE"
    c_desc="$TUI_COLOR_DIM"
    c_dim="$TUI_COLOR_DIM"
    c_title="$TUI_COLOR_TITLE"
    c_reset="$TUI_COLOR_RESET"
  fi

  if [[ "$TUI_INTERACTIVE" == "true" ]]; then
    if [[ "$TUI_COLOR_ENABLED" == "true" ]]; then
      while IFS= read -r line; do
        printf '%b%s%b\n' "$c_logo" "$line" "$c_reset" >&2
      done < <(tui_home_logo)
      printf '%b%s%b\n' "$c_link" "https://github.com/wxt2rr/codex-switcher" "$c_reset" >&2
    else
      tui_home_logo >&2
      echo "https://github.com/wxt2rr/codex-switcher" >&2
    fi
    echo >&2
    if [[ -n "$update_hint" ]]; then
      if [[ "$TUI_COLOR_ENABLED" == "true" ]]; then
        if [[ "$update_hint" == *"codex-sw upgrade"* ]]; then
          hint_prefix="${update_hint%%codex-sw upgrade*}"
          hint_cmd="codex-sw upgrade"
          printf '%b%s%b%b%s%b\n' "$c_title" "$hint_prefix" "$c_reset" "$c_sel" "$hint_cmd" "$c_reset" >&2
        else
          printf '%b%s%b\n' "$c_title" "$update_hint" "$c_reset" >&2
        fi
      else
        echo "$update_hint" >&2
      fi
      echo >&2
    fi
    tui_home_render_menu_block "$selected" "stderr"
  else
    tui_home_logo
    echo "  https://github.com/wxt2rr/codex-switcher"
    echo
    if [[ -n "$update_hint" ]]; then
      echo "  $update_hint"
      echo
    fi
    tui_home_render_menu_block "$selected" "stdout"
  fi
}

tui_home_render_menu_block() {
  local selected="$1"
  local out="${2:-stderr}"
  local i marker index_txt
  local name_width=22
  local c_sel="" c_desc="" c_dim="" c_reset=""
  local -a names=(
    "$(tui_text "$(read_ui_lang)" home_opt_switch)"
    "$(tui_text "$(read_ui_lang)" home_opt_accounts)"
    "$(tui_text "$(read_ui_lang)" home_opt_envs)"
    "$(tui_text "$(read_ui_lang)" home_opt_proxy)"
    "$(tui_text "$(read_ui_lang)" home_opt_status)"
    "$(tui_text "$(read_ui_lang)" home_opt_refresh)"
    "$(tui_text "$(read_ui_lang)" home_opt_logs)"
    "$(tui_text "$(read_ui_lang)" home_opt_quit)"
  )
  local -a descs=(
    "Switch active account quickly"
    "Manage accounts"
    "Manage environments"
    "Configure usage API proxy"
    "View usage and status dashboard"
    "Run one token refresh scan now"
    "View token refresh logs"
    "Exit"
  )

  if [[ "$TUI_COLOR_ENABLED" == "true" ]]; then
    c_sel="$TUI_COLOR_HILITE"
    c_desc="$TUI_COLOR_DIM"
    c_dim="$TUI_COLOR_DIM"
    c_reset="$TUI_COLOR_RESET"
  fi

  for i in "${!names[@]}"; do
    marker=" "
    index_txt="$((i + 1))."
    if [[ "$i" -eq "$selected" ]]; then
      marker=">"
      if [[ "$TUI_COLOR_ENABLED" == "true" ]]; then
        if [[ "$out" == "stderr" ]]; then
          printf "%b%s %s %-*s%b %b%s%b\n" \
            "$c_sel" "$marker" "$index_txt" "$name_width" "${names[$i]}" "$c_reset" \
            "$c_sel" "${descs[$i]}" "$c_reset" >&2
        else
          printf "%b%s %s %-*s%b %b%s%b\n" \
            "$c_sel" "$marker" "$index_txt" "$name_width" "${names[$i]}" "$c_reset" \
            "$c_sel" "${descs[$i]}" "$c_reset"
        fi
      else
        if [[ "$out" == "stderr" ]]; then
          printf "%s %s %-*s %s\n" "$marker" "$index_txt" "$name_width" "${names[$i]}" "${descs[$i]}" >&2
        else
          printf "%s %s %-*s %s\n" "$marker" "$index_txt" "$name_width" "${names[$i]}" "${descs[$i]}"
        fi
      fi
    else
      if [[ "$TUI_COLOR_ENABLED" == "true" ]]; then
        if [[ "$out" == "stderr" ]]; then
          printf "  %s %-*s %b%s%b\n" "$index_txt" "$name_width" "${names[$i]}" "$c_desc" "${descs[$i]}" "$c_reset" >&2
        else
          printf "  %s %-*s %b%s%b\n" "$index_txt" "$name_width" "${names[$i]}" "$c_desc" "${descs[$i]}" "$c_reset"
        fi
      else
        if [[ "$out" == "stderr" ]]; then
          printf "  %s %-*s %s\n" "$index_txt" "$name_width" "${names[$i]}" "${descs[$i]}" >&2
        else
          printf "  %s %-*s %s\n" "$index_txt" "$name_width" "${names[$i]}" "${descs[$i]}"
        fi
      fi
    fi
  done
  if [[ "$out" == "stderr" ]]; then
    echo >&2
    if [[ "$TUI_COLOR_ENABLED" == "true" ]]; then
      printf '%b%s%b\n' "$c_dim" "$(tui_text "$(read_ui_lang)" nav_hint)" "$c_reset" >&2
    else
      echo "$(tui_text "$(read_ui_lang)" nav_hint)" >&2
    fi
  else
    echo
    if [[ "$TUI_COLOR_ENABLED" == "true" ]]; then
      printf '%b%s%b\n' "$c_dim" "$(tui_text "$(read_ui_lang)" nav_hint)" "$c_reset"
    else
      echo "$(tui_text "$(read_ui_lang)" nav_hint)"
    fi
  fi
}

tui_home_choose_action() {
  local idx=0
  local key d
  local update_hint="${1:-}"
  while true; do
    tui_home_render_plain "$idx" "$update_hint"
    key="$(tui_read_key || true)"
    [[ -n "$key" ]] || continue
    case "$key" in
      up)
        idx=$(( (idx - 1 + 8) % 8 ))
        ;;
      down)
        idx=$(( (idx + 1) % 8 ))
        ;;
      enter)
        TUI_MENU_RESULT="$idx"
        return 0
        ;;
      quit)
        TUI_MENU_RESULT="-1"
        return 0
        ;;
      digit:*)
        d="${key#digit:}"
        if [[ "$d" =~ ^[0-9]+$ ]]; then
          d=$((d - 1))
          if (( d >= 0 && d < 8 )); then
            TUI_MENU_RESULT="$d"
            return 0
          fi
        fi
        ;;
    esac
  done
}

cmd_tui() {
  local choice update_hint
  tui_setup_terminal
  # Some shells/TTY setups can transiently mark this process as background
  # while app launching/focus switching; ignore TTIN/TTOU to avoid suspend.
  trap '' TTIN TTOU
  trap 'tui_restore_terminal; trap - TTIN TTOU' EXIT INT TERM
  update_hint="$(CODEX_SWITCHER_UPDATE_CHECK_TIMEOUT=2 update_available_message || true)"
  tui_clear_home_request

  while true; do
    tui_quit_requested && break
    if tui_home_requested; then
      tui_clear_home_request
      continue
    fi
    tui_home_choose_action "$update_hint"
    choice="$TUI_MENU_RESULT"
    case "$choice" in
      -1|7)
        break
        ;;
      0)
        tui_action_switch || true
        ;;
      1)
        tui_action_accounts || true
        ;;
      2)
        tui_action_envs || true
        ;;
      3)
        tui_action_proxy || true
        ;;
      4)
        tui_action_status || true
        ;;
      5)
        tui_action_refresh_token || true
        ;;
      6)
        tui_action_logs || true
        ;;
    esac
  done

  tui_restore_terminal
  trap - TTIN TTOU
  trap - EXIT INT TERM
}

redact() {
  sed -E \
    -e 's/sk-[A-Za-z0-9_-]{8,}/sk-***REDACTED***/g' \
    -e 's/(access_token|refresh_token|id_token)=([^[:space:]]+)/\1=REDACTED/g'
}

log_event() {
  local level="$1"
  shift
  local message="$*"
  mkdir -p "$STATE_DIR"
  chmod 700 "$STATE_DIR" 2>/dev/null || true
  printf '%s [%s] %s\n' "$(now_utc)" "$level" "$message" | redact >> "$SWITCH_LOG"
}

debug_event() {
  [[ "${CODEX_SWITCHER_DEBUG:-false}" == "true" ]] || return 0
  log_event DEBUG "$@"
}

ensure_dirs() {
  mkdir -p "$STATE_DIR" "$ENVS_DIR" "$ACCOUNTS_DIR"
  mkdir -p "$DEFAULT_HOME"
  chmod 700 "$STATE_DIR" "$ENVS_DIR" "$ACCOUNTS_DIR" "$DEFAULT_HOME" 2>/dev/null || true
}

perm_of() {
  local path="$1"
  if stat -f '%Lp' "$path" >/dev/null 2>&1; then
    stat -f '%Lp' "$path"
  else
    stat -c '%a' "$path"
  fi
}

validate_name_noexit() {
  local name="${1:-}"
  [[ -n "$name" ]] || return 1
  [[ "$name" =~ ^[A-Za-z0-9._-]+$ ]] || return 1
  return 0
}

normalize_name_input() {
  local name="${1:-}"
  # Normalize common full-width punctuation from CJK IME to ASCII.
  name="${name//－/-}"
  name="${name//＿/_}"
  name="${name//．/.}"
  # Remove bracketed-paste wrappers if terminal sent them.
  name="${name//$'\e[200~'/}"
  name="${name//$'\e[201~'/}"
  # Drop control chars (including ESC/CR/LF/TAB) that are invisible on screen.
  name="$(printf '%s' "$name" | tr -d '\000-\037\177')"
  echo "$name"
}

validate_env_name_noexit() {
  local name="${1:-}"
  [[ "$name" == "$DEFAULT_ENV_NAME" ]] && return 0
  validate_name_noexit "$name"
}

validate_env_name() {
  local name="${1:-}"
  validate_env_name_noexit "$name" || err "invalid env '$name' (allowed: A-Z a-z 0-9 . _ -, plus reserved: default)"
}

validate_account_name() {
  local name="${1:-}"
  validate_name_noexit "$name" || err "invalid account '$name' (allowed: A-Z a-z 0-9 . _ -)"
}

env_root_path() {
  local env="$1"
  echo "$ENVS_DIR/$env"
}

env_home_path() {
  local env="$1"
  if [[ "$env" == "$DEFAULT_ENV_NAME" ]]; then
    echo "$DEFAULT_HOME"
  else
    echo "$ENVS_DIR/$env/home"
  fi
}

account_dir_path() {
  local env="$1"
  local account="$2"
  echo "$ACCOUNTS_DIR/$env/$account"
}

account_auth_path() {
  local env="$1"
  local account="$2"
  echo "$(account_dir_path "$env" "$account")/auth.json"
}

account_runtime_path() {
  local env="$1"
  local account="$2"
  echo "$(account_dir_path "$env" "$account")/runtime.json"
}

env_config_path() {
  local env="$1"
  echo "$(env_home_path "$env")/config.toml"
}

current_env_file() {
  local target="$1"
  echo "$STATE_DIR/current_${target}_env"
}

current_account_file() {
  local target="$1"
  echo "$STATE_DIR/current_${target}_account"
}

normalize_usage_proxy_value() {
  local raw="${1:-}"
  local value
  value="$(echo "$raw" | tr -d '\r' | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')"
  [[ -n "$value" ]] || return 1
  [[ "$value" != *[[:space:]]* ]] || return 1
  case "$value" in
    http://*|https://*|socks5://*)
      echo "$value"
      ;;
    *)
      echo "http://$value"
      ;;
  esac
}

read_usage_proxy() {
  local value
  [[ -f "$USAGE_PROXY_FILE" ]] || return 1
  value="$(head -n 1 "$USAGE_PROXY_FILE" 2>/dev/null || true)"
  normalize_usage_proxy_value "$value"
}

detect_usage_proxy_from_env() {
  local key raw normalized
  for key in CODEX_SWITCHER_USAGE_PROXY HTTPS_PROXY https_proxy HTTP_PROXY http_proxy ALL_PROXY all_proxy; do
    raw="${!key:-}"
    [[ -n "$raw" ]] || continue
    normalized="$(normalize_usage_proxy_value "$raw" || true)"
    [[ -n "$normalized" ]] || continue
    echo "$normalized"
    return 0
  done
  return 1
}

detect_usage_proxy_from_system_macos() {
  [[ "$DISABLE_SYSTEM_PROXY_DETECT" != "true" ]] || return 1
  [[ "$(uname -s 2>/dev/null || true)" == "Darwin" ]] || return 1
  command -v scutil >/dev/null 2>&1 || return 1

  local dump host port enabled normalized
  dump="$(scutil --proxy 2>/dev/null || true)"
  [[ -n "$dump" ]] || return 1

  host="$(echo "$dump" | sed -nE 's/^[[:space:]]*HTTPSProxy[[:space:]]*:[[:space:]]*(.+)$/\1/p' | head -n 1)"
  port="$(echo "$dump" | sed -nE 's/^[[:space:]]*HTTPSPort[[:space:]]*:[[:space:]]*([0-9]+)$/\1/p' | head -n 1)"
  enabled="$(echo "$dump" | sed -nE 's/^[[:space:]]*HTTPSEnable[[:space:]]*:[[:space:]]*([01])$/\1/p' | head -n 1)"
  if [[ "$enabled" == "1" && -n "$host" && -n "$port" ]]; then
    normalized="$(normalize_usage_proxy_value "http://$host:$port" || true)"
    [[ -n "$normalized" ]] && echo "$normalized" && return 0
  fi

  host="$(echo "$dump" | sed -nE 's/^[[:space:]]*HTTPProxy[[:space:]]*:[[:space:]]*(.+)$/\1/p' | head -n 1)"
  port="$(echo "$dump" | sed -nE 's/^[[:space:]]*HTTPPort[[:space:]]*:[[:space:]]*([0-9]+)$/\1/p' | head -n 1)"
  enabled="$(echo "$dump" | sed -nE 's/^[[:space:]]*HTTPEnable[[:space:]]*:[[:space:]]*([01])$/\1/p' | head -n 1)"
  if [[ "$enabled" == "1" && -n "$host" && -n "$port" ]]; then
    normalized="$(normalize_usage_proxy_value "http://$host:$port" || true)"
    [[ -n "$normalized" ]] && echo "$normalized" && return 0
  fi

  host="$(echo "$dump" | sed -nE 's/^[[:space:]]*SOCKSProxy[[:space:]]*:[[:space:]]*(.+)$/\1/p' | head -n 1)"
  port="$(echo "$dump" | sed -nE 's/^[[:space:]]*SOCKSPort[[:space:]]*:[[:space:]]*([0-9]+)$/\1/p' | head -n 1)"
  enabled="$(echo "$dump" | sed -nE 's/^[[:space:]]*SOCKSEnable[[:space:]]*:[[:space:]]*([01])$/\1/p' | head -n 1)"
  if [[ "$enabled" == "1" && -n "$host" && -n "$port" ]]; then
    normalized="$(normalize_usage_proxy_value "socks5://$host:$port" || true)"
    [[ -n "$normalized" ]] && echo "$normalized" && return 0
  fi

  return 1
}

resolve_usage_proxy_with_source() {
  local value

  value="$(read_usage_proxy || true)"
  if [[ -n "$value" ]]; then
    printf 'manual\t%s\n' "$value"
    return 0
  fi

  value="$(detect_usage_proxy_from_env || true)"
  if [[ -n "$value" ]]; then
    printf 'auto-env\t%s\n' "$value"
    return 0
  fi

  value="$(detect_usage_proxy_from_system_macos || true)"
  if [[ -n "$value" ]]; then
    printf 'auto-system\t%s\n' "$value"
    return 0
  fi

  return 1
}

set_usage_proxy() {
  local value="$1"
  local file tmp
  file="$USAGE_PROXY_FILE"
  tmp="${file}.tmp"
  printf '%s\n' "$value" > "$tmp"
  chmod 600 "$tmp" 2>/dev/null || true
  mv "$tmp" "$file"
}

clear_usage_proxy() {
  rm -f -- "$USAGE_PROXY_FILE"
}

display_path_for_output() {
  local path="$1"
  if [[ "$path" == "$HOME" ]]; then
    echo "~"
    return
  fi
  if [[ "$path" == "$HOME/"* ]]; then
    echo "~/${path#$HOME/}"
    return
  fi
  echo "$path"
}

set_current_env() {
  local target="$1"
  local env="$2"
  local file tmp
  file="$(current_env_file "$target")"
  tmp="${file}.tmp"
  printf '%s\n' "$env" > "$tmp"
  chmod 600 "$tmp" 2>/dev/null || true
  mv "$tmp" "$file"
}

set_current_account() {
  local target="$1"
  local account="$2"
  local file tmp
  file="$(current_account_file "$target")"
  tmp="${file}.tmp"
  printf '%s\n' "$account" > "$tmp"
  chmod 600 "$tmp" 2>/dev/null || true
  mv "$tmp" "$file"
}

read_current_env() {
  local target="$1"
  local file value

  if core_cli_available; then
    if value="$(core_read_current_env "$target")"; then
      echo "$value"
      return 0
    fi
  fi

  file="$(current_env_file "$target")"

  if [[ ! -f "$file" ]]; then
    echo "$DEFAULT_ENV_NAME"
    return 1
  fi

  value="$(head -n 1 "$file" | tr -d '\r' | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')"
  if ! validate_env_name_noexit "$value"; then
    echo "$DEFAULT_ENV_NAME"
    return 2
  fi

  echo "$value"
  return 0
}

read_current_account() {
  local target="$1"
  local file value

  if core_cli_available; then
    if value="$(core_read_current_account "$target")"; then
      echo "$value"
      return 0
    fi
  fi

  file="$(current_account_file "$target")"

  if [[ ! -f "$file" ]]; then
    echo "$DEFAULT_ACCOUNT_NAME"
    return 1
  fi

  value="$(head -n 1 "$file" | tr -d '\r' | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')"
  if ! validate_name_noexit "$value"; then
    echo "$DEFAULT_ACCOUNT_NAME"
    return 2
  fi

  echo "$value"
  return 0
}

core_cli_path() {
  local repo_root
  repo_root="$(cd "$SCRIPT_DIR/../../.." && pwd)"
  echo "$repo_root/scripts/core-cli.ts"
}

core_cli_available() {
  local core_cli
  core_cli="$(core_cli_path)"
  command -v npx >/dev/null 2>&1 && [[ -f "$core_cli" ]]
}

core_read_current_env() {
  local target="$1"
  local core_cli output
  core_cli="$(core_cli_path)"
  output="$(npx --yes tsx "$core_cli" whoami "$target" 2>/dev/null || true)"
  output="${output%%/*}"
  [[ -n "$output" ]] || return 1
  echo "$output"
}

core_read_current_account() {
  local target="$1"
  local core_cli output
  core_cli="$(core_cli_path)"
  output="$(npx --yes tsx "$core_cli" whoami "$target" 2>/dev/null || true)"
  output="${output#*/}"
  [[ -n "$output" ]] || return 1
  echo "$output"
}

run_core_cli_command() {
  local core_cli
  core_cli="$(core_cli_path)"
  npx --yes tsx "$core_cli" "$@"
}

ensure_env_home() {
  local env="$1"
  local home
  validate_env_name "$env"
  home="$(env_home_path "$env")"
  mkdir -p "$home"
  if [[ "$env" != "$DEFAULT_ENV_NAME" ]]; then
    mkdir -p "$(env_root_path "$env")"
  fi
  chmod 700 "$home" 2>/dev/null || true
}

env_exists() {
  local env="$1"
  if [[ "$env" == "$DEFAULT_ENV_NAME" ]]; then
    return 0
  fi
  [[ -d "$(env_home_path "$env")" ]]
}

require_env_exists() {
  local env="$1"
  validate_env_name "$env"
  if [[ "$env" == "$DEFAULT_ENV_NAME" ]]; then
    ensure_env_home "$env"
    return 0
  fi
  [[ -d "$(env_home_path "$env")" ]] || err "env '$env' not found. run: $SCRIPT_NAME env create $env"
}

ensure_account_slot() {
  local env="$1"
  local account="$2"
  validate_env_name "$env"
  validate_account_name "$account"
  mkdir -p "$(account_dir_path "$env" "$account")"
  chmod 700 "$(account_dir_path "$env" "$account")" 2>/dev/null || true
}

account_has_auth() {
  local env="$1"
  local account="$2"
  local auth_file home_auth
  auth_file="$(account_auth_path "$env" "$account")"
  if [[ -f "$auth_file" ]]; then
    debug_event "account_has_auth env=$env account=$account source=account file=$auth_file result=true"
    return 0
  fi
  if [[ "$account" == "$DEFAULT_ACCOUNT_NAME" ]]; then
    home_auth="$(env_home_path "$env")/auth.json"
    if [[ -f "$home_auth" ]]; then
      debug_event "account_has_auth env=$env account=$account source=env_home file=$home_auth result=true"
      return 0
    fi
  fi
  debug_event "account_has_auth env=$env account=$account source=none account_file=$auth_file result=false"
  return 1
}

list_env_names() {
  if core_cli_available; then
    local core_cli
    core_cli="$(core_cli_path)"
    npx --yes tsx "$core_cli" env-ls | sed -E 's/^-[[:space:]]+([^[:space:]]+).*$/\1/'
    return 0
  fi
  echo "$DEFAULT_ENV_NAME"
  if [[ -d "$ENVS_DIR" ]]; then
    find "$ENVS_DIR" -mindepth 1 -maxdepth 1 -type d -exec basename {} \; | sort | while IFS= read -r env; do
      validate_env_name_noexit "$env" || continue
      [[ "$env" == "$DEFAULT_ENV_NAME" ]] && continue
      [[ -d "$(env_home_path "$env")" ]] || continue
      echo "$env"
    done
  fi
}

list_accounts_for_env() {
  local env="$1"
  if core_cli_available; then
    local core_cli
    core_cli="$(core_cli_path)"
    npx --yes tsx "$core_cli" account-ls "$env" | sed -E 's/^-[[:space:]]+([^[:space:]]+).*$/\1/'
    return 0
  fi
  local dir any has_default
  dir="$ACCOUNTS_DIR/$env"
  any=0
  has_default=0

  if [[ -d "$dir" ]]; then
    while IFS= read -r account; do
      validate_name_noexit "$account" || continue
      any=1
      [[ "$account" == "$DEFAULT_ACCOUNT_NAME" ]] && has_default=1
      echo "$account" || true
    done < <(find "$dir" -mindepth 1 -maxdepth 1 -type d -exec basename {} \; | sort)
  fi

  if [[ "$env" == "$DEFAULT_ENV_NAME" && "$has_default" -eq 0 && -f "$(env_home_path "$env")/auth.json" ]]; then
    any=1
    echo "$DEFAULT_ACCOUNT_NAME" || true
  fi
}

copy_auth_file() {
  local src="$1"
  local dst="$2"
  local tmp
  tmp="${dst}.tmp"
  cp "$src" "$tmp"
  chmod 600 "$tmp" 2>/dev/null || true
  mv "$tmp" "$dst"
}

write_auth_config_for_env_account() {
  local env="$1"
  local account="$2"
  local config_file preferred mode base_url tmp
  ensure_env_home "$env"
  config_file="$(env_config_path "$env")"
  preferred="$(preferred_auth_method_for_account "$env" "$account")"
  mode="$(openai_base_url_mode_for_account "$env" "$account")"
  base_url="$(openai_base_url_for_account "$env" "$account")"
  tmp="${config_file}.tmp"
  python3 - "$config_file" "$tmp" "$preferred" "$mode" "$base_url" <<'PY'
import pathlib, re, sys

src_path = pathlib.Path(sys.argv[1])
tmp_path = pathlib.Path(sys.argv[2])
preferred = (sys.argv[3] or "").strip() or "chatgpt"
mode = (sys.argv[4] or "").strip() or "default"
base_url = (sys.argv[5] or "").strip()

existing = ""
if src_path.exists():
    existing = src_path.read_text(encoding="utf-8")

lines = existing.splitlines()
kept = []
skip_blank_after_header = False
for line in lines:
    stripped = line.strip()
    if stripped in ('[model_providers.openai]', '[model_providers."openai"]'):
        skip_blank_after_header = True
        continue
    if re.match(r'^preferred_auth_method\s*=', stripped):
        continue
    if re.match(r'^openai_base_url\s*=', stripped):
        continue
    if skip_blank_after_header and stripped == "":
        continue
    skip_blank_after_header = False
    kept.append(line)

while kept and kept[0].strip() == "":
    kept.pop(0)
while kept and kept[-1].strip() == "":
    kept.pop()

prefix = [f'preferred_auth_method = "{preferred}"']
if preferred == "apikey" and mode == "custom" and base_url:
    prefix.append(f'openai_base_url = "{base_url}"')

parts = ["\n".join(prefix)]
if kept:
    parts.append("\n".join(kept))
content = "\n".join(parts) + "\n"
tmp_path.write_text(content, encoding="utf-8")
PY
  chmod 600 "$tmp" 2>/dev/null || true
  mv "$tmp" "$config_file"
}

clear_auth_config_for_env() {
  local env="$1"
  local config_file tmp
  ensure_env_home "$env"
  config_file="$(env_config_path "$env")"
  [[ -f "$config_file" ]] || return 0
  tmp="${config_file}.tmp"
  python3 - "$config_file" "$tmp" <<'PY'
import pathlib, re, sys

src_path = pathlib.Path(sys.argv[1])
tmp_path = pathlib.Path(sys.argv[2])
lines = src_path.read_text(encoding="utf-8").splitlines()
kept = []
skip_blank_after_header = False
for line in lines:
    stripped = line.strip()
    if stripped in ('[model_providers.openai]', '[model_providers."openai"]'):
        skip_blank_after_header = True
        continue
    if re.match(r'^preferred_auth_method\s*=', stripped):
        continue
    if re.match(r'^openai_base_url\s*=', stripped):
        continue
    if skip_blank_after_header and stripped == "":
        continue
    skip_blank_after_header = False
    kept.append(line)

while kept and kept[0].strip() == "":
    kept.pop(0)
while kept and kept[-1].strip() == "":
    kept.pop()

content = ("\n".join(kept) + "\n") if kept else ""
tmp_path.write_text(content, encoding="utf-8")
PY
  chmod 600 "$tmp" 2>/dev/null || true
  mv "$tmp" "$config_file"
}

write_account_runtime() {
  local env="$1"
  local account="$2"
  local preferred_auth_method="$3"
  local base_url_mode="$4"
  local base_url="${5:-}"
  local dst tmp
  ensure_account_slot "$env" "$account"
  dst="$(account_runtime_path "$env" "$account")"
  tmp="${dst}.tmp"
  python3 - "$tmp" "$preferred_auth_method" "$base_url_mode" "$base_url" <<'PY'
import json, sys
path, preferred, mode, base_url = sys.argv[1:5]
payload = {
    "preferred_auth_method": preferred,
    "openai_base_url_mode": mode,
    "openai_base_url": base_url,
}
with open(path, "w", encoding="utf-8") as f:
    json.dump(payload, f, ensure_ascii=True, separators=(",", ":"))
PY
  chmod 600 "$tmp" 2>/dev/null || true
  mv "$tmp" "$dst"
}

runtime_field_for_account() {
  local env="$1"
  local account="$2"
  local field="$3"
  local runtime_file
  runtime_file="$(account_runtime_path "$env" "$account")"
  python3 - "$runtime_file" "$field" <<'PY'
import json, sys
path, field = sys.argv[1], sys.argv[2]
try:
    with open(path, "r", encoding="utf-8") as f:
        data = json.load(f)
    value = data.get(field, "")
    print("" if value is None else str(value))
except Exception:
    print("")
PY
}

save_env_auth_to_account() {
  local env="$1"
  local account="$2"
  local home_auth dst
  home_auth="$(env_home_path "$env")/auth.json"
  [[ -f "$home_auth" ]] || return 1
  ensure_account_slot "$env" "$account"
  dst="$(account_auth_path "$env" "$account")"
  copy_auth_file "$home_auth" "$dst"
}

refresh_targets_for_account_if_current() {
  local env="$1"
  local account="$2"
  local cli_env app_env cli_account app_account
  cli_env="$(read_current_env cli || true)"
  app_env="$(read_current_env app || true)"
  cli_account="$(read_current_account cli || true)"
  app_account="$(read_current_account app || true)"

  if [[ "$env" == "$cli_env" && "$account" == "$cli_account" ]]; then
    install_account_auth_to_env "$env" "$account"
  fi
  if [[ "$env" == "$app_env" && "$account" == "$app_account" ]]; then
    install_account_auth_to_env "$env" "$account"
  fi
}

clear_env_auth() {
  local env="$1"
  rm -f -- "$(env_home_path "$env")/auth.json"
  clear_auth_config_for_env "$env"
}

install_account_auth_to_env() {
  local env="$1"
  local account="$2"
  local src dst
  src="$(account_auth_path "$env" "$account")"
  dst="$(env_home_path "$env")/auth.json"
  debug_event "install_auth_start env=$env account=$account src=$src dst=$dst src_exists=$([[ -f "$src" ]] && echo true || echo false) dst_exists=$([[ -f "$dst" ]] && echo true || echo false)"
  if [[ -f "$src" ]]; then
    copy_auth_file "$src" "$dst"
    write_auth_config_for_env_account "$env" "$account"
    debug_event "install_auth_done env=$env account=$account source=account dst=$dst dst_exists=$([[ -f "$dst" ]] && echo true || echo false)"
    return 0
  fi
  if [[ "$account" == "$DEFAULT_ACCOUNT_NAME" ]] && [[ -f "$dst" ]]; then
    write_auth_config_for_env_account "$env" "$account"
    debug_event "install_auth_done env=$env account=$account source=existing_default dst=$dst dst_exists=true"
    return 0
  fi
  rm -f -- "$dst"
  clear_auth_config_for_env "$env"
  debug_event "install_auth_cleared env=$env account=$account dst=$dst"
}

sync_overwrite_excluding_auth() {
  local src="$1"
  local dst="$2"

  [[ -d "$src" ]] || err "sync source not found: $src"
  mkdir -p "$dst"

  if command -v rsync >/dev/null 2>&1; then
    rsync -a --checksum --delete --exclude 'auth.json' "$src/" "$dst/"
  else
    find "$dst" -mindepth 1 -maxdepth 1 ! -name 'auth.json' -exec rm -rf -- {} + 2>/dev/null || true
    (cd "$src" && tar cf - --exclude ./auth.json .) | (cd "$dst" && tar xpf -)
  fi
  chmod 700 "$dst" 2>/dev/null || true
}

acquire_lock() {
  ensure_dirs
  local start now lock_pid
  start="$(date +%s)"

  while true; do
    if mkdir "$LOCK_DIR" 2>/dev/null; then
      printf '%s\n' "$$" > "$LOCK_DIR/pid"
      chmod 700 "$LOCK_DIR" 2>/dev/null || true
      trap 'release_lock' EXIT INT TERM
      return 0
    fi

    lock_pid=""
    if [[ -f "$LOCK_DIR/pid" ]]; then
      lock_pid="$(cat "$LOCK_DIR/pid" 2>/dev/null || true)"
    fi

    if [[ -n "$lock_pid" ]] && ! kill -0 "$lock_pid" >/dev/null 2>&1; then
      rm -rf "$LOCK_DIR" >/dev/null 2>&1 || true
      continue
    fi

    now="$(date +%s)"
    if (( now - start >= LOCK_WAIT_SECONDS )); then
      err "failed to acquire lock within ${LOCK_WAIT_SECONDS}s"
    fi
    sleep 0.1
  done
}

release_lock() {
  if [[ -d "$LOCK_DIR" ]] && [[ -f "$LOCK_DIR/pid" ]]; then
    local lock_pid
    lock_pid="$(cat "$LOCK_DIR/pid" 2>/dev/null || true)"
    if [[ "$lock_pid" == "$$" ]]; then
      rm -rf "$LOCK_DIR" >/dev/null 2>&1 || true
    fi
  fi
}

with_lock() {
  acquire_lock
  "$@"
  release_lock
  trap - EXIT INT TERM
}

with_targets() {
  local target="$1"
  shift
  local fn="$1"
  shift
  case "$target" in
    cli|app)
      "$fn" "$target" "$@"
      ;;
    both)
      "$fn" cli "$@"
      "$fn" app "$@"
      ;;
    *)
      err "invalid target '$target' (use cli|app|both)"
      ;;
  esac
}

target_home_path() {
  local target="$1"
  local env
  env="$(read_current_env "$target" || true)"
  env_home_path "$env"
}

ensure_target_auth_installed() {
  local target="$1"
  local env account
  env="$(read_current_env "$target" || true)"
  account="$(read_current_account "$target" || true)"
  ensure_env_home "$env"
  if account_has_auth "$env" "$account"; then
    install_account_auth_to_env "$env" "$account"
  else
    clear_env_auth "$env"
  fi
}

runtime_env_lines_for_target() {
  local target="$1"
  local env account auth_file api_key preferred base_url_mode base_url
  env="$(read_current_env "$target" || true)"
  account="$(read_current_account "$target" || true)"
  preferred="$(preferred_auth_method_for_account "$env" "$account")"

  if [[ "$preferred" == "apikey" ]]; then
    auth_file="$(source_auth_file_for_account "$env" "$account" || true)"
    if [[ -z "$auth_file" ]]; then
      printf 'OPENAI_API_KEY=\n'
      printf 'OPENAI_BASE_URL=\n'
      return 0
    fi
    api_key="$(python3 - "$auth_file" <<'PY'
import json, sys
path = sys.argv[1]
try:
    with open(path, "r", encoding="utf-8") as f:
        data = json.load(f)
    print(str(data.get("OPENAI_API_KEY") or "").strip())
except Exception:
    print("")
PY
)"
    if [[ -z "$api_key" ]]; then
      printf 'OPENAI_API_KEY=\n'
      printf 'OPENAI_BASE_URL=\n'
      return 0
    fi
    printf 'OPENAI_API_KEY=%s\n' "$api_key"
    base_url_mode="$(openai_base_url_mode_for_account "$env" "$account")"
    if [[ "$base_url_mode" == "custom" ]]; then
      base_url="$(openai_base_url_for_account "$env" "$account")"
      if [[ -n "$base_url" ]]; then
        printf 'OPENAI_BASE_URL=%s\n' "$base_url"
      else
        printf 'OPENAI_BASE_URL=\n'
      fi
    else
      printf 'OPENAI_BASE_URL=\n'
    fi
  else
    printf 'OPENAI_API_KEY=\n'
    printf 'OPENAI_BASE_URL=\n'
  fi
}

run_codex_for_target() {
  local target="$1"
  shift
  local home rc codex_bin
  local -a env_args=()
  local line
  ensure_target_auth_installed "$target"
  home="$(target_home_path "$target")"
  codex_bin="$(resolve_codex_bin)"
  debug_event "codex_launch_start target=$target home=$home args=$* auth_exists=$([[ -f "$home/auth.json" ]] && echo true || echo false) codex_bin=$codex_bin"
  while IFS= read -r line; do
    env_args+=("$line")
  done < <(runtime_env_lines_for_target "$target")
  env "${env_args[@]}" CODEX_HOME="$home" "$codex_bin" "$@"
  rc=$?
  debug_event "codex_launch_exit target=$target home=$home rc=$rc"
  return "$rc"
}

login_state_for_target() {
  local target="$1"
  local rc home codex_bin
  ensure_target_auth_installed "$target"
  home="$(target_home_path "$target")"
  codex_bin="$(resolve_codex_bin)"

  rc=0
  CODEX_HOME="$home" "$codex_bin" login status >/dev/null 2>&1 || rc=$?
  if [[ "$rc" -eq 0 ]]; then
    echo "logged-in"
  else
    echo "not-logged-in"
  fi
}

resolve_app_bin() {
  if [[ -n "${CODEX_SWITCHER_APP_BIN:-}" ]]; then
    [[ -x "$CODEX_SWITCHER_APP_BIN" ]] || err "CODEX_SWITCHER_APP_BIN is not executable: $CODEX_SWITCHER_APP_BIN"
    echo "$CODEX_SWITCHER_APP_BIN"
    return
  fi

  if [[ -x "/Applications/Codex.app/Contents/MacOS/Codex" ]]; then
    echo "/Applications/Codex.app/Contents/MacOS/Codex"
    return
  fi
  if [[ -x "$HOME/Applications/Codex.app/Contents/MacOS/Codex" ]]; then
    echo "$HOME/Applications/Codex.app/Contents/MacOS/Codex"
    return
  fi
  err "Codex.app binary not found. set CODEX_SWITCHER_APP_BIN manually"
}

resolve_codex_bin() {
  if [[ -n "${CODEX_SWITCHER_CODEX_BIN:-}" ]]; then
    [[ -x "$CODEX_SWITCHER_CODEX_BIN" ]] || err "CODEX_SWITCHER_CODEX_BIN is not executable: $CODEX_SWITCHER_CODEX_BIN"
    echo "$CODEX_SWITCHER_CODEX_BIN"
    return
  fi

  if command -v codex >/dev/null 2>&1; then
    command -v codex
    return
  fi
  if [[ -x "/Applications/Codex.app/Contents/Resources/codex" ]]; then
    echo "/Applications/Codex.app/Contents/Resources/codex"
    return
  fi
  if [[ -x "$HOME/Applications/Codex.app/Contents/Resources/codex" ]]; then
    echo "$HOME/Applications/Codex.app/Contents/Resources/codex"
    return
  fi
  err "codex binary not found. install Codex CLI or set CODEX_SWITCHER_CODEX_BIN"
}

kill_tree() {
  local pid="$1"
  local child
  if [[ -z "$pid" ]]; then
    return 0
  fi
  for child in $(pgrep -P "$pid" 2>/dev/null || true); do
    kill_tree "$child"
  done
  kill "$pid" >/dev/null 2>&1 || true
}

app_instance_pid_file() {
  local instance_id="$1"
  echo "$APP_INSTANCES_DIR/${instance_id}.pid"
}

app_instance_log_file() {
  local instance_id="$1"
  echo "$APP_INSTANCES_DIR/${instance_id}.log"
}

app_instances_dir_ensure() {
  mkdir -p "$APP_INSTANCES_DIR"
}

app_generate_instance_id() {
  printf '%s-%s\n' "$(date +%Y%m%d%H%M%S)" "$$"
}

app_is_pid_running() {
  local pid="$1"
  [[ -n "$pid" ]] || return 1
  kill -0 "$pid" >/dev/null 2>&1
}

app_last_instance_id() {
  cat "$APP_LAST_INSTANCE_FILE" 2>/dev/null || true
}

app_set_last_instance_id() {
  local instance_id="$1"
  printf '%s\n' "$instance_id" > "$APP_LAST_INSTANCE_FILE"
  chmod 600 "$APP_LAST_INSTANCE_FILE" 2>/dev/null || true
}

app_remove_last_instance_if_matches() {
  local instance_id="$1"
  local current
  current="$(app_last_instance_id)"
  if [[ "$current" == "$instance_id" ]]; then
    rm -f "$APP_LAST_INSTANCE_FILE"
  fi
}

app_prune_instance_file() {
  local instance_id="$1"
  rm -f "$(app_instance_pid_file "$instance_id")"
  app_remove_last_instance_if_matches "$instance_id"
}

app_collect_managed_instances() {
  local pid_file instance_id pid
  app_instances_dir_ensure
  for pid_file in "$APP_INSTANCES_DIR"/*.pid; do
    [[ -e "$pid_file" ]] || continue
    instance_id="$(basename "$pid_file" .pid)"
    pid="$(cat "$pid_file" 2>/dev/null || true)"
    if app_is_pid_running "$pid"; then
      printf '%s\t%s\n' "$instance_id" "$pid"
    else
      app_prune_instance_file "$instance_id"
    fi
  done
}

app_is_running() {
  local pid
  pid="$(cat "$APP_PID_FILE" 2>/dev/null || true)"
  if app_is_pid_running "$pid"; then
    return 0
  fi
  rm -f "$APP_PID_FILE"
  app_collect_managed_instances >/dev/null
}

app_stop_managed_instance() {
  local instance_id="$1"
  local pid
  pid="$(cat "$(app_instance_pid_file "$instance_id")" 2>/dev/null || true)"
  if app_is_pid_running "$pid"; then
    log_event INFO "app_stop instance=$instance_id pid=$pid"
    kill_tree "$pid"
    sleep 0.3
  fi
  app_prune_instance_file "$instance_id"
}

app_stop_managed() {
  local stopped=0 instance_id pid last_instance
  last_instance="$(app_last_instance_id)"
  if [[ -n "$last_instance" && -f "$(app_instance_pid_file "$last_instance")" ]]; then
    app_stop_managed_instance "$last_instance"
    stopped=1
  else
    while IFS=$'\t' read -r instance_id pid; do
      [[ -n "$instance_id" ]] || continue
      app_stop_managed_instance "$instance_id"
      stopped=1
    done < <(app_collect_managed_instances)
  fi

  rm -f "$APP_PID_FILE"

  if [[ "$stopped" -eq 1 ]]; then
    echo "Stopped managed app process"
  else
    echo "No managed app process to stop"
  fi
}

app_any_running() {
  pgrep -f "/Codex\\.app/Contents/MacOS/Codex" >/dev/null 2>&1
}

app_stop_unmanaged_if_running() {
  local i
  if [[ "$(uname -s 2>/dev/null || true)" == "Darwin" ]] && command -v osascript >/dev/null 2>&1; then
    osascript -e 'tell application "Codex" to quit' >/dev/null 2>&1 || true
    for ((i=0; i<20; i++)); do
      app_any_running || break
      sleep 0.15
    done
  fi

  if app_any_running; then
    pkill -f "/Codex\\.app/Contents/MacOS/Codex" >/dev/null 2>&1 || true
    sleep 0.2
  fi
}

metrics_script_path() {
  echo "$SCRIPT_DIR/profile-metrics.py"
}

collect_profile_metrics_tsv() {
  local account="$1"
  local auth_file="$2"
  local data_path="$3"
  local usage_proxy="${4:-}"
  local script_path
  script_path="$(metrics_script_path)"
  [[ -f "$script_path" ]] || return 1
  if [[ -n "$usage_proxy" ]]; then
    python3 "$script_path" --account-name "$account" --auth-file "$auth_file" --data-path "$data_path" --usage-proxy "$usage_proxy" 2>/dev/null
  else
    python3 "$script_path" --account-name "$account" --auth-file "$auth_file" --data-path "$data_path" 2>/dev/null
  fi
}

read_api_key_for_login() {
  local api_key="${OPENAI_API_KEY:-}"
  if [[ -n "$api_key" ]]; then
    echo "$api_key"
    return 0
  fi

  if [[ -t 0 ]]; then
    printf "Enter OpenAI API key: " >&2
    IFS= read -r -s api_key || true
    printf "\n" >&2
  else
    IFS= read -r api_key || true
  fi

  api_key="$(echo "${api_key:-}" | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')"
  [[ -n "$api_key" ]] || err "empty API key. rerun: $SCRIPT_NAME ac login <account> --mode apikey"
  echo "$api_key"
}

normalize_base_url_input() {
  local value
  value="$(echo "${1:-}" | tr -d '\r' | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')"
  [[ -n "$value" ]] || return 1
  case "$value" in
    http://*|https://*)
      echo "$value"
      ;;
    *)
      return 1
      ;;
  esac
}

read_base_url_mode_for_login() {
  local choice
  if [[ -t 0 ]]; then
    printf "Base URL [1] default [2] custom (default: 1): " >&2
    IFS= read -r choice || true
  else
    IFS= read -r choice || true
  fi
  choice="$(echo "${choice:-1}" | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')"
  case "$choice" in
    ""|1|default)
      echo "default"
      ;;
    2|custom)
      echo "custom"
      ;;
    *)
      err "invalid base URL choice '$choice' (use 1/default or 2/custom)"
      ;;
  esac
}

read_custom_base_url_for_login() {
  local base_url
  if [[ -t 0 ]]; then
    printf "Enter OpenAI Base URL: " >&2
    IFS= read -r base_url || true
  else
    IFS= read -r base_url || true
  fi
  base_url="$(normalize_base_url_input "${base_url:-}" || true)"
  [[ -n "$base_url" ]] || err "invalid OpenAI Base URL. expected http(s)://..."
  echo "$base_url"
}

read_sub2api_json_for_login() {
  local payload=""
  if [[ -t 0 ]]; then
    echo "Paste sub2api JSON and end with EOF (Ctrl-D):" >&2
    payload="$(cat || true)"
  else
    payload="$(cat || true)"
  fi
  payload="$(echo "${payload:-}" | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')"
  [[ -n "$payload" ]] || err "empty sub2api JSON. rerun: $SCRIPT_NAME ac login <account> --mode sub2api"
  echo "$payload"
}

write_auth_json_from_sub2api_payload() {
  local home="$1"
  local payload="$2"
  local auth_file tmp_file
  auth_file="$home/auth.json"
  tmp_file="${auth_file}.tmp"
  python3 - "$tmp_file" "$payload" <<'PY'
import json, sys

dst = sys.argv[1]
raw = sys.argv[2]
try:
    data = json.loads(raw)
except Exception as exc:
    raise SystemExit(f"invalid sub2api JSON: {exc}")

def s(value):
    return "" if value is None else str(value).strip()

access_token = s(data.get("access_token"))
id_token = s(data.get("id_token"))
refresh_token = s(data.get("refresh_token"))
last_refresh = s(data.get("last_refresh"))
email = s(data.get("email"))
account_id = s(data.get("account_id"))
expired = s(data.get("expired"))

if not access_token:
    raise SystemExit("sub2api JSON missing access_token")
if not id_token:
    raise SystemExit("sub2api JSON missing id_token")

payload = {
    "auth_mode": "chatgpt",
    "tokens": {
        "access_token": access_token,
        "id_token": id_token,
    },
}
if refresh_token:
    payload["refresh_token"] = refresh_token
if last_refresh:
    payload["last_refresh"] = last_refresh
if email:
    payload["email"] = email
if account_id:
    payload["account_id"] = account_id
if expired:
    payload["expired"] = expired

with open(dst, "w", encoding="utf-8") as f:
    json.dump(payload, f, ensure_ascii=True, separators=(",", ":"))
PY
  chmod 600 "$tmp_file" 2>/dev/null || true
  mv "$tmp_file" "$auth_file"
}

cmd_env_list() {
  local repo_root core_cli
  repo_root="$(cd "$SCRIPT_DIR/../../.." && pwd)"
  core_cli="$repo_root/scripts/core-cli.ts"
  if command -v npx >/dev/null 2>&1 && [[ -f "$core_cli" ]]; then
    npx --yes tsx "$core_cli" env-ls
    return 0
  fi
  local cli_env app_env env marks
  cli_env="$(read_current_env cli || true)"
  app_env="$(read_current_env app || true)"
  list_env_names | sort -u | while IFS= read -r env; do
    marks=""
    [[ "$env" == "$cli_env" ]] && marks="${marks} [cli-current]"
    [[ "$env" == "$app_env" ]] && marks="${marks} [app-current]"
    echo "- $env$marks"
  done
}

cmd_env_create() {
  local env="$1"
  local mode="$2"
  local src_env="${3:-}"
  local home src

  validate_env_name "$env"
  [[ "$env" != "$DEFAULT_ENV_NAME" ]] || err "cannot create reserved env '$DEFAULT_ENV_NAME'"
  if env_exists "$env"; then
    err "env '$env' already exists"
  fi

  home="$(env_home_path "$env")"
  mkdir -p "$home"
  chmod 700 "$home" 2>/dev/null || true

  case "$mode" in
    empty)
      :
      ;;
    from-default)
      sync_overwrite_excluding_auth "$DEFAULT_HOME" "$home"
      ;;
    from-env)
      validate_env_name "$src_env"
      require_env_exists "$src_env"
      src="$(env_home_path "$src_env")"
      sync_overwrite_excluding_auth "$src" "$home"
      ;;
    *)
      err "unknown env create mode: $mode"
      ;;
  esac

  log_event INFO "env_create env=$env mode=$mode src=$src_env"
  echo "Created env: $env"
}

_cmd_env_use_target() {
  local target="$1"
  local env="$2"
  local account

  account="$(read_current_account "$target" || true)"
  set_current_env "$target" "$env"
  if account_has_auth "$env" "$account"; then
    set_current_account "$target" "$account"
    install_account_auth_to_env "$env" "$account"
  else
    set_current_account "$target" "$DEFAULT_ACCOUNT_NAME"
    if account_has_auth "$env" "$DEFAULT_ACCOUNT_NAME"; then
      install_account_auth_to_env "$env" "$DEFAULT_ACCOUNT_NAME"
    else
      clear_env_auth "$env"
    fi
  fi
}

cmd_env_use() {
  local env="$1"
  local target="$2"

  require_env_exists "$env"
  if core_cli_available; then
    run_core_cli_command env-use "$env" "$target" >/dev/null
    log_event INFO "env_use env=$env target=$target core=true"
    echo "Switched $target env to: $env"
    return 0
  fi
  with_targets "$target" _cmd_env_use_target "$env"
  log_event INFO "env_use env=$env target=$target"
  echo "Switched $target env to: $env"
}

cmd_env_remove() {
  local env="$1"
  local force="$2"
  local cli_env app_env

  validate_env_name "$env"
  [[ "$env" != "$DEFAULT_ENV_NAME" ]] || err "cannot remove reserved env '$DEFAULT_ENV_NAME'"
  env_exists "$env" || err "env '$env' not found"

  cli_env="$(read_current_env cli || true)"
  app_env="$(read_current_env app || true)"

  if [[ "$env" == "$cli_env" && "$force" != "true" ]]; then
    err "env '$env' is current CLI env; use --force to remove"
  fi
  if [[ "$env" == "$app_env" && "$force" != "true" ]]; then
    err "env '$env' is current App env; use --force to remove"
  fi

  if [[ "$force" != "true" ]]; then
    if ! confirm_delete_twice "env '$env'"; then
      return 0
    fi
  fi

  if [[ "$env" == "$app_env" ]]; then
    app_stop_managed >/dev/null
    set_current_env app "$DEFAULT_ENV_NAME"
    set_current_account app "$DEFAULT_ACCOUNT_NAME"
    ensure_target_auth_installed app
  fi
  if [[ "$env" == "$cli_env" ]]; then
    set_current_env cli "$DEFAULT_ENV_NAME"
    set_current_account cli "$DEFAULT_ACCOUNT_NAME"
    ensure_target_auth_installed cli
  fi

  rm -rf -- "$(env_root_path "$env")" "$ACCOUNTS_DIR/$env"
  log_event INFO "env_remove env=$env force=$force"
  echo "Removed env: $env"
}

cmd_env_current() {
  local target="${1:-all}"
  case "$target" in
    cli)
      read_current_env cli || true
      ;;
    app)
      read_current_env app || true
      ;;
    all)
      echo "cli: $(read_current_env cli || true)"
      echo "app: $(read_current_env app || true)"
      ;;
    *)
      err "invalid target '$target' (use cli|app)"
      ;;
  esac
}

cmd_env_path() {
  local env="${1:-$(read_current_env cli || true)}"
  validate_env_name "$env"
  require_env_exists "$env"
  echo "export CODEX_HOME='$(env_home_path "$env")'"
}

cmd_account_add() {
  local account="$1"
  local env="$2"
  validate_account_name "$account"
  require_env_exists "$env"
  ensure_account_slot "$env" "$account"
  log_event INFO "account_add env=$env account=$account"
  echo "Added account slot: $env/$account"
}

cmd_account_remove() {
  local account="$1"
  local env="$2"
  local force="$3"
  local cli_env app_env cli_account app_account

  validate_account_name "$account"
  validate_env_name "$env"

  if [[ ! -d "$(account_dir_path "$env" "$account")" ]] && ! account_has_auth "$env" "$account"; then
    err "account '$account' not found in env '$env'"
  fi

  cli_env="$(read_current_env cli || true)"
  app_env="$(read_current_env app || true)"
  cli_account="$(read_current_account cli || true)"
  app_account="$(read_current_account app || true)"

  if [[ "$env" == "$cli_env" && "$account" == "$cli_account" && "$force" != "true" ]]; then
    err "account '$account' is current CLI account in env '$env'; use --force to remove"
  fi
  if [[ "$env" == "$app_env" && "$account" == "$app_account" && "$force" != "true" ]]; then
    err "account '$account' is current App account in env '$env'; use --force to remove"
  fi

  if [[ "$force" != "true" ]]; then
    if ! confirm_delete_twice "account '$env/$account'"; then
      return 0
    fi
  fi

  rm -rf -- "$(account_dir_path "$env" "$account")"
  if [[ "$account" == "$DEFAULT_ACCOUNT_NAME" ]]; then
    rm -f -- "$(env_home_path "$env")/auth.json"
  fi

  if [[ "$env" == "$cli_env" && "$account" == "$cli_account" ]]; then
    set_current_account cli "$DEFAULT_ACCOUNT_NAME"
    ensure_target_auth_installed cli
  fi
  if [[ "$env" == "$app_env" && "$account" == "$app_account" ]]; then
    set_current_account app "$DEFAULT_ACCOUNT_NAME"
    ensure_target_auth_installed app
  fi

  log_event INFO "account_remove env=$env account=$account force=$force"
  echo "Removed account slot: $env/$account"
}

cmd_account_list() {
  local env_filter="${1:-}"
  local repo_root core_cli
  if [[ -n "$env_filter" ]]; then
    require_env_exists "$env_filter"
  fi
  repo_root="$(cd "$SCRIPT_DIR/../../.." && pwd)"
  core_cli="$repo_root/scripts/core-cli.ts"
  if command -v npx >/dev/null 2>&1 && [[ -f "$core_cli" ]]; then
    npx --yes tsx "$core_cli" account-ls "${env_filter:-}"
    return 0
  fi
  cmd_list "$env_filter"
}

account_slot_exists() {
  local env="$1"
  local target_account="$2"
  local account
  while IFS= read -r account; do
    [[ "$account" == "$target_account" ]] && return 0
  done < <(list_accounts_for_env "$env")
  return 1
}

_cmd_account_set_target() {
  local target="$1"
  local env="$2"
  local account="$3"
  set_current_env "$target" "$env"
  set_current_account "$target" "$account"
  install_account_auth_to_env "$env" "$account"
}

cmd_account_login() {
  local account="$1"
  local env="$2"
  local target="$3"
  local sync_mode="$4"
  local mode="$5"
  local home codex_bin
  local api_key=""
  local sub2api_payload=""
  local base_url_mode="default"
  local base_url=""

  validate_account_name "$account"
  require_env_exists "$env"
  ensure_env_home "$env"
  home="$(env_home_path "$env")"
  codex_bin="$(resolve_codex_bin)"

  if [[ "$sync_mode" == "true" && "$env" != "$DEFAULT_ENV_NAME" ]]; then
    sync_overwrite_excluding_auth "$DEFAULT_HOME" "$home"
  fi

  case "$mode" in
    auth)
      CODEX_HOME="$home" "$codex_bin" login
      write_account_runtime "$env" "$account" "chatgpt" "default" ""
      ;;
    apikey)
      api_key="$(read_api_key_for_login)"
      base_url_mode="$(read_base_url_mode_for_login)"
      if [[ "$base_url_mode" == "custom" ]]; then
        base_url="$(read_custom_base_url_for_login)"
      fi
      printf '%s\n' "$api_key" | CODEX_HOME="$home" "$codex_bin" login --with-api-key
      write_account_runtime "$env" "$account" "apikey" "$base_url_mode" "$base_url"
      ;;
    sub2api)
      sub2api_payload="$(read_sub2api_json_for_login)"
      write_auth_json_from_sub2api_payload "$home" "$sub2api_payload"
      write_account_runtime "$env" "$account" "chatgpt" "default" ""
      ;;
    *)
      err "invalid mode '$mode' (use auth|apikey|sub2api)"
      ;;
  esac
  save_env_auth_to_account "$env" "$account" || err "login did not produce auth.json in $home"
  refresh_targets_for_account_if_current "$env" "$account"

  with_targets "$target" _cmd_account_set_target "$env" "$account"

  log_event INFO "account_login env=$env account=$account target=$target sync=$sync_mode mode=$mode"
  if [[ "$mode" == "apikey" ]]; then
    echo "API key saved successfully for account: $env/$account"
  else
    maybe_enable_token_refresh_guard
  fi
  echo "Logged in account: $env/$account"
}

cmd_account_base_url_update() {
  local account="$1"
  local env="$2"
  local mode="${3:-default}"
  local base_url=""

  validate_account_name "$account"
  require_env_exists "$env"
  account_has_auth "$env" "$account" || err "account '$account' not found in env '$env'"
  if ! account_uses_api_key_mode "$env" "$account"; then
    err "account '$env/$account' is not apikey-authenticated"
  fi

  case "$mode" in
    default)
      :
      ;;
    custom)
      base_url="$(read_custom_base_url_for_login)"
      ;;
    *)
      err "invalid base URL mode '$mode' (use default|custom)"
      ;;
  esac

  if core_cli_available; then
    run_core_cli_command runtime-update "$env" "$account" "${base_url:-default}" >/dev/null
    log_event INFO "account_base_url_update env=$env account=$account mode=$mode core=true"
    echo "Updated base URL for account: $env/$account"
    return 0
  fi

  write_account_runtime "$env" "$account" "apikey" "$mode" "$base_url"
  refresh_targets_for_account_if_current "$env" "$account"
  log_event INFO "account_base_url_update env=$env account=$account mode=$mode"
  echo "Updated base URL for account: $env/$account"
}

select_login_mode_interactive() {
  local mode_idx
  tui_choose_index_with_back "$(tui_text "$(read_ui_lang)" login_mode_title)" "" "0" \
    "$(tui_text "$(read_ui_lang)" login_mode_auth)" \
    "$(tui_text "$(read_ui_lang)" login_mode_apikey)" \
    "$(tui_text "$(read_ui_lang)" login_mode_sub2api)"
  mode_idx="$TUI_MENU_RESULT"
  [[ "$mode_idx" == "-1" ]] && return 1
  case "$mode_idx" in
    1) echo "apikey" ;;
    2) echo "sub2api" ;;
    *) echo "auth" ;;
  esac
}

cmd_account_relogin() {
  local account="${1:-}"
  local env="${2:-}"
  local target="$3"
  local sync_mode="$4"
  local mode="${5:-}"

  if [[ -z "$env" ]]; then
    if [[ -t 0 ]]; then
      env="$(tui_select_env "$(read_current_env cli || true)")" || err "cancelled"
    else
      err "missing env. use: $SCRIPT_NAME ac relogin [account] --env <env> [--mode auth|apikey|sub2api]"
    fi
  fi

  require_env_exists "$env"

  if [[ -z "$account" ]]; then
    if [[ -t 0 ]]; then
      account="$(tui_select_account "$env" "$(read_current_account cli || true)" false)" || err "cancelled"
    else
      err "missing account. use: $SCRIPT_NAME ac relogin [account] --env <env> [--mode auth|apikey|sub2api]"
    fi
  fi

  validate_account_name "$account"
  account_slot_exists "$env" "$account" || err "account '$account' not found in env '$env'. existing accounts are required for relogin"

  if [[ -z "$mode" ]]; then
    if [[ -t 0 ]]; then
      mode="$(select_login_mode_interactive)" || err "cancelled"
    else
      mode="auth"
    fi
  fi

  case "$mode" in
    auth|apikey|sub2api)
      ;;
    *)
      err "invalid mode '$mode' (use auth|apikey|sub2api)"
      ;;
  esac

  cmd_account_login "$account" "$env" "$target" "$sync_mode" "$mode"
}

cmd_account_use() {
  local account="$1"
  local env="$2"
  local target="$3"
  local sync_mode="$4"

  validate_account_name "$account"
  require_env_exists "$env"
  account_has_auth "$env" "$account" || err "account '$account' in env '$env' has no auth.json. run: $SCRIPT_NAME ac login $account --env $env"

  if [[ "$sync_mode" == "true" ]]; then
    warn "same-env account switch only replaces auth.json; --sync is ignored"
  fi

  if core_cli_available; then
    run_core_cli_command account-use "$env" "$account" "$target" >/dev/null
    log_event INFO "account_use env=$env account=$account target=$target core=true"
    echo "Switched $target account to: $env/$account"
    return 0
  fi

  with_targets "$target" _cmd_account_set_target "$env" "$account"
  log_event INFO "account_use env=$env account=$account target=$target"
  echo "Switched $target account to: $env/$account"
}

cmd_account_logout() {
  local account="$1"
  local env="$2"
  local target="$3"
  local cli_env app_env cli_account app_account

  validate_env_name "$env"
  if [[ -z "$account" ]]; then
    if [[ "$target" == "both" ]]; then
      account="$(read_current_account cli || true)"
    else
      account="$(read_current_account "$target" || true)"
    fi
  fi
  validate_account_name "$account"
  require_env_exists "$env"

  rm -f -- "$(account_auth_path "$env" "$account")"
  rm -f -- "$(account_runtime_path "$env" "$account")"

  cli_env="$(read_current_env cli || true)"
  app_env="$(read_current_env app || true)"
  cli_account="$(read_current_account cli || true)"
  app_account="$(read_current_account app || true)"

  if [[ "$env" == "$cli_env" && "$account" == "$cli_account" ]]; then
    set_current_account cli "$DEFAULT_ACCOUNT_NAME"
    ensure_target_auth_installed cli
  fi
  if [[ "$env" == "$app_env" && "$account" == "$app_account" ]]; then
    set_current_account app "$DEFAULT_ACCOUNT_NAME"
    ensure_target_auth_installed app
  fi

  if [[ "$account" == "$DEFAULT_ACCOUNT_NAME" ]]; then
    rm -f -- "$(env_home_path "$env")/auth.json"
    clear_auth_config_for_env "$env"
  fi

  log_event INFO "account_logout env=$env account=$account target=$target"
  echo "Logged out account: $env/$account"
}

cmd_account_current() {
  local target="${1:-all}"
  case "$target" in
    cli)
      echo "$(read_current_env cli || true)/$(read_current_account cli || true)"
      ;;
    app)
      echo "$(read_current_env app || true)/$(read_current_account app || true)"
      ;;
    all)
      echo "cli: $(read_current_env cli || true)/$(read_current_account cli || true)"
      echo "app: $(read_current_env app || true)/$(read_current_account app || true)"
      ;;
    *)
      err "invalid target '$target' (use cli|app)"
      ;;
  esac
}

cmd_proxy_show() {
  local info source value
  info="$(resolve_usage_proxy_with_source || true)"
  if [[ -z "$info" ]]; then
    echo "usage_api_proxy: off"
    return 0
  fi
  IFS=$'\t' read -r source value <<< "$info"
  case "$source" in
    manual)
      echo "usage_api_proxy: $value (manual)"
      ;;
    auto-env)
      echo "usage_api_proxy: $value (auto:env)"
      ;;
    auto-system)
      echo "usage_api_proxy: $value (auto:system)"
      ;;
    *)
      echo "usage_api_proxy: $value"
      ;;
  esac
}

cmd_proxy_set() {
  local raw="$1"
  local normalized
  normalized="$(normalize_usage_proxy_value "$raw")" || err "invalid proxy '$raw' (expected host:port or scheme://host:port)"
  set_usage_proxy "$normalized"
  log_event INFO "usage_proxy_set value=$normalized"
  echo "Set usage API proxy: $normalized"
}

cmd_proxy_off() {
  clear_usage_proxy
  log_event INFO "usage_proxy_off"
  echo "Manual usage API proxy disabled"
}

cmd_proxy_test() {
  local proxy env_name account auth_file token body_file http_code body_preview info source
  info="$(resolve_usage_proxy_with_source || true)"
  [[ -n "$info" ]] || err "usage API proxy is off and no auto proxy detected. run: $SCRIPT_NAME proxy <host:port>"
  IFS=$'\t' read -r source proxy <<< "$info"

  env_name="$(read_current_env cli || true)"
  account="$(read_current_account cli || true)"
  auth_file="$(account_auth_path "$env_name" "$account")"
  [[ -f "$auth_file" ]] || auth_file="$(env_home_path "$env_name")/auth.json"
  [[ -f "$auth_file" ]] || err "auth.json not found for current CLI env/account: $env_name/$account"

  token="$(python3 - "$auth_file" <<'PY'
import json, sys
path = sys.argv[1]
try:
    with open(path, "r", encoding="utf-8") as f:
        data = json.load(f)
    token = ((data.get("tokens") or {}).get("access_token") or "").strip()
    print(token)
except Exception:
    print("")
PY
)"
  [[ -n "$token" ]] || err "access_token missing in $auth_file"

  body_file="$(mktemp /tmp/codex-sw-proxy-test.XXXXXX)"
  http_code="$(HTTPS_PROXY="$proxy" HTTP_PROXY="$proxy" curl -sS -o "$body_file" -w '%{http_code}' \
    -H "Authorization: Bearer $token" \
    -H "Accept: application/json" \
    -H "User-Agent: Mozilla/5.0" \
    "$USAGE_API_ENDPOINT" || true)"
  body_preview="$(head -c 160 "$body_file" 2>/dev/null || true)"
  rm -f -- "$body_file"

  if [[ "$http_code" == "200" ]]; then
    echo "usage_api_proxy_test: ok (http=200, source=$source, proxy=$proxy, env/account=$env_name/$account)"
    return 0
  fi

  echo "usage_api_proxy_test: failed (http=${http_code:-000}, source=$source, proxy=$proxy, env/account=$env_name/$account)" >&2
  [[ -n "$body_preview" ]] && echo "response_preview: $body_preview" >&2
  return 1
}

checksum_file() {
  local path="$1"
  if command -v shasum >/dev/null 2>&1; then
    shasum "$path" | awk '{print $1}'
  elif command -v md5 >/dev/null 2>&1; then
    md5 -q "$path"
  else
    wc -c < "$path" | tr -d ' '
  fi
}

refresh_account_token_once() {
  local env="$1"
  local account="$2"
  local auth_file tmp_home before after rc exec_log codex_bin
  local current_cli_env current_cli_account current_app_env current_app_account
  auth_file="$(source_auth_file_for_account "$env" "$account" || true)"
  [[ -n "$auth_file" ]] || { echo "failed"; return 0; }

  tmp_home="$(mktemp -d /tmp/codex-sw-token-refresh.XXXXXX)"
  mkdir -p "$tmp_home"
  copy_auth_file "$auth_file" "$tmp_home/auth.json"
  before="$(checksum_file "$tmp_home/auth.json" 2>/dev/null || true)"
  exec_log="$(mktemp /tmp/codex-sw-token-refresh-exec.XXXXXX.log)"
  codex_bin="$(resolve_codex_bin)"

  rc=0
  python3 - "$tmp_home" "$exec_log" "$codex_bin" <<'PY' || rc=$?
import os
import subprocess
import sys

codex_home = sys.argv[1]
log_path = sys.argv[2]
codex_bin = sys.argv[3]
env = dict(os.environ)
env["CODEX_HOME"] = codex_home
cmd = [
    codex_bin,
    "exec",
    "--skip-git-repo-check",
    "reply with: ok",
]
try:
    result = subprocess.run(
        cmd,
        stdout=subprocess.PIPE,
        stderr=subprocess.STDOUT,
        text=True,
        timeout=20,
        env=env,
    )
    with open(log_path, "w", encoding="utf-8") as f:
        f.write(result.stdout or "")
    raise SystemExit(result.returncode)
except subprocess.TimeoutExpired as e:
    with open(log_path, "w", encoding="utf-8") as f:
        f.write((e.stdout or "") if isinstance(e.stdout, str) else "")
        f.write("\n[timeout]\n")
    raise SystemExit(124)
except FileNotFoundError:
    with open(log_path, "w", encoding="utf-8") as f:
        f.write("codex binary not found\n")
    raise SystemExit(127)
PY
  if [[ ! -f "$tmp_home/auth.json" ]]; then
    rm -f -- "$exec_log"
    rm -rf -- "$tmp_home"
    echo "failed"
    return 0
  fi

  if ! python3 - "$tmp_home/auth.json" <<'PY' >/dev/null 2>&1; then
import json, sys
with open(sys.argv[1], "r", encoding="utf-8") as f:
    json.load(f)
PY
    rm -f -- "$exec_log"
    rm -rf -- "$tmp_home"
    echo "failed"
    return 0
  fi

  after="$(checksum_file "$tmp_home/auth.json" 2>/dev/null || true)"
  copy_auth_file "$tmp_home/auth.json" "$auth_file"
  rm -rf -- "$tmp_home"

  current_cli_env="$(read_current_env cli || true)"
  current_cli_account="$(read_current_account cli || true)"
  current_app_env="$(read_current_env app || true)"
  current_app_account="$(read_current_account app || true)"
  if [[ "$env" == "$current_cli_env" && "$account" == "$current_cli_account" ]]; then
    install_account_auth_to_env "$env" "$account"
  fi
  if [[ "$env" == "$current_app_env" && "$account" == "$current_app_account" ]]; then
    install_account_auth_to_env "$env" "$account"
  fi

  if [[ "$before" != "$after" ]]; then
    echo "changed"
  elif (( rc != 0 )); then
    if rg -qi "refresh token.*(expired|revoked|reused)|please log out and sign in again|not logged in" "$exec_log" 2>/dev/null; then
      echo "need_relogin"
    else
      echo "failed"
    fi
  else
    echo "unchanged"
  fi
  rm -f -- "$exec_log"
  return 0
}

cmd_token_refresh_run_once_inner() {
  local env account state
  local scanned=0 skipped=0 refreshed=0 changed=0 failed=0 need_relogin=0 auth_file before_exp after_exp now_ts start_ts
  local remaining_sec ttl_label after_ttl email

  start_ts="$(date +%s)"
  now_ts="$(now_utc)"
  echo
  echo "Token refresh run  $(format_log_time_local)"
  echo "UTC: $now_ts"
  printf '  %-22s %-34s %-20s %-12s %s\n' "ACCOUNT" "EMAIL" "EXPIRES" "REMAINING" "STATUS"
  printf '  %-22s %-34s %-20s %-12s %s\n' "----------------------" "----------------------------------" "--------------------" "------------" "----------------"

  while IFS= read -r env; do
    while IFS= read -r account; do
      scanned=$((scanned + 1))
      if ! account_uses_chatgpt_auth_mode "$env" "$account"; then
        continue
      fi
      auth_file="$(source_auth_file_for_account "$env" "$account" || true)"
      before_exp="$(token_expiry_from_auth_file "$auth_file" 2>/dev/null || echo "-")"
      email="$(token_email_from_auth_file "$auth_file" 2>/dev/null || echo "-")"

      IFS='|' read -r remaining_sec ttl_label <<< "$(python3 - "$before_exp" <<'PYINNER'
import sys
from datetime import datetime, timezone
exp = sys.argv[1].strip()
try:
    dt = datetime.strptime(exp, "%Y-%m-%d %H:%M:%SZ").replace(tzinfo=timezone.utc)
    now = datetime.now(timezone.utc)
    total = int((dt - now).total_seconds())
    if total < 0:
        print(f"{total}|expired")
    elif total < 3600:
        print(f"{total}|{total // 60}m {total % 60}s")
    elif total < 86400:
        print(f"{total}|{total // 3600}h {(total % 3600) // 60}m")
    else:
        print(f"{total}|{total // 86400}d {(total % 86400) // 3600}h")
except Exception:
    print("-1|-")
PYINNER
)"

      if [[ "$remaining_sec" =~ ^[0-9]+$ ]] && (( remaining_sec > 86400 )); then
        skipped=$((skipped + 1))
        format_token_refresh_row "$env/$account" "$email" "$before_exp" "$ttl_label" "fresh"
        continue
      fi

      state="$(refresh_account_token_once "$env" "$account" || true)"
      after_exp="$(token_expiry_from_auth_file "$auth_file" 2>/dev/null || echo "-")"

      refreshed=$((refreshed + 1))
      if [[ "$state" == "changed" ]]; then
        changed=$((changed + 1))
        email="$(token_email_from_auth_file "$auth_file" 2>/dev/null || echo "$email")"
        after_ttl="$(python3 - "$after_exp" <<'PYINNER2'
import sys
from datetime import datetime, timezone
exp = sys.argv[1].strip()
try:
    dt = datetime.strptime(exp, "%Y-%m-%d %H:%M:%SZ").replace(tzinfo=timezone.utc)
    now = datetime.now(timezone.utc)
    total = int((dt - now).total_seconds())
    if total < 0:
        print("expired")
    elif total < 3600:
        print(f"{total // 60}m {total % 60}s")
    elif total < 86400:
        print(f"{total // 3600}h {(total % 3600) // 60}m")
    else:
        print(f"{total // 86400}d {(total % 86400) // 3600}h")
except Exception:
    print("-")
PYINNER2
)"
        format_token_refresh_row "$env/$account" "$email" "$after_exp" "$after_ttl" "refreshed"
      elif [[ "$state" == "need_relogin" ]]; then
        need_relogin=$((need_relogin + 1))
        failed=$((failed + 1))
        format_token_refresh_row "$env/$account" "$email" "$before_exp" "$ttl_label" "relogin required"
      elif [[ "$state" != "unchanged" ]]; then
        failed=$((failed + 1))
        format_token_refresh_row "$env/$account" "$email" "$before_exp" "$ttl_label" "failed"
      else
        format_token_refresh_row "$env/$account" "$email" "$before_exp" "$ttl_label" "checked"
      fi
    done < <(list_accounts_for_env "$env")
  done < <(list_env_names | sort -u)

  local end_ts total_took
  end_ts="$(date +%s)"
  total_took=$((end_ts - start_ts))

  echo "Summary: scanned=$scanned  fresh=$skipped  checked=$refreshed  refreshed=$changed  failed=$failed  relogin=$need_relogin  duration=${total_took}s"
  log_event INFO "token_refresh_run_once scanned=$scanned skipped=$skipped refreshed=$refreshed changed=$changed failed=$failed need_relogin=$need_relogin took=${total_took}s"
}

cmd_token_refresh_run_once() {
  with_lock cmd_token_refresh_run_once_inner
}

cmd_token_refresh_start() {
  local silent="${1:-false}"
  local plist="$LAUNCHD_REFRESH_PLIST"

  launchd_available || err "token refresh guard requires macOS launchd"
  [[ "$TOKEN_REFRESH_INTERVAL_SECONDS" =~ ^[0-9]+$ ]] || err "invalid TOKEN_REFRESH_INTERVAL_SECONDS='$TOKEN_REFRESH_INTERVAL_SECONDS'"
  (( TOKEN_REFRESH_INTERVAL_SECONDS >= 60 )) || err "TOKEN_REFRESH_INTERVAL_SECONDS must be >= 60"

  mkdir -p "$STATE_DIR"
  : > "$TOKEN_REFRESH_LOG"
  chmod 600 "$TOKEN_REFRESH_LOG" 2>/dev/null || true

  write_token_refresh_launchd_plist "$plist"
  chmod 600 "$plist" 2>/dev/null || true

  launchctl unload "$plist" >/dev/null 2>&1 || true
  launchctl load -w "$plist" >/dev/null 2>&1 || err "failed to load launchd job from $plist"
  launchctl start "$LAUNCHD_REFRESH_LABEL" >/dev/null 2>&1 || true

  log_event INFO "token_refresh_start label=$LAUNCHD_REFRESH_LABEL interval=$TOKEN_REFRESH_INTERVAL_SECONDS"
  if [[ "$silent" != "true" ]]; then
    echo "token_refresh_guard: enabled (label=$LAUNCHD_REFRESH_LABEL, interval=${TOKEN_REFRESH_INTERVAL_SECONDS}s)"
    echo "token_refresh_log: $TOKEN_REFRESH_LOG"
  fi
}

cmd_token_refresh_stop() {
  local plist="$LAUNCHD_REFRESH_PLIST"
  launchd_available || err "token refresh guard requires macOS launchd"
  if [[ -f "$plist" ]]; then
    launchctl unload "$plist" >/dev/null 2>&1 || true
    rm -f -- "$plist"
  fi
  log_event INFO "token_refresh_stop label=$LAUNCHD_REFRESH_LABEL"
  echo "token_refresh_guard: disabled"
}

cmd_token_refresh_status() {
  echo "token_refresh_guard: $(token_refresh_guard_status_line)"
  if [[ -f "$LAUNCHD_REFRESH_PLIST" ]]; then
    echo "token_refresh_plist: $LAUNCHD_REFRESH_PLIST"
    echo "token_refresh_log: $TOKEN_REFRESH_LOG"
  fi
}

maybe_enable_token_refresh_guard() {
  if [[ "${CODEX_SWITCHER_DISABLE_TOKEN_REFRESH_AUTO_START:-false}" == "true" ]]; then
    return 0
  fi
  if launchd_available; then
    cmd_token_refresh_start true >/dev/null 2>&1 || warn "failed to enable token refresh guard automatically; run: $SCRIPT_NAME ops token-refresh start"
  fi
}

cmd_list() {
  local env_filter="${1:-}"
  local cli_env app_env cli_account app_account
  local env account marks auth_file home home_display metrics
  local email plan usage_5h usage_weekly source last_activity token_expiry
  local usage_proxy="" usage_info=""

  cli_env="$(read_current_env cli || true)"
  app_env="$(read_current_env app || true)"
  cli_account="$(read_current_account cli || true)"
  app_account="$(read_current_account app || true)"
  usage_info="$(resolve_usage_proxy_with_source || true)"
  if [[ -n "$usage_info" ]]; then
    IFS=$'\t' read -r _ usage_proxy <<< "$usage_info"
  fi

  printf '%-12s %-28s %-30s %-38s %-10s %-20s %-20s %-20s %-16s %s\n' "ENV" "HOME" "ACCOUNT" "EMAIL" "PLAN" "5H USAGE" "WEEKLY USAGE" "AUTH EXPIRY" "LAST ACTIVITY" "SOURCE"
  while IFS= read -r env; do
    if [[ -n "$env_filter" && "$env" != "$env_filter" ]]; then
      continue
    fi
    home="$(env_home_path "$env")"
    home_display="$(display_path_for_output "$home")"
    ensure_env_home "$env"
    local found=0
    while IFS= read -r account; do
      found=1
      email=""
      plan=""
      usage_5h=""
      usage_weekly=""
      token_expiry=""
      last_activity=""
      source=""
      marks=""
      [[ "$env" == "$cli_env" && "$account" == "$cli_account" ]] && marks="${marks} [cli-current]"
      [[ "$env" == "$app_env" && "$account" == "$app_account" ]] && marks="${marks} [app-current]"
      auth_file="$(account_auth_path "$env" "$account")"
      [[ -f "$auth_file" ]] || auth_file="$home/auth.json"

      metrics="$(collect_profile_metrics_tsv "$account" "$auth_file" "$home" "$usage_proxy" || true)"
      if [[ -n "$metrics" ]]; then
        IFS=$'\t' read -r email plan usage_5h usage_weekly last_activity source <<< "$metrics"
      fi
      email="${email:-($account)-}"
      plan="${plan:-unknown}"
      usage_5h="${usage_5h:--}"
      usage_weekly="${usage_weekly:--}"
      token_expiry="$(token_expiry_for_env_account "$env" "$account")"
      last_activity="${last_activity:--}"
      source="${source:-local}"
      [[ "$source" == "api" || "$source" == "local" ]] || source="local"

      printf '%-12s %-28s %-30s %-38s %-10s %-20s %-20s %-20s %-16s %s\n' "$env" "$home_display" "$account$marks" "$email" "$plan" "$usage_5h" "$usage_weekly" "$token_expiry" "$last_activity" "$source"
    done < <(list_accounts_for_env "$env")

    if [[ "$found" -eq 0 ]]; then
      email=""
      plan=""
      usage_5h=""
      usage_weekly=""
      token_expiry=""
      last_activity=""
      source=""
      metrics="$(collect_profile_metrics_tsv "-" "$home/auth.json" "$home" "$usage_proxy" || true)"
      if [[ -n "$metrics" ]]; then
        IFS=$'\t' read -r email plan usage_5h usage_weekly last_activity source <<< "$metrics"
      fi
      email="${email:--}"
      plan="${plan:-unknown}"
      usage_5h="${usage_5h:--}"
      usage_weekly="${usage_weekly:--}"
      token_expiry="-"
      last_activity="${last_activity:--}"
      source="${source:-local}"
      [[ "$source" == "api" || "$source" == "local" ]] || source="local"
      printf '%-12s %-28s %-30s %-38s %-10s %-20s %-20s %-20s %-16s %s\n' "$env" "$home_display" "-" "$email" "$plan" "$usage_5h" "$usage_weekly" "$token_expiry" "$last_activity" "$source"
    fi
  done < <(list_env_names | sort -u)
}

cmd_import_default() {
  local env="$1"
  local with_auth="$2"
  local force="$3"

  validate_env_name "$env"
  [[ "$env" != "$DEFAULT_ENV_NAME" ]] || err "cannot import into reserved env '$DEFAULT_ENV_NAME'"

  if env_exists "$env"; then
    if [[ "$force" != "true" ]]; then
      err "env '$env' already exists. use --force to overwrite"
    fi
    rm -rf -- "$(env_root_path "$env")" "$ACCOUNTS_DIR/$env"
  fi

  cmd_env_create "$env" "from-default" ""
  if [[ "$with_auth" == "true" && -f "$DEFAULT_HOME/auth.json" ]]; then
    ensure_account_slot "$env" "$DEFAULT_ACCOUNT_NAME"
    copy_auth_file "$DEFAULT_HOME/auth.json" "$(account_auth_path "$env" "$DEFAULT_ACCOUNT_NAME")"
    write_account_runtime "$env" "$DEFAULT_ACCOUNT_NAME" "$(preferred_auth_method_for_account "$DEFAULT_ENV_NAME" "$DEFAULT_ACCOUNT_NAME")" "$(openai_base_url_mode_for_account "$DEFAULT_ENV_NAME" "$DEFAULT_ACCOUNT_NAME")" "$(openai_base_url_for_account "$DEFAULT_ENV_NAME" "$DEFAULT_ACCOUNT_NAME")"
  fi

  log_event INFO "import_default_as_env env=$env with_auth=$with_auth force=$force"
  echo "Imported default data to env: $env"
}

target_includes_cli() {
  local target="$1"
  [[ "$target" == "cli" || "$target" == "both" ]]
}

target_includes_app() {
  local target="$1"
  [[ "$target" == "app" || "$target" == "both" ]]
}

app_validate_current_account() {
  local env use_account login_state

  env="$(read_current_env app || true)"
  use_account="$(read_current_account app || true)"
  debug_event "app_current_resolve env=$env account=$use_account"
  validate_account_name "$use_account"
  require_env_exists "$env"
  account_has_auth "$env" "$use_account" || err "account '$use_account' not logged in under env '$env'. run: $SCRIPT_NAME ac login $use_account --env $env --target app"

  ensure_target_auth_installed app
  login_state="$(login_state_for_target app)"
  debug_event "app_current_login_state env=$env account=$use_account state=$login_state home=$(target_home_path app) auth_exists=$([[ -f "$(target_home_path app)/auth.json" ]] && echo true || echo false)"
  if [[ "$login_state" != "logged-in" ]]; then
    err "account '$use_account' in env '$env' is not logged in"
  fi

  printf '%s\t%s\n' "$env" "$use_account"
}

app_spawn_current_instance() {
  local env="$1"
  local use_account="$2"
  local app_bin pid instance_id log_file
  local -a env_args=()
  local line

  app_bin="$(resolve_app_bin)"
  instance_id="$(app_generate_instance_id)"
  log_file="$(app_instance_log_file "$instance_id")"
  app_instances_dir_ensure
  debug_event "app_spawn_prepare env=$env account=$use_account app_bin=$app_bin instance=$instance_id log=$log_file"

  while IFS= read -r line; do
    env_args+=("$line")
  done < <(runtime_env_lines_for_target app)

  nohup env "${env_args[@]}" CODEX_HOME="$(target_home_path app)" CODEX_SWITCHER_MANAGED=1 CODEX_SWITCHER_ENV="$env" CODEX_SWITCHER_ACCOUNT="$use_account" CODEX_SWITCHER_INSTANCE_ID="$instance_id" "$app_bin" </dev/null >>"$log_file" 2>&1 &
  pid="$!"

  printf '%s\n' "$pid" > "$(app_instance_pid_file "$instance_id")"
  printf '%s\n' "$pid" > "$APP_PID_FILE"
  chmod 600 "$(app_instance_pid_file "$instance_id")" "$APP_PID_FILE" 2>/dev/null || true
  app_set_last_instance_id "$instance_id"

  debug_event "app_spawned env=$env account=$use_account pid=$pid home=$(target_home_path app) instance=$instance_id app_log=$log_file"

  if [[ "$(uname -s 2>/dev/null || true)" == "Darwin" ]] && command -v osascript >/dev/null 2>&1; then
    (
      sleep 0.35
      osascript -e 'tell application "Codex" to activate' >/dev/null 2>&1 || true
    ) &
  fi

  log_event INFO "app_spawn env=$env account=$use_account pid=$pid instance=$instance_id"
  echo "Opened Codex App with: $env/$use_account"
  echo "App instance: $instance_id"
  echo "App log: $log_file"
}

cmd_account_use_selected() {
  local account="$1"
  local env="$2"
  local target="$3"
  local sync_mode="${4:-false}"

  debug_event "account_use_start env=$env account=$account target=$target sync=$sync_mode stdin_tty=$([[ -t 0 ]] && echo true || echo false) stdout_tty=$([[ -t 1 ]] && echo true || echo false)"
  with_lock cmd_account_use "$account" "$env" "$target" "$sync_mode"
  debug_event "account_use_done env=$env account=$account target=$target cli=$(read_current_env cli || true)/$(read_current_account cli || true) app=$(read_current_env app || true)/$(read_current_account app || true)"
  if target_includes_cli "$target"; then
    echo "Run in current shell if needed:"
    echo "  export CODEX_HOME='$(target_home_path cli)'"
  fi
}

cmd_current() {
  local target="${1:-all}"
  local repo_root core_cli
  repo_root="$(cd "$SCRIPT_DIR/../../.." && pwd)"
  core_cli="$repo_root/scripts/core-cli.ts"
  if command -v npx >/dev/null 2>&1 && [[ -f "$core_cli" ]]; then
    case "$target" in
      cli|app|all)
        npx --yes tsx "$core_cli" whoami "$target"
        return 0
        ;;
    esac
  fi
  case "$target" in
    cli)
      echo "$(read_current_env cli || true)/$(read_current_account cli || true)"
      ;;
    app)
      echo "$(read_current_env app || true)/$(read_current_account app || true)"
      ;;
    all)
      echo "cli: $(read_current_env cli || true)/$(read_current_account cli || true)"
      echo "app: $(read_current_env app || true)/$(read_current_account app || true)"
      ;;
    *)
      err "invalid target '$target' (use cli|app)"
      ;;
  esac
}

cmd_status() {
  local repo_root core_cli
  repo_root="$(cd "$SCRIPT_DIR/../../.." && pwd)"
  core_cli="$repo_root/scripts/core-cli.ts"
  if command -v npx >/dev/null 2>&1 && [[ -f "$core_cli" ]]; then
    local state_dir default_home accounts_dir
    state_dir="${CODEX_SWITCHER_STATE_DIR:-$HOME/.codex-switcher}"
    default_home="${CODEX_SWITCHER_DEFAULT_HOME:-$HOME/.codex}"
    accounts_dir="${CODEX_SWITCHER_ACCOUNTS_DIR:-$state_dir/env-accounts}"
    echo "DEFAULT AUTH: $(display_path_for_output "$default_home/auth.json")"
    echo "CUSTOM  AUTH: $(display_path_for_output "$accounts_dir/{env}/{account}/auth.json")"
    npx --yes tsx "$core_cli" status
    return 0
  fi
  local cli_env app_env cli_account app_account
  local cli_ptr_state app_ptr_state cli_acc_state app_acc_state
  local cli_state app_state exit_code

  cli_env="$(read_current_env cli)" || cli_ptr_state=$?
  app_env="$(read_current_env app)" || app_ptr_state=$?
  cli_account="$(read_current_account cli)" || cli_acc_state=$?
  app_account="$(read_current_account app)" || app_acc_state=$?
  cli_ptr_state="${cli_ptr_state:-0}"
  app_ptr_state="${app_ptr_state:-0}"
  cli_acc_state="${cli_acc_state:-0}"
  app_acc_state="${app_acc_state:-0}"

  cli_state="$(login_state_for_target cli)"
  app_state="$(login_state_for_target app)"

  echo "cli_current: $cli_env/$cli_account"
  echo "app_current: $app_env/$app_account"
  status_auth_layout
  echo "cli_auth: $(account_auth_status_line "$cli_env" "$cli_account")"
  echo "app_auth: $(account_auth_status_line "$app_env" "$app_account")"
  echo "cli_auth_expiry: $(token_expiry_for_env_account "$cli_env" "$cli_account")"
  echo "app_auth_expiry: $(token_expiry_for_env_account "$app_env" "$app_account")"
  echo "token_refresh_guard: $(token_refresh_guard_status_line)"
  echo "token_refresh_need_relogin_last_run: $(token_refresh_last_need_relogin)"
  echo "cli($cli_env/$cli_account): $cli_state"
  echo "app($app_env/$app_account): $app_state"

  exit_code=0
  if [[ "$cli_ptr_state" -eq 2 || "$app_ptr_state" -eq 2 || "$cli_acc_state" -eq 2 || "$app_acc_state" -eq 2 ]]; then
    echo "hint: pointer file corrupted, run: $SCRIPT_NAME recover" >&2
    exit_code=2
  elif [[ "$cli_state" != "logged-in" || "$app_state" != "logged-in" ]]; then
    exit_code=1
  fi

  return "$exit_code"
}

cmd_exec() {
  [[ "$#" -gt 0 ]] || err "missing codex args. example: $SCRIPT_NAME exec -- login status"
  if [[ "$1" == "--" ]]; then
    shift
  fi
  [[ "$#" -gt 0 ]] || err "missing codex args after --"
  run_codex_for_target cli "$@"
}

cmd_cli_launch_current() {
  if [[ "${1:-}" == "--" ]]; then
    shift
  fi
  if [[ "$#" -gt 0 ]]; then
    echo "Launching codex with env/account: $(read_current_env cli || true)/$(read_current_account cli || true)"
    run_codex_for_target cli "$@"
    return "$?"
  fi
  echo "Launching codex with env/account: $(read_current_env cli || true)/$(read_current_account cli || true)"
  run_codex_for_target cli
}

cmd_app_restart_current() {
  local env use_account
  IFS=$'\t' read -r env use_account < <(app_validate_current_account)
  app_stop_managed >/dev/null
  app_stop_unmanaged_if_running >/dev/null
  app_spawn_current_instance "$env" "$use_account"
}

cmd_app_launch_new() {
  local env use_account
  IFS=$'\t' read -r env use_account < <(app_validate_current_account)
  app_spawn_current_instance "$env" "$use_account"
}

cmd_app_logout() {
  local account="${1:-}"
  local env
  env="$(read_current_env app || true)"
  cmd_account_logout "$account" "$env" "app"
}

cmd_app_status() {
  local env account
  env="$(read_current_env app || true)"
  account="$(read_current_account app || true)"
  echo "app_current: $env/$account"
  if app_is_running; then
    echo "app_process: running(pid=$(cat "$APP_PID_FILE"))"
    return 0
  fi
  echo "app_process: not-running"
  return 1
}

cmd_init() {
  local shell_name=""
  local dry_run="false"
  local script_abs target_link rc_file block_start block_end

  while [[ "$#" -gt 0 ]]; do
    case "$1" in
      --shell)
        shift
        [[ "$#" -gt 0 ]] || err "missing shell after --shell"
        shell_name="$1"
        ;;
      --dry-run)
        dry_run="true"
        ;;
      *)
        err "unknown init option: $1"
        ;;
    esac
    shift
  done

  if [[ -z "$shell_name" ]]; then
    shell_name="$(basename "${SHELL:-zsh}")"
  fi
  case "$shell_name" in
    zsh)
      rc_file="$HOME/.zshrc"
      ;;
    bash)
      rc_file="$HOME/.bashrc"
      ;;
    *)
      err "unsupported shell '$shell_name' (use zsh or bash)"
      ;;
  esac

  script_abs="$SCRIPT_DIR/codex-switcher"
  target_link="$HOME/.local/bin/codex-sw"
  block_start="# >>> codex-sw init >>>"
  block_end="# <<< codex-sw init <<<"

  if [[ "$dry_run" == "true" ]]; then
    echo "[dry-run] mkdir -p $HOME/.local/bin"
    echo "[dry-run] ln -sf $script_abs $target_link"
    echo "[dry-run] ensure PATH block in $rc_file"
    return 0
  fi

  mkdir -p "$HOME/.local/bin"
  ln -sf "$script_abs" "$target_link"

  if [[ ! -f "$rc_file" ]]; then
    touch "$rc_file"
  fi

  if ! grep -qF "$block_start" "$rc_file"; then
    cat >> "$rc_file" <<RC
$block_start
export PATH="\$HOME/.local/bin:\$PATH"
$block_end
RC
  fi

  log_event INFO "init shell=$shell_name rc_file=$rc_file"
  echo "Initialized codex-sw for $shell_name"
  echo "Run: source $rc_file"
}

cmd_upgrade() {
  local dry_run="${1:-false}"
  local registry npm_package cmdline

  command -v npm >/dev/null 2>&1 || err "npm command not found; cannot upgrade. install npm first"
  registry="${CODEX_SWITCHER_UPGRADE_REGISTRY:-https://registry.npmjs.org/}"
  npm_package="${CODEX_SWITCHER_NPM_PACKAGE:-@wangxt0223/codex-switcher}"
  cmdline=(npm i -g "${npm_package}@latest" --registry "$registry")

  if [[ "$dry_run" == "true" ]]; then
    echo "[dry-run] ${cmdline[*]}"
    return 0
  fi

  log_event INFO "upgrade package=$npm_package registry=$registry"
  "${cmdline[@]}"
  echo "Upgraded codex-sw to latest."
}

cmd_recover() {
  local dry_run="${1:-false}"
  local target env account

  for target in cli app; do
    env="$(read_current_env "$target" || true)"
    account="$(read_current_account "$target" || true)"
    validate_env_name_noexit "$env" || env="$DEFAULT_ENV_NAME"
    if [[ "$env" != "$DEFAULT_ENV_NAME" ]] && [[ ! -d "$(env_home_path "$env")" ]]; then
      env="$DEFAULT_ENV_NAME"
    fi
    validate_name_noexit "$account" || account="$DEFAULT_ACCOUNT_NAME"
    if ! account_has_auth "$env" "$account"; then
      account="$DEFAULT_ACCOUNT_NAME"
    fi

    if [[ "$dry_run" != "true" ]]; then
      set_current_env "$target" "$env"
      set_current_account "$target" "$account"
      ensure_target_auth_installed "$target"
    fi

    echo "recover($target): $env/$account"
  done

  if [[ "$dry_run" == "true" ]]; then
    return 0
  fi

  log_event INFO "recover cli=$(read_current_env cli || true)/$(read_current_account cli || true) app=$(read_current_env app || true)/$(read_current_account app || true)"
}

scan_logs_for_secrets() {
  local found=0
  if [[ -f "$SWITCH_LOG" ]] && grep -E 'sk-[A-Za-z0-9_-]{8,}|(access_token|refresh_token|id_token)=' "$SWITCH_LOG" >/dev/null 2>&1; then
    echo "redaction_check: failed ($SWITCH_LOG contains potential secrets)" >&2
    found=1
  fi
  if [[ -f "$APP_LOG" ]] && grep -E 'sk-[A-Za-z0-9_-]{8,}|(access_token|refresh_token|id_token)=' "$APP_LOG" >/dev/null 2>&1; then
    echo "redaction_check: failed ($APP_LOG contains potential secrets)" >&2
    found=1
  fi
  return "$found"
}

cmd_check() {
  resolve_codex_bin >/dev/null
  resolve_app_bin >/dev/null
  ensure_dirs

  local pstate=0
  read_current_env cli >/dev/null || pstate=$?
  if [[ "$pstate" -eq 2 ]]; then
    err "current_cli_env pointer corrupted; run: $SCRIPT_NAME recover"
  fi
  pstate=0
  read_current_env app >/dev/null || pstate=$?
  if [[ "$pstate" -eq 2 ]]; then
    err "current_app_env pointer corrupted; run: $SCRIPT_NAME recover"
  fi
  pstate=0
  read_current_account cli >/dev/null || pstate=$?
  if [[ "$pstate" -eq 2 ]]; then
    err "current_cli_account pointer corrupted; run: $SCRIPT_NAME recover"
  fi
  pstate=0
  read_current_account app >/dev/null || pstate=$?
  if [[ "$pstate" -eq 2 ]]; then
    err "current_app_account pointer corrupted; run: $SCRIPT_NAME recover"
  fi

  if ! scan_logs_for_secrets; then
    err "log redaction check failed"
  fi

  echo "version: $(switcher_version)"
  echo "check: ok"
}

cmd_version() {
  echo "$(switcher_version)"
}

cmd_doctor() {
  local fix="${1:-false}"
  local issues=0
  local state_perm envs_perm accounts_perm

  ensure_dirs
  state_perm="$(perm_of "$STATE_DIR")"
  envs_perm="$(perm_of "$ENVS_DIR")"
  accounts_perm="$(perm_of "$ACCOUNTS_DIR")"

  echo "state_dir: $STATE_DIR (perm=$state_perm)"
  echo "envs_dir: $ENVS_DIR (perm=$envs_perm)"
  echo "accounts_dir: $ACCOUNTS_DIR (perm=$accounts_perm)"
  echo "default_home: $DEFAULT_HOME (perm=$(perm_of "$DEFAULT_HOME"))"
  echo "cli_current: $(read_current_env cli || true)/$(read_current_account cli || true)"
  echo "app_current: $(read_current_env app || true)/$(read_current_account app || true)"

  if ! resolve_codex_bin >/dev/null 2>&1; then
    echo "- codex in PATH: missing"
    issues=1
  else
    echo "- codex binary: ok ($(resolve_codex_bin))"
  fi

  if resolve_app_bin >/dev/null 2>&1; then
    echo "- codex app binary: ok ($(resolve_app_bin))"
  else
    echo "- codex app binary: missing"
    issues=1
  fi

  if [[ "$state_perm" != "700" || "$envs_perm" != "700" || "$accounts_perm" != "700" ]]; then
    issues=1
    echo "- directory permissions are not strict 700"
  fi

  if ! scan_logs_for_secrets; then
    issues=1
  else
    echo "- redaction check: ok"
  fi

  if [[ "$fix" == "true" ]]; then
    chmod 700 "$STATE_DIR" "$ENVS_DIR" "$ACCOUNTS_DIR" "$DEFAULT_HOME" 2>/dev/null || true
    with_lock cmd_recover false
    issues=0
    if ! scan_logs_for_secrets; then
      issues=1
    fi
    echo "doctor --fix: completed"
  fi

  if [[ "$issues" -eq 0 ]]; then
    echo "doctor: ok"
    return 0
  fi

  echo "doctor: issues found"
  if [[ "$fix" != "true" ]]; then
    echo "Run: $SCRIPT_NAME doctor --fix"
  fi
  return 1
}

main() {
  ensure_dirs

  local cmd="${1:-}"
  if [[ -z "$cmd" ]]; then
    cmd="tui"
  else
    shift || true
  fi
  if [[ "$cmd" != "tui" ]]; then
    notify_update_if_available
  fi

  case "$cmd" in
    env)
      local sub="${1:-}"
      [[ -n "$sub" ]] || err "usage: $SCRIPT_NAME env <ls|new|use|rm> ..."
      shift || true
      case "$sub" in
        ls)
          [[ "$#" -eq 0 ]] || err "usage: $SCRIPT_NAME env ls"
          cmd_env_list
          ;;
        new)
          [[ "$#" -ge 1 ]] || err "usage: $SCRIPT_NAME env new <env> [--empty|--from <src-env|default>]"
          local env="$1"
          shift
          local mode="from-default"
          local src_env=""
          while [[ "$#" -gt 0 ]]; do
            case "$1" in
              --empty)
                mode="empty"
                ;;
              --from)
                shift
                [[ "$#" -gt 0 ]] || err "missing source env after --from"
                if [[ "$1" == "$DEFAULT_ENV_NAME" ]]; then
                  mode="from-default"
                  src_env=""
                else
                  mode="from-env"
                  src_env="$1"
                fi
                ;;
              *)
                err "unknown option: $1"
                ;;
            esac
            shift
          done
          with_lock cmd_env_create "$env" "$mode" "$src_env"
          ;;
        use)
          [[ "$#" -ge 1 ]] || err "usage: $SCRIPT_NAME env use <env> [-t cli|app|both]"
          local env="$1"
          shift
          local target="cli"
          while [[ "$#" -gt 0 ]]; do
            case "$1" in
              -t|--target)
                shift
                [[ "$#" -gt 0 ]] || err "missing target after -t/--target"
                target="$1"
                ;;
              *)
                err "unknown option: $1"
                ;;
            esac
            shift
          done
          with_lock cmd_env_use "$env" "$target"
          ;;
        rm|remove|delete)
          [[ "$#" -ge 1 && "$#" -le 2 ]] || err "usage: $SCRIPT_NAME env rm <env> [--force]"
          local env="$1"
          shift
          local force="false"
          if [[ "${1:-}" == "--force" ]]; then
            force="true"
          elif [[ -n "${1:-}" ]]; then
            err "unknown option: ${1:-}"
          fi
          with_lock cmd_env_remove "$env" "$force"
          ;;
        *)
          err "unknown env subcommand: $sub"
          ;;
      esac
      ;;
    account|ac)
      local sub="${1:-}"
      [[ -n "$sub" ]] || err "usage: $SCRIPT_NAME ac <ls|login|relogin|use|logout|rm> ..."
      shift || true
      case "$sub" in
        ls)
          local env=""
          while [[ "$#" -gt 0 ]]; do
            case "$1" in
              --env)
                shift
                [[ "$#" -gt 0 ]] || err "missing env after --env"
                env="$1"
                ;;
              *)
                err "unknown option: $1"
                ;;
            esac
            shift
          done
          cmd_account_list "$env"
          ;;
        login)
          [[ "$#" -ge 1 ]] || err "usage: $SCRIPT_NAME ac login <account> [--env <env>] [-t cli|app|both] [--sync|--no-sync] [--mode auth|apikey|sub2api]"
          local account="$1"
          shift
          local env="$(read_current_env cli || true)"
          local target="cli"
          local sync_mode="false"
          local mode="auth"
          while [[ "$#" -gt 0 ]]; do
            case "$1" in
              --env)
                shift
                [[ "$#" -gt 0 ]] || err "missing env after --env"
                env="$1"
                ;;
              -t|--target)
                shift
                [[ "$#" -gt 0 ]] || err "missing target after -t/--target"
                target="$1"
                ;;
              --sync)
                sync_mode="true"
                ;;
              --no-sync)
                sync_mode="false"
                ;;
              --mode)
                shift
                [[ "$#" -gt 0 ]] || err "missing mode after --mode"
                mode="$1"
                ;;
              *)
                err "unknown option: $1"
                ;;
            esac
            shift
          done
          case "$mode" in
            auth|apikey|sub2api)
              ;;
            *)
              err "invalid mode '$mode' (use auth|apikey|sub2api)"
              ;;
          esac
          with_lock cmd_account_login "$account" "$env" "$target" "$sync_mode" "$mode"
          ;;
        relogin)
          local account=""
          if [[ "$#" -gt 0 && "${1:-}" != --* ]]; then
            account="$1"
            shift
          fi
          local env=""
          local target="cli"
          local sync_mode="false"
          local mode=""
          while [[ "$#" -gt 0 ]]; do
            case "$1" in
              --env)
                shift
                [[ "$#" -gt 0 ]] || err "missing env after --env"
                env="$1"
                ;;
              --account)
                shift
                [[ "$#" -gt 0 ]] || err "missing account after --account"
                account="$1"
                ;;
              -t|--target)
                shift
                [[ "$#" -gt 0 ]] || err "missing target after -t/--target"
                target="$1"
                ;;
              --sync)
                sync_mode="true"
                ;;
              --no-sync)
                sync_mode="false"
                ;;
              --mode)
                shift
                [[ "$#" -gt 0 ]] || err "missing mode after --mode"
                mode="$1"
                ;;
              *)
                err "unknown option: $1"
                ;;
            esac
            shift
          done
          with_lock cmd_account_relogin "$account" "$env" "$target" "$sync_mode" "$mode"
          ;;
        base-url)
          [[ "$#" -ge 1 ]] || err "usage: $SCRIPT_NAME ac base-url <account> [--env <env>] [--mode default|custom]"
          local account="$1"
          shift
          local env="$(read_current_env cli || true)"
          local mode="default"
          while [[ "$#" -gt 0 ]]; do
            case "$1" in
              --env)
                shift
                [[ "$#" -gt 0 ]] || err "missing env after --env"
                env="$1"
                ;;
              --mode)
                shift
                [[ "$#" -gt 0 ]] || err "missing mode after --mode"
                mode="$1"
                ;;
              *)
                err "unknown option: $1"
                ;;
            esac
            shift
          done
          with_lock cmd_account_base_url_update "$account" "$env" "$mode"
          ;;
        use)
          [[ "$#" -ge 1 ]] || err "usage: $SCRIPT_NAME ac use <account> [--env <env>] [-t cli|app|both] [--sync|--no-sync]"
          local account="$1"
          shift
          local env="$(read_current_env cli || true)"
          local target="cli"
          local sync_mode="false"
          while [[ "$#" -gt 0 ]]; do
            case "$1" in
              --env)
                shift
                [[ "$#" -gt 0 ]] || err "missing env after --env"
                env="$1"
                ;;
              -t|--target)
                shift
                [[ "$#" -gt 0 ]] || err "missing target after -t/--target"
                target="$1"
                ;;
              --sync)
                sync_mode="true"
                ;;
              --no-sync)
                sync_mode="false"
                ;;
              *)
                if [[ "$1" == "--launch" || "$1" == "--no-launch" ]]; then
                  err "option $1 was removed. use '$SCRIPT_NAME app restart-current' or '$SCRIPT_NAME app launch-new'"
                fi
                err "unknown option: $1"
                ;;
            esac
            shift
          done
          cmd_account_use_selected "$account" "$env" "$target" "$sync_mode"
          ;;
        logout)
          local account=""
          local env="$(read_current_env cli || true)"
          local target="cli"
          if [[ "$#" -gt 0 && "${1:-}" != --* ]]; then
            account="$1"
            shift
          fi
          while [[ "$#" -gt 0 ]]; do
            case "$1" in
              --env)
                shift
                [[ "$#" -gt 0 ]] || err "missing env after --env"
                env="$1"
                ;;
              -t|--target)
                shift
                [[ "$#" -gt 0 ]] || err "missing target after -t/--target"
                target="$1"
                ;;
              *)
                err "unknown option: $1"
                ;;
            esac
            shift
          done
          with_lock cmd_account_logout "$account" "$env" "$target"
          ;;
        rm|remove|delete)
          [[ "$#" -ge 1 ]] || err "usage: $SCRIPT_NAME ac rm <account> [--env <env>] [--force]"
          local account="$1"
          shift
          local env="$(read_current_env cli || true)"
          local force="false"
          while [[ "$#" -gt 0 ]]; do
            case "$1" in
              --env)
                shift
                [[ "$#" -gt 0 ]] || err "missing env after --env"
                env="$1"
                ;;
              --force)
                force="true"
                ;;
              *)
                err "unknown option: $1"
                ;;
            esac
            shift
          done
          with_lock cmd_account_remove "$account" "$env" "$force"
          ;;
        *)
          err "unknown account subcommand: $sub"
          ;;
      esac
      ;;
    whoami)
      local target="all"
      if [[ "$#" -gt 0 ]]; then
        case "$1" in
          -t|--target)
            shift
            [[ "$#" -gt 0 ]] || err "missing target after -t/--target"
            target="$1"
            shift
            ;;
          *)
            err "unknown option: $1"
            ;;
        esac
      fi
      [[ "$#" -eq 0 ]] || err "usage: $SCRIPT_NAME whoami [-t cli|app|both]"
      case "$target" in
        cli|app)
          cmd_current "$target"
          ;;
        both|all)
          cmd_current all
          ;;
        *)
          err "invalid target '$target' (use cli|app|both)"
          ;;
      esac
      ;;
    status)
      [[ "$#" -eq 0 ]] || err "usage: $SCRIPT_NAME status"
      cmd_status
      ;;
    cli)
      local action="${1:-}"
      [[ -n "$action" ]] || err "usage: $SCRIPT_NAME cli <launch-current> [-- <codex args...>]"
      shift || true
      case "$action" in
        launch-current)
          cmd_cli_launch_current "$@"
          ;;
        *)
          err "unknown cli action: $action (use launch-current)"
          ;;
      esac
      ;;
    app)
      local action="${1:-}"
      [[ -n "$action" ]] || err "usage: $SCRIPT_NAME app <restart-current|launch-new|status|logout> ..."
      shift || true
      case "$action" in
        restart-current)
          [[ "$#" -eq 0 ]] || err "usage: $SCRIPT_NAME app restart-current"
          cmd_app_restart_current
          ;;
        launch-new)
          [[ "$#" -eq 0 ]] || err "usage: $SCRIPT_NAME app launch-new"
          cmd_app_launch_new
          ;;
        status)
          [[ "$#" -eq 0 ]] || err "usage: $SCRIPT_NAME app status"
          cmd_app_status
          ;;
        logout)
          [[ "$#" -le 1 ]] || err "usage: $SCRIPT_NAME app logout [account]"
          cmd_app_logout "${1:-}"
          ;;
        *)
          err "unknown app action: $action (use restart-current|launch-new|status|logout)"
          ;;
      esac
      ;;
    lang)
      [[ "$#" -le 1 ]] || err "usage: $SCRIPT_NAME lang [zh|en|ja]"
      cmd_lang "${1:-}"
      ;;
    tui)
      [[ "$#" -eq 0 ]] || err "usage: $SCRIPT_NAME tui"
      cmd_tui
      ;;
    __test-status-snapshot)
      [[ "$#" -eq 0 ]] || err "usage: $SCRIPT_NAME __test-status-snapshot"
      tui_home_accounts_snapshot
      ;;
    check)
      [[ "$#" -eq 0 ]] || err "usage: $SCRIPT_NAME check"
      cmd_check
      ;;
    upgrade)
      [[ "$#" -le 1 ]] || err "usage: $SCRIPT_NAME upgrade [--dry-run]"
      local dry="false"
      if [[ "${1:-}" == "--dry-run" ]]; then
        dry="true"
      elif [[ -n "${1:-}" ]]; then
        err "unknown option: ${1:-}"
      fi
      cmd_upgrade "$dry"
      ;;
    ops)
      local sub="${1:-}"
      [[ -n "$sub" ]] || err "usage: $SCRIPT_NAME ops <list|proxy|exec|import-default|init|recover|doctor|token-refresh> ..."
      shift || true
      case "$sub" in
        list)
          [[ "$#" -eq 0 ]] || err "usage: $SCRIPT_NAME ops list"
          cmd_list
          ;;
        proxy)
          [[ "$#" -le 1 ]] || err "usage: $SCRIPT_NAME ops proxy [<host:port>|off|test]"
          case "${1:-}" in
            "")
              cmd_proxy_show
              ;;
            off)
              with_lock cmd_proxy_off
              ;;
            test)
              cmd_proxy_test
              ;;
            *)
              with_lock cmd_proxy_set "$1"
              ;;
          esac
          ;;
        exec)
          cmd_exec "$@"
          ;;
        import-default)
          [[ "$#" -ge 1 ]] || err "usage: $SCRIPT_NAME ops import-default <env> [--with-auth] [--force]"
          local env="$1"
          local with_auth="false"
          local force="false"
          shift
          while [[ "$#" -gt 0 ]]; do
            case "$1" in
              --with-auth)
                with_auth="true"
                ;;
              --force)
                force="true"
                ;;
              *)
                err "unknown option: $1"
                ;;
            esac
            shift
          done
          with_lock cmd_import_default "$env" "$with_auth" "$force"
          ;;
        init)
          cmd_init "$@"
          ;;
        recover)
          [[ "$#" -le 1 ]] || err "usage: $SCRIPT_NAME ops recover [--dry-run]"
          local dry="false"
          if [[ "${1:-}" == "--dry-run" ]]; then
            dry="true"
          elif [[ -n "${1:-}" ]]; then
            err "unknown option: ${1:-}"
          fi
          with_lock cmd_recover "$dry"
          ;;
        doctor)
          [[ "$#" -le 1 ]] || err "usage: $SCRIPT_NAME ops doctor [--fix]"
          local fix="false"
          if [[ "${1:-}" == "--fix" ]]; then
            fix="true"
          elif [[ -n "${1:-}" ]]; then
            err "unknown option: ${1:-}"
          fi
          cmd_doctor "$fix"
          ;;
        token-refresh)
          [[ "$#" -le 1 ]] || err "usage: $SCRIPT_NAME ops token-refresh <start|stop|status|run-once>"
          local action="${1:-status}"
          case "$action" in
            start)
              cmd_token_refresh_start
              ;;
            stop)
              cmd_token_refresh_stop
              ;;
            status)
              cmd_token_refresh_status
              ;;
            run-once)
              cmd_token_refresh_run_once
              ;;
            *)
              err "unknown token-refresh action: $action (use start|stop|status|run-once)"
              ;;
          esac
          ;;
        help|-h|--help)
          usage_all
          ;;
        *)
          err "unknown ops subcommand: $sub"
          ;;
      esac
      ;;
    version)
      [[ "$#" -eq 0 ]] || err "usage: $SCRIPT_NAME version"
      cmd_version
      ;;
    --help-all|help-all)
      usage_all
      ;;
    help|-h|--help)
      usage
      ;;
    *)
      err "unknown command: $cmd"
      ;;
  esac
}

main "$@"
