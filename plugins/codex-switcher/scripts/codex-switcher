usage() {
  cat <<'USAGE'
Usage:
  codex-sw env ls
  codex-sw env new <env> [--empty|--from <src-env|default>]
  codex-sw env use <env> [-t cli|app|both]
  codex-sw env rm <env> [--force]

  codex-sw ac ls [--env <env>]
  codex-sw ac login <account> [--env <env>] [-t cli|app|both] [--sync|--no-sync] [--mode auth|apikey|sub2api]
  codex-sw ac relogin [account] [--env <env>] [-t cli|app|both] [--sync|--no-sync] [--mode auth|apikey|sub2api]
  codex-sw ac use <account> [--env <env>] [-t cli|app|both] [--sync|--no-sync]
  codex-sw cli launch-current [-- <codex args...>]
  codex-sw app restart-current
  codex-sw app launch-new
  codex-sw ac logout [account] [--env <env>] [-t cli|app|both]
  codex-sw ac rm <account> [--env <env>] [--force]

  codex-sw whoami [-t cli|app|both]
  codex-sw status
  codex-sw lang [en]
  codex-sw tui
  codex-sw check
  codex-sw upgrade [--dry-run]
  codex-sw version
  codex-sw --help
  codex-sw --help-all

Notes:
  - `ac` and `account` are equivalent.
  - Use `--help-all` to show operations under `ops`.
USAGE
}

