{
  "name": "@wangxt0223/codex-switcher",
  "version": "0.8.17",
  "description": "Env + account switcher for Codex CLI and Codex App with shared env data and per-account auth.",
  "license": "MIT",
  "author": "wangxt",
  "homepage": "https://github.com/wangxt/codex-switcher",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wangxt/codex-switcher.git"
  },
  "keywords": [
    "codex",
    "codex-cli",
    "account-switch",
    "env",
    "account",
    "codex-home"
  ],
  "bin": {
    "codex-sw": "scripts/bin/codex-sw.cjs",
    "codex-switcher": "scripts/bin/codex-sw.cjs",
    "codex-sw-node": "scripts/bin/codex-sw-node.cjs"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "files": [
    "packages/gateway/**",
    "plugins/codex-switcher/**",
    "!plugins/codex-switcher/**/__pycache__/**",
    "!plugins/codex-switcher/**/*.pyc",
    "scripts/bin/**",
    "docs/**",
    "scripts/install.sh",
    "scripts/windows-manual-capture.ps1",
    "scripts/windows-manual-start.ps1",
    "scripts/windows-manual-result-template.ps1",
    "scripts/windows-plugin-sandbox-smoke.cjs",
    "scripts/verify-sandbox-evidence.mjs",
    "scripts/uninstall.sh",
    "scripts/node-cli.ts",
    "scripts/core-cli.ts",
    "packages/core/src/**",
    "packages/gateway/src/**",
    "apps/desktop/electron/**",
    "!packages/core/src/**/*.test.ts",
    "!packages/gateway/src/**/*.test.ts",
    "!apps/desktop/electron/**/*.test.ts",
    "CHANGELOG.md",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "lint:bash": "bash -n plugins/codex-switcher/scripts/codex-switcher && bash -n plugins/codex-switcher/scripts/codex-sw",
    "lint": "npm run lint:bash",
    "test:cross-platform": "npm run core:test && npm run gateway:test && tsx --test --test-concurrency=1 scripts/bin-entry.test.ts scripts/ci-workflow.test.ts scripts/core-cli.test.ts scripts/update-release-manifest.test.ts scripts/install-wrapper.test.ts scripts/readme-consistency.test.ts scripts/run-lifecycle-tests.test.ts scripts/sandbox-evidence.test.ts scripts/submission-content.test.ts scripts/windows-handoff.test.ts scripts/windows-manual-checklist.test.ts scripts/windows-manual-capture.test.ts scripts/windows-manual-start.test.ts scripts/windows-manual-result-template.test.ts scripts/windows-manual-result-template-script.test.ts scripts/windows-support-audit.test.ts scripts/package-files.test.ts scripts/package-scripts.test.ts",
    "test:legacy-bash": "tsx --test scripts/legacy-cli-compat.test.ts",
    "test": "npm run test:cross-platform && npm run test:legacy-bash",
    "node-cli:test": "npm run test:cross-platform",
    "cli:test": "npm run test:cross-platform && npm run test:legacy-bash",
    "core:test": "node ./packages/core/scripts/run-tests.mjs",
    "gateway:test": "npm run test --workspace ./packages/gateway",
    "core:build": "tsc -p packages/core/tsconfig.json",
    "gateway:build": "tsc -p packages/gateway/tsconfig.json",
    "core:cli": "tsx scripts/core-cli.ts",
    "desktop:build": "npm run build --workspace ./apps/desktop",
    "desktop:dev": "npm run electron:dev --workspace ./apps/desktop",
    "desktop:electron": "npm run electron --workspace ./apps/desktop",
    "desktop:test": "npm run test:desktop --workspace ./apps/desktop",
    "test:desktop-package-workflow": "tsx --test scripts/desktop-package-workflow.test.ts",
    "desktop:package:mac": "npm run package:mac --workspace ./apps/desktop",
    "desktop:package:mac:dir": "npm run package:mac:dir --workspace ./apps/desktop",
    "desktop:package:linux": "npm run package:linux --workspace ./apps/desktop",
    "desktop:package:win": "npm run package:win --workspace ./apps/desktop",
    "website:dev": "npm run dev --workspace ./apps/website",
    "website:build": "npm run build --workspace ./apps/website",
    "website:preview": "npm run preview --workspace ./apps/website",
    "website:check": "npm run build --workspace ./apps/website && npm run verify --workspace ./apps/website",
    "test:lifecycle": "node ./scripts/run-lifecycle-tests.mjs",
    "windows:manual:start": "powershell -ExecutionPolicy Bypass -File ./scripts/windows-manual-start.ps1",
    "windows:manual:capture": "powershell -ExecutionPolicy Bypass -File ./scripts/windows-manual-capture.ps1",
    "windows:manual:result-template": "powershell -ExecutionPolicy Bypass -File ./scripts/windows-manual-result-template.ps1",
    "check:cross-platform": "npm run test:cross-platform && npm run core:build && npm run gateway:build",
    "check": "npm run lint && npm run test",
    "prepublishOnly": "npm run check",
    "release:npm": "./scripts/publish-npm.sh",
    "release:npm:token": "./scripts/publish-npm-with-token.sh",
    "release:npm:auto": "./scripts/release-publish.sh",
    "release:update-manifest": "node ./scripts/create-update-manifest.mjs",
    "release:verify-manifest": "node ./scripts/verify-update-manifest.mjs"
  },
  "dependencies": {
    "jsonc-parser": "^3.3.1",
    "sql.js": "^1.14.1",
    "tsx": "^4.20.3",
    "undici": "^6.29.0",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.8",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
