---
import BaseLayout from "./BaseLayout.astro";
import { docsGroups, docsNavigation } from "../data/docs";
import { withBase } from "../lib/paths";

interface TocItem { id: string; label: string; }
interface Props { title: string; description: string; slug?: string; toc?: TocItem[]; }

const { title, description, slug = "", toc = [] } = Astro.props;
const index = docsNavigation.findIndex((item) => item.slug === slug);
const previous = index > 0 ? docsNavigation[index - 1] : undefined;
const next = index >= 0 && index < docsNavigation.length - 1 ? docsNavigation[index + 1] : undefined;
const searchData = docsNavigation.map((item) => ({ ...item, href: withBase(`/zh/docs/${item.slug}/`) }));
---

<BaseLayout title={`${title}｜codex-switcher 使用文档`} description={description}>
  <div class="docs-shell page-container">
    <aside class="docs-sidebar" data-doc-sidebar>
      <div class="docs-search-wrap">
        <label class="docs-search"><span aria-hidden="true">⌕</span><input type="search" placeholder="搜索文档或错误信息" aria-label="搜索文档" data-doc-search /></label>
        <div class="search-results" hidden data-search-results></div>
      </div>
      <nav aria-label="文档导航">
        <a class:list={["docs-home", { active: !slug }]} href={withBase("/zh/docs/")}>文档概览</a>
        {docsGroups.map((group) => <section><h2>{group}</h2>{docsNavigation.filter((item) => item.group === group).map((item) => <a class:list={{ active: item.slug === slug }} href={withBase(`/zh/docs/${item.slug}/`)}><span>{item.title}</span><small>{item.description}</small></a>)}</section>)}
      </nav>
    </aside>
    <article class="docs-article">
      <button class="docs-mobile-button" type="button" data-doc-menu aria-expanded="false">目录 <span>⌄</span></button>
      <header class="docs-heading"><span class="eyebrow">使用文档</span><h1>{title}</h1><p>{description}</p></header>
      <div class="docs-content"><slot /></div>
      {(previous || next) && <nav class="doc-pager" aria-label="文档翻页">
        {previous ? <a href={withBase(`/zh/docs/${previous.slug}/`)}><small>上一篇</small><strong>← {previous.title}</strong></a> : <span></span>}
        {next ? <a class="next" href={withBase(`/zh/docs/${next.slug}/`)}><small>下一篇</small><strong>{next.title} →</strong></a> : <span></span>}
      </nav>}
    </article>
    <aside class="docs-toc" aria-label="本页目录"><strong>本页内容</strong>{toc.map((item) => <a href={`#${item.id}`}>{item.label}</a>)}</aside>
  </div>
  <script is:inline type="application/json" id="doc-search-data" set:html={JSON.stringify(searchData)}></script>
</BaseLayout>

<script>
  const input = document.querySelector<HTMLInputElement>("[data-doc-search]");
  const results = document.querySelector<HTMLElement>("[data-search-results]");
  const dataNode = document.querySelector<HTMLScriptElement>("#doc-search-data");
  const docs = dataNode ? JSON.parse(dataNode.textContent || "[]") as Array<{ title: string; description: string; keywords: string; href: string }> : [];
  const renderResults = (query: string) => {
    if (!results) return;
    results.replaceChildren();
    const normalized = query.trim().toLowerCase();
    if (!normalized) { results.hidden = true; return; }
    const matches = docs.filter((item) => `${item.title} ${item.description} ${item.keywords}`.toLowerCase().includes(normalized)).slice(0, 6);
    const list = document.createElement("div");
    if (!matches.length) { const empty = document.createElement("p"); empty.textContent = "没有找到匹配内容"; list.append(empty); }
    matches.forEach((item) => { const link = document.createElement("a"); link.href = item.href; const title = document.createElement("strong"); title.textContent = item.title; const description = document.createElement("span"); description.textContent = item.description; link.append(title, description); list.append(link); });
    results.append(list); results.hidden = false;
  };
  input?.addEventListener("input", () => renderResults(input.value));
  input?.addEventListener("keydown", (event) => { if (event.key === "Escape") { input.value = ""; renderResults(""); input.blur(); } });
  document.addEventListener("click", (event) => { if (results && input && !results.contains(event.target as Node) && event.target !== input) results.hidden = true; });

  const menu = document.querySelector<HTMLButtonElement>("[data-doc-menu]");
  const sidebar = document.querySelector<HTMLElement>("[data-doc-sidebar]");
  menu?.addEventListener("click", () => { const open = menu.getAttribute("aria-expanded") !== "true"; menu.setAttribute("aria-expanded", String(open)); sidebar?.toggleAttribute("data-open", open); });
</script>

<style>
  .docs-shell { display: grid; grid-template-columns: 230px minmax(0, 1fr) 170px; gap: 3rem; align-items: start; padding-top: 2.5rem; }.docs-sidebar, .docs-toc { position: sticky; top: 92px; max-height: calc(100vh - 112px); overflow: auto; scrollbar-width: thin; }.docs-search-wrap { position: relative; }.docs-search { display: flex; align-items: center; gap: .45rem; height: 38px; padding-inline: .65rem; border: 1px solid var(--cs-border); border-radius: .65rem; background: var(--cs-surface); color: var(--cs-muted-foreground); }.docs-search input { min-width: 0; width: 100%; border: 0; outline: 0; background: transparent; color: var(--cs-foreground); font-size: 12px; }.search-results { position: absolute; z-index: 20; top: calc(100% + 6px); right: 0; left: 0; padding: .4rem; border: 1px solid var(--cs-border); border-radius: .75rem; background: var(--cs-surface); box-shadow: var(--cs-shadow-lg); }.search-results :global(a) { display: block; padding: .55rem; border-radius: .5rem; text-decoration: none; }.search-results :global(a:hover) { background: var(--cs-muted); }.search-results :global(strong), .search-results :global(span) { display: block; }.search-results :global(strong) { font-size: 12px; }.search-results :global(span), .search-results :global(p) { color: var(--cs-muted-foreground); font-size: 11px; }.docs-sidebar nav { padding-top: 1rem; }.docs-sidebar section { margin-top: 1.15rem; }.docs-sidebar h2 { margin: 0 0 .35rem; padding-inline: .6rem; color: var(--cs-muted-foreground); font-size: 10px; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; }.docs-sidebar nav a { display: block; margin: .12rem 0; padding: .5rem .6rem; border-radius: .55rem; color: var(--cs-muted-foreground); text-decoration: none; }.docs-sidebar nav a:hover, .docs-sidebar nav a.active { background: #eef0f2; color: var(--cs-foreground); }.docs-sidebar nav a.active { box-shadow: inset 0 0 0 1px var(--cs-selected-border); }.docs-sidebar nav a span { display: block; font-size: 12px; font-weight: 600; }.docs-sidebar nav a small { display: block; margin-top: .08rem; font-size: 10px; }.docs-home { font-weight: 650; }.docs-article { min-width: 0; padding: .75rem 0 2rem; }.docs-heading { padding-bottom: 2rem; border-bottom: 1px solid var(--cs-border); }.docs-heading h1 { margin: .8rem 0 .5rem; font-size: clamp(2rem, 4vw, 3rem); line-height: 1.12; letter-spacing: -.055em; }.docs-heading p { margin: 0; color: var(--cs-muted-foreground); font-size: 15px; }.docs-content { padding-top: 1.5rem; }.docs-content :global(h2) { margin: 2.5rem 0 .8rem; padding-top: .5rem; font-size: 22px; line-height: 1.3; letter-spacing: -.035em; }.docs-content :global(h3) { margin: 1.7rem 0 .6rem; font-size: 16px; }.docs-content :global(p), .docs-content :global(li) { color: #4f5e70; line-height: 1.8; }.docs-content :global(a) { color: var(--cs-primary); font-weight: 600; text-decoration: none; }.docs-content :global(ul), .docs-content :global(ol) { padding-left: 1.25rem; }.docs-content :global(code) { border-radius: .35rem; background: var(--cs-muted); padding: .12rem .32rem; color: #334155; font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: .88em; }.docs-content :global(pre) { overflow: auto; padding: 1rem; border: 1px solid #273141; border-radius: .8rem; background: #18202b; color: #e9eef5; }.docs-content :global(pre code) { padding: 0; background: transparent; color: inherit; }.docs-content :global(blockquote) { margin: 1rem 0; padding: .8rem 1rem; border: 1px solid var(--cs-border); border-left: 3px solid var(--cs-primary); border-radius: .65rem; background: var(--cs-surface); }.docs-content :global(blockquote p) { margin: 0; }.docs-content :global(table) { width: 100%; border-collapse: collapse; font-size: 12px; }.docs-content :global(th), .docs-content :global(td) { padding: .65rem; border-bottom: 1px solid var(--cs-border); text-align: left; }.docs-content :global(th) { color: var(--cs-muted-foreground); font-weight: 600; }.doc-pager { display: grid; grid-template-columns: 1fr 1fr; gap: .75rem; margin-top: 3rem; padding-top: 1.25rem; border-top: 1px solid var(--cs-border); }.doc-pager a { padding: .8rem; border: 1px solid var(--cs-border); border-radius: .7rem; background: var(--cs-surface); text-decoration: none; }.doc-pager a:hover { border-color: var(--cs-selected-border); }.doc-pager small, .doc-pager strong { display: block; }.doc-pager small { color: var(--cs-muted-foreground); }.doc-pager .next { text-align: right; }.docs-toc { display: grid; gap: .45rem; padding-top: .8rem; border-left: 1px solid var(--cs-border); padding-left: 1rem; }.docs-toc strong { margin-bottom: .2rem; font-size: 11px; }.docs-toc a { color: var(--cs-muted-foreground); font-size: 11px; text-decoration: none; }.docs-toc a:hover { color: var(--cs-primary); }.docs-mobile-button { display: none; width: 100%; align-items: center; justify-content: space-between; margin-bottom: 1rem; padding: .65rem .75rem; border: 1px solid var(--cs-border); border-radius: .65rem; background: var(--cs-surface); }
  @media (max-width: 1040px) { .docs-shell { grid-template-columns: 210px minmax(0, 1fr); gap: 2rem; }.docs-toc { display: none; } }
  @media (max-width: 760px) { .docs-shell { display: block; padding-top: 1rem; }.docs-mobile-button { display: flex; }.docs-sidebar { position: static; display: none; max-height: none; margin-bottom: 1rem; padding: .75rem; border: 1px solid var(--cs-border); border-radius: .8rem; background: var(--cs-surface); }.docs-sidebar[data-open] { display: block; }.docs-article { padding-top: 0; }.docs-heading { padding-top: .4rem; }.doc-pager { grid-template-columns: 1fr; }.doc-pager .next { text-align: left; } }
</style>
