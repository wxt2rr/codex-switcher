{
  "name": "appsdesktop",
  "private": true,
  "version": "0.1.47",
  "description": "Electron desktop shell for codex-switcher",
  "author": "wangxt",
  "homepage": "https://github.com/wxt2rr/codex-switcher",
  "type": "module",
  "main": "electron-dist/electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "node ./scripts/build-native-helpers.mjs && tsc -p ../../packages/core/tsconfig.json && tsc -p ../../packages/gateway/tsconfig.json && tsc -p tsconfig.web.json && tsc -p tsconfig.electron.json && node ./scripts/rename-electron-output.cjs && vite build",
    "electron": "electron electron-dist/electron/main.cjs",
    "electron:dev": "concurrently -k \"vite\" \"wait-on tcp:1420 && cross-env CODEX_SWITCHER_DESKTOP_DEV_SERVER_URL=http://127.0.0.1:1420 electron electron-dist/electron/main.cjs\"",
    "preview": "vite preview",
    "test:desktop": "node ./scripts/run-tests.mjs",
    "test:pools": "tsx --test electron/account-pool-routing.test.ts electron/account-pool-store.test.ts electron/usage-router-service.test.ts",
    "test:app-windows": "tsx --test electron/app-window-lifecycle.test.ts electron/desktop-settings.test.ts electron/windows-packaged-app-profile.test.ts",
    "test:retention": "tsx --test electron/env-history-retention.test.ts electron/desktop-settings.test.ts",
    "test:image-recovery": "tsx --test electron/generated-image-recovery-skill.test.ts electron/generated-image-recovery-script.test.ts electron/desktop-settings.test.ts src/bridge.test.ts",
    "test:compat": "tsx --test electron/openai-chat-compat/*.test.ts",
    "test:compat:e2e": "CODEX_SWITCHER_RUN_CODEX_E2E=1 tsx --test electron/openai-chat-compat/codex-e2e.test.ts",
    "package:mac": "electron-builder --mac dmg zip --arm64 --x64",
    "package:mac:dir": "electron-builder --mac dir --arm64 --x64",
    "package:linux": "electron-builder --linux AppImage deb --x64",
    "package:win": "electron-builder --win nsis --x64",
    "package:dir": "electron-builder --dir",
    "package:verify": "node ./scripts/verify-package-artifact.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.2.8",
    "@types/sql.js": "^1.4.11",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "echarts": "^6.1.0",
    "lucide-react": "^1.18.0",
    "radix-ui": "^1.6.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "shadcn": "^4.11.0",
    "sql.js": "^1.14.1",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "undici": "^6.29.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.10",
    "@types/node": "^24.0.8",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.0.4",
    "concurrently": "^9.1.2",
    "cross-env": "^10.0.0",
    "electron": "31.7.7",
    "electron-builder": "^24.13.3",
    "tsx": "^4.20.3",
    "typescript": "~5.6.2",
    "vite": "^6.0.3",
    "wait-on": "^8.0.1"
  },
  "build": {
    "afterPack": "scripts/after-pack.cjs",
    "appId": "com.wangxt.codex-switcher",
    "productName": "codex-switcher",
    "electronVersion": "31.7.7",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "electron-dist/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../../packages/core/dist",
        "to": "packages/core/dist"
      },
      {
        "from": "../../packages/core/package.json",
        "to": "packages/core/package.json"
      },
      {
        "from": "../../packages/gateway/dist",
        "to": "packages/gateway/dist"
      },
      {
        "from": "../../packages/gateway/package.json",
        "to": "packages/gateway/package.json"
      },
      {
        "from": "../../plugins/codex-switcher/scripts",
        "to": "plugins/codex-switcher/scripts"
      },
      {
        "from": "../../scripts/bin",
        "to": "scripts/bin"
      },
      {
        "from": "resources/skills",
        "to": "skills"
      },
      {
        "from": "resources/native",
        "to": "native"
      }
    ],
    "mac": {
      "target": [
        "dmg",
        "zip",
        "dir"
      ],
      "icon": "build/icon.icns"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Utility",
      "maintainer": "wangxt",
      "icon": "build/icon.png"
    },
    "nsis": {
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "include": "build/installer.nsh"
    }
  }
}
